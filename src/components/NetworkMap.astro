---
/**
 * NetworkMap — where Caligo's sequencing facilities and events are.
 *
 * Country outlines come from Natural Earth (public domain) through
 * scripts/build-network-map.py, so the map is static SVG with no mapping
 * library. Facilities are numbered so the list and the map cross-reference;
 * hovering or focusing either one highlights the other. Without JavaScript
 * the list still carries every fact the map shows.
 */
import { FACILITIES, EVENTS, pick } from '../data/initiative';
import { MAP_COUNTRIES, MAP_VIEWBOX, projectLonLat } from '../data/network-map';
import { MEMBER_COUNTRY_LIST } from '../data/members';
import { localePath, type Locale } from '../i18n';
import Icon from './Icon.astro';

interface Props {
  readonly locale: Locale;
  readonly headingId?: string;
}
const { locale, headingId = 'network-map-title' } = Astro.props;

const copy = {
  en: {
    heading: 'A network across Latin America',
    intro: 'Eight partner facilities in six countries can sequence Caligo samples close to where they are collected.',
    members: 'Countries with members',
    facilities: 'Sequencing facilities',
    events: 'Meetings',
    mapLabel: 'Map of Latin America showing Caligo’s eight partner sequencing facilities, two network events and the countries where members work.',
    outside: 'Outside the map',
    details: 'Platforms and websites',
    source: 'Map: Natural Earth',
  },
  es: {
    heading: 'Una red a lo largo de América Latina',
    intro: 'Ocho centros asociados en seis países pueden secuenciar muestras de Caligo cerca de donde se recolectan.',
    members: 'Países con miembros',
    facilities: 'Centros de secuenciación',
    events: 'Encuentros',
    mapLabel: 'Mapa de América Latina con los ocho centros de secuenciación asociados de Caligo, dos eventos de la red y los países donde trabajan sus miembros.',
    outside: 'Fuera del mapa',
    details: 'Plataformas y sitios web',
    source: 'Mapa: Natural Earth',
  },
}[locale];

/* Short display names; the full institution name stays in the title. */
const shortName: Record<string, string> = {
  'Universidad del Rosario': 'Universidad del Rosario',
  'Universidad Nacional de Colombia': 'Universidad Nacional de Colombia',
  'Smithsonian Tropical Research Institute': 'Smithsonian Tropical Research Institute',
  'Universidade Federal de Goiás': 'Universidade Federal de Goiás',
  'Universidad Regional Amazónica Ikiam': 'Universidad Regional Amazónica Ikiam',
  'Universidad Austral de Chile': 'Universidad Austral de Chile',
  'Universidade Federal do Pará': 'Universidade Federal do Pará',
  'Pontificia Universidad Católica del Perú / Alianza para una Amazonía Sostenible': 'PUCP / Alianza para una Amazonía Sostenible',
};

const countryIso: Record<string, string> = {
  Colombia: 'COL', Panama: 'PAN', Brazil: 'BRA', Ecuador: 'ECU', Chile: 'CHL', Peru: 'PER',
};
const facilityCountries = new Set(FACILITIES.map((f) => countryIso[f.country.en]));

/* Project facilities, then spread markers that would overlap (two in Bogotá). */
const R = 11;
const sites = FACILITIES.map((facility, i) => ({
  n: i + 1,
  facility,
  ...projectLonLat(facility.lonLat[0], facility.lonLat[1]),
}));
for (let i = 0; i < sites.length; i++) {
  for (let j = 0; j < i; j++) {
    const dx = sites[i].x - sites[j].x;
    const dy = sites[i].y - sites[j].y;
    if (Math.hypot(dx, dy) < R * 2.2) {
      sites[j].x -= R * 1.15;
      sites[i].x = sites[j].x + R * 2.3;
      sites[i].y = sites[j].y;
    }
  }
}

/* City labels sit on the ocean side of each marker. */
const labelLeft = new Set(['Panama City', 'Tena', 'Lima', 'Valdivia']);
const cityLabels = new Map<string, { x: number; y: number; left: boolean; text: string }>();
for (const site of sites) {
  const city = site.facility.city.en;
  const existing = cityLabels.get(city);
  const left = labelLeft.has(city);
  if (existing) {
    existing.x = left ? Math.min(existing.x, site.x) : Math.max(existing.x, site.x);
    continue;
  }
  cityLabels.set(city, { x: site.x, y: site.y, left, text: pick(site.facility.city, locale) });
}
/* Bogotá's two markers read left of the city name; nudge it clear of Panama. */
const bogota = cityLabels.get('Bogotá');
if (bogota) bogota.y -= 2;

/* Each member country pairs a list row with its dot by a shared id. */
const memberId = (m: { en: string }) => `m-${m.en.toLowerCase().replace(/[^a-z]+/g, '-')}`;
const memberDots = MEMBER_COUNTRY_LIST.filter((m) => m.lonLat).map((m) => ({ id: memberId(m), name: pick(m, locale), ...projectLonLat(m.lonLat![0], m.lonLat![1]) }));
const memberRows = MEMBER_COUNTRY_LIST
  .map((m) => ({ id: memberId(m), name: pick(m, locale), onMap: Boolean(m.lonLat) }))
  /* Countries on the map first, then the hollow-marked ones outside it. */
  .sort((a, b) => Number(b.onMap) - Number(a.onMap) || a.name.localeCompare(b.name, locale));
const hasOutside = memberRows.some((m) => !m.onMap);

const events = EVENTS.map((event) => ({ event, ...projectLonLat(event.lonLat[0], event.lonLat[1]) }));
/* The Bogotá workshop shares its city with two facilities; set it below them. */
const eventMarks = events.map((e) => {
  const shared = sites.some((s) => Math.hypot(s.x - e.x, s.y - e.y) < R * 3);
  return { ...e, y: shared ? e.y + R * 2.4 : e.y, label: !shared };
});
---

<div class="network-map" data-network-map>
  <div class="nm-head">
    <h2 id={headingId} class="nm-heading">{copy.heading}</h2>
    <p class="nm-intro">{copy.intro}</p>
  </div>

  <div class="nm-lists">

    <h3 class="nm-list-title content-label">{copy.facilities}</h3>
    <ol class="nm-list" role="list">
      {sites.map((site) => (
        <li class="nm-item" data-site={site.n}>
          <span class="nm-num" aria-hidden="true">{site.n}</span>
          <span class="nm-item-text">
            <span class="nm-item-name">{shortName[site.facility.institution] ?? site.facility.institution}</span>
            <span class="nm-item-place">{pick(site.facility.city, locale)}, {pick(site.facility.country, locale)}</span>
          </span>
        </li>
      ))}
    </ol>

    <h3 class="nm-list-title content-label">{copy.members} · {MEMBER_COUNTRY_LIST.length}</h3>
    <ul class="nm-list nm-members" role="list" style={`--nm-rows-2: ${Math.ceil(memberRows.length / 2)}; --nm-rows-3: ${Math.ceil(memberRows.length / 3)}`}>
      {memberRows.map((m) => (
        <li class:list={['nm-item', 'nm-item--member', { 'nm-item--outside': !m.onMap }]} data-site={m.id}>
          <span class="nm-mark" aria-hidden="true"></span>
          <span class="nm-item-name">{m.name}</span>
        </li>
      ))}
    </ul>
    {hasOutside && (
      <p class="nm-members-note"><span class="nm-mark nm-mark--outside" aria-hidden="true"></span>{copy.outside}</p>
    )}

    <h3 class="nm-list-title content-label">{copy.events}</h3>
    <ul class="nm-list nm-list--events" role="list">
      {events.map(({ event }) => (
        <li class="nm-item nm-item--event" data-site={`e-${event.id}`}>
          <span class="nm-diamond" aria-hidden="true"></span>
          <span class="nm-item-text">
            <span class="nm-item-name">{pick(event.name, locale)}</span>
            <span class="nm-item-place">{pick(event.dates, locale)}</span>
          </span>
        </li>
      ))}
    </ul>

    <a class="text-link nm-more" href={`${localePath(locale, '/about')}#about-facilities`}>
      {copy.details}<Icon name="arrow-right" />
    </a>
  </div>

  <figure class="nm-figure">
    <svg
      class="nm-svg"
      viewBox={`0 0 ${MAP_VIEWBOX.width} ${MAP_VIEWBOX.height}`}
      role="img"
      aria-label={copy.mapLabel}
    >
      <g class="nm-land">
        {MAP_COUNTRIES.map((c) => (
          <path d={c.d} class:list={['nm-country', { 'nm-country--active': facilityCountries.has(c.iso) }]} />
        ))}
      </g>
      <g class="nm-labels" aria-hidden="true">
        {[...cityLabels.values()].map((l) => (
          <text
            x={l.left ? l.x - R - 8 : l.x + R + 8}
            y={l.y + 4.5}
            text-anchor={l.left ? 'end' : 'start'}
          >{l.text}</text>
        ))}
      </g>
      <g class="nm-events" aria-hidden="true">
        {eventMarks.map((e) => (
          <g class="nm-event" data-site={`e-${e.event.id}`} transform={`translate(${e.x.toFixed(1)} ${e.y.toFixed(1)})`}>
            <rect x="-6.5" y="-6.5" width="13" height="13" transform="rotate(45)" />
            {e.label && <text x="14" y="4.5">{pick(e.event.location, locale).split(',')[0]}</text>}
          </g>
        ))}
      </g>
      <g class="nm-members-dots" aria-hidden="true">
        {memberDots.map((m) => (
          <g class="nm-mdot" data-site={m.id} transform={`translate(${m.x.toFixed(1)} ${m.y.toFixed(1)})`}>
            <circle class="nm-mhalo" r="15" />
            <circle class="nm-member" r="6" />
            <title>{m.name}</title>
          </g>
        ))}
      </g>
      <g class="nm-sites" aria-hidden="true">
        {sites.map((s) => (
          <g class="nm-site" data-site={s.n} transform={`translate(${s.x.toFixed(1)} ${s.y.toFixed(1)})`}>
            <circle class="nm-halo" r={R + 7} />
            <circle class="nm-dot" r={R} />
            <text class="nm-dot-num" y="4.2">{s.n}</text>
          </g>
        ))}
      </g>
    </svg>
    <figcaption class="nm-caption">
      <span class="nm-key"><span class="nm-key-dot" aria-hidden="true"></span>{copy.facilities}</span>
      <span class="nm-key"><span class="nm-key-member" aria-hidden="true"></span>{copy.members}</span>
      <span class="nm-key"><span class="nm-diamond" aria-hidden="true"></span>{copy.events}</span>
      <a href="https://www.naturalearthdata.com/" target="_blank" rel="noopener noreferrer external">{copy.source}</a>
    </figcaption>
  </figure>
</div>

<script is:inline>
  (function () {
    function bind() {
      document.querySelectorAll('[data-network-map]').forEach(function (root) {
        if (root.dataset.bound) return;
        root.dataset.bound = '1';
        function set(id, on) {
          var marks = root.querySelectorAll('[data-site="' + id + '"]');
          marks.forEach(function (el) {
            el.classList.toggle('is-active', on);
          });
          // A country outside the map's frame has no mark to pick out, so
          // the map stays as it is.
          root.classList.toggle('has-active', on && marks.length > 1);
        }
        root.querySelectorAll('.nm-item, .nm-site, .nm-event, .nm-mdot').forEach(function (el) {
          var id = el.getAttribute('data-site');
          ['mouseenter', 'focus'].forEach(function (t) { el.addEventListener(t, function () { set(id, true); }); });
          ['mouseleave', 'blur'].forEach(function (t) { el.addEventListener(t, function () { set(id, false); }); });
          // Touch: a tap lights the pair for a moment.
          el.addEventListener('touchstart', function () { set(id, true); window.setTimeout(function () { set(id, false); }, 1600); }, { passive: true });
        });
      });
    }
    document.addEventListener('astro:page-load', bind);
    bind();
  })();
</script>

<style>
  .network-map {
    display: grid;
    gap: var(--space-l);
    grid-template-areas: 'head' 'map' 'lists';
  }
  .nm-head { grid-area: head; }
  .nm-figure { grid-area: map; }
  .nm-lists { grid-area: lists; }
  @media (min-width: 60rem) {
    /* The lists run longer than one screen, so the map and its legend stay
       in view beside them: the figure sticks under the header, and its
       column is as wide as a map (850 x 895) whose height leaves room for
       the legend in the viewport. The lists take the rest of the width. */
    .network-map {
      --nm-top: 5rem;
      /* Legend plus a little air below the attribution on short laptops. */
      --nm-legend: 8rem;
      --nm-map-w: min(58%, max(22rem, calc((100svh - var(--nm-top) - var(--nm-legend) - var(--space-s)) * 850 / 895)));
      grid-template-columns: minmax(0, 1fr) var(--nm-map-w);
      grid-template-rows: auto 1fr;
      grid-template-areas: 'head map' 'lists map';
      column-gap: clamp(var(--space-l), 5vw, var(--space-2xl));
      row-gap: 0;
    }
    .nm-figure {
      position: sticky;
      top: var(--nm-top);
      align-self: start;
    }
  }

  .nm-heading {
    max-width: 18ch;
    font-size: var(--step-2);
  }
  .nm-intro {
    margin-top: var(--space-m);
    max-width: var(--measure);
    font-size: clamp(1rem, 0.96rem + 0.16vw, 1.125rem);
    line-height: 1.55;
  }
  .nm-list-title {
    margin-top: var(--space-l);
    margin-bottom: var(--space-xs);
  }
  .nm-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    border-top: 1px solid var(--hairline);
  }
  @media (min-width: 36rem) and (max-width: 60rem) {
    .nm-list { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--space-m); }
  }
  .nm-item {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.55rem 0.4rem;
    margin-inline: -0.4rem;
    border-bottom: 1px solid var(--hairline);
    border-radius: var(--radius-xs);
    cursor: default;
    transition: background var(--transition);
  }
  .nm-item.is-active { background: var(--accent-dim); }
  .nm-item:focus-visible { outline-offset: 0; }
  .nm-num {
    flex: none;
    display: grid;
    place-items: center;
    width: 1.55rem;
    height: 1.55rem;
    border-radius: 50%;
    background: var(--accent);
    color: var(--accent-contrast);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 700;
  }
  .nm-item-text { display: grid; min-width: 0; }
  .nm-item-name {
    color: var(--text-strong);
    font-size: var(--step--1);
    font-weight: 560;
    line-height: 1.3;
  }
  .nm-item-place {
    color: var(--text-muted);
    font-size: var(--step--2);
    line-height: 1.35;
  }
  .nm-diamond {
    flex: none;
    width: 0.7rem;
    height: 0.7rem;
    margin-inline: 0.42rem;
    background: var(--highlight);
    transform: rotate(45deg);
  }
  /* Member countries: the same rows as the lists above, in short columns
     read top to bottom, each with the blue dot it has on the map. */
  .nm-members {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: repeat(var(--nm-rows-2), auto);
    grid-auto-flow: column;
    column-gap: var(--space-m);
  }
  @media (min-width: 30rem) {
    .nm-members {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-template-rows: repeat(var(--nm-rows-3), auto);
    }
  }
  /* Beside the map the list column is narrow until wide screens: two columns,
     so names such as "Estados Unidos" or "Guayana Francesa" do not wrap. */
  @media (min-width: 60rem) and (max-width: 82rem) {
    .nm-members {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: repeat(var(--nm-rows-2), auto);
    }
  }
  .nm-item--outside.is-active { background: none; }
  .nm-item--member { padding-block: 0.4rem; gap: 0.8rem; }
  .nm-item--member .nm-item-name { font-weight: 500; color: var(--text); }
  .nm-mark {
    flex: none;
    width: 0.7rem;
    height: 0.7rem;
    margin-inline: 0.425rem;
    border-radius: 50%;
    background: var(--tone-person-sky);
  }
  /* A country beyond the map's frame has no dot there: a hollow mark. */
  .nm-item--outside .nm-mark,
  .nm-mark--outside {
    background: transparent;
    box-shadow: inset 0 0 0 2px var(--tone-person-sky);
  }
  .nm-members-note {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin: var(--space-xs) 0 0;
    font-size: var(--step--2);
    color: var(--text-muted);
  }
  .nm-more { margin-top: var(--space-m); }

  /* ---- Map ---- */
  .nm-figure { margin: 0; min-width: 0; }
  .nm-svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .nm-country {
    fill: color-mix(in oklab, var(--text-muted) 11%, var(--bg));
    stroke: color-mix(in oklab, var(--text-muted) 38%, transparent);
    stroke-width: 0.7;
    stroke-linejoin: round;
  }
  .nm-country--active {
    fill: color-mix(in oklab, var(--accent) 17%, var(--bg));
    stroke: color-mix(in oklab, var(--accent) 50%, transparent);
  }
  /* On the dark page a faint land fill disappears: lift the land and its
     borders so the continent stands clear of the background. */
  :global([data-mode='dark']) .nm-country {
    fill: color-mix(in oklab, var(--text-muted) 32%, var(--bg));
    stroke: color-mix(in oklab, var(--text-muted) 80%, transparent);
    stroke-width: 1;
  }
  :global([data-mode='dark']) .nm-country--active {
    fill: color-mix(in oklab, var(--accent) 30%, var(--bg));
    stroke: color-mix(in oklab, var(--accent) 85%, transparent);
  }
  /* On a phone the place names would be a few pixels tall: the numbered
     list beside the map carries them instead. */
  @media (max-width: 40rem) {
    .nm-labels, .nm-event text { display: none; }
    /* The map is about 40% of its drawn size here, so the numbered
       facility markers grow to stay legible against the list. */
    .nm-site > * { transform: scale(1.5); }
  }
  .nm-labels text,
  .nm-event text {
    font-family: var(--font-mono);
    font-size: 15px;
    letter-spacing: 0.02em;
    fill: var(--text-muted);
    paint-order: stroke;
    stroke: var(--bg);
    stroke-width: 4px;
    stroke-linejoin: round;
  }
  /* On the light basemap the place names take the body colour, a little
     more size and a wider paper halo, so Tena or Puerto Maldonado read as
     clearly as the list beside the map. Dark mode keeps its palette. */
  :global([data-mode='light']) .nm-labels text,
  :global([data-mode='light']) .nm-event text {
    fill: var(--text);
    font-size: 16px;
    font-weight: 500;
    stroke-width: 5px;
  }
  .nm-halo {
    fill: var(--accent);
    opacity: 0.16;
    transition: opacity var(--transition), r var(--transition);
  }
  .nm-dot {
    fill: var(--accent);
    stroke: var(--bg);
    stroke-width: 2.5;
  }
  .nm-dot-num {
    font-family: var(--font-mono);
    font-size: 12.5px;
    font-weight: 700;
    text-anchor: middle;
    fill: var(--accent-contrast);
  }
  .nm-event rect {
    fill: var(--highlight);
    stroke: var(--bg);
    stroke-width: 2.5;
  }
  .nm-event text { fill: var(--highlight-strong); }
  .nm-site, .nm-event { transition: opacity var(--transition); }
  .network-map.has-active .nm-site:not(.is-active),
  .network-map.has-active .nm-event:not(.is-active) { opacity: 0.35; }
  .nm-site.is-active .nm-halo { opacity: 0.4; r: 24; }

  .nm-caption {
    margin-top: var(--space-s);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 1.2rem;
    font-size: var(--step--2);
    /* The legend is read, not decoration: normal secondary text colour. */
    color: var(--text-muted);
  }
  .nm-key { display: inline-flex; align-items: center; gap: 0.45rem; }
  .nm-key .nm-diamond { margin-inline: 0.1rem; width: 0.55rem; height: 0.55rem; }
  .nm-key-dot {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: var(--accent);
  }
  .nm-caption a { margin-left: auto; color: var(--text-faint); }
  .nm-member { fill: var(--tone-person-sky); stroke: var(--bg); stroke-width: 2.5; transition: r var(--transition); }
  .nm-mhalo { fill: var(--tone-person-sky); opacity: 0; pointer-events: all; transition: opacity var(--transition); }
  .nm-mdot { transition: opacity var(--transition); }
  .network-map.has-active .nm-mdot:not(.is-active) { opacity: 0.35; }
  .nm-mdot.is-active .nm-mhalo { opacity: 0.35; }
  .nm-mdot.is-active .nm-member { r: 8; }
  .nm-key-member { width: 0.6rem; height: 0.6rem; border-radius: 50%; background: var(--tone-person-sky); }

  @media (max-width: 60rem) {
    .nm-lists .nm-list-title:first-child { margin-top: 0; }
  }
</style>
