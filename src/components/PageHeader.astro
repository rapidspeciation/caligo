---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
}
const { eyebrow, title, intro } = Astro.props;
---

<header class:list={['page-header', { 'page-header--bare': !intro }]}>
  <div class="container-wide">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {intro && <p class="lead">{intro}</p>}
    <hr class="rule--vein page-header-rule" />
  </div>
</header>

<style>
  .page-header {
    padding-top: var(--space-xl);
    padding-bottom: 0;
  }
  .page-header h1 {
    margin-top: 0.85rem;
    max-width: 20ch;
  }
  .page-header .lead {
    margin-top: var(--space-s);
    max-width: var(--measure);
    color: var(--text-muted);
  }
  .page-header-rule {
    margin-top: var(--space-m);
  }
  /* A title with no lead line (Funding) needs less air around it: the
     section after it starts closer, and on a phone the title sits higher. */
  @media (min-width: 48.01rem) {
    :global(#main) > .page-header--bare + :global(.section) { padding-top: var(--space-l); }
  }
  @media (max-width: 48rem) {
    .page-header--bare { padding-top: var(--space-l); }
  }
</style>
