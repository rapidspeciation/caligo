---
/**
 * Slim site-wide announcement for the open funding call. Rendered hidden;
 * `caligoDeadlines()` reveals it before first paint while the call is open
 * and the visitor has not dismissed it, and keeps it hidden afterwards.
 */
import Icon from './Icon.astro';
import DeadlineChip from './DeadlineChip.astro';
import { PILOT_DEADLINE, PILOT_INTRO } from '../data/pilot-call';
import { localePath, type Locale } from '../i18n';

interface Props {
  readonly locale: Locale;
}
const { locale } = Astro.props;
const copy = PILOT_INTRO[locale];
---

<div class="funding-banner" data-funding-banner={PILOT_DEADLINE} hidden>
  <div class="container-wide funding-banner-inner">
    <a class="funding-banner-link" href={localePath(locale, '/funding')}>
      <span class="funding-banner-name">{copy.banner}</span>
      <DeadlineChip locale={locale} class="funding-banner-chip" />
      <span class="funding-banner-action">{copy.bannerAction}<Icon name="arrow-right" /></span>
    </a>
    <button type="button" class="funding-banner-close" data-funding-banner-close aria-label={copy.dismiss}>
      <Icon name="close" />
    </button>
  </div>
</div>
<script is:inline>window.caligoDeadlines && window.caligoDeadlines();</script>

<style>
  .funding-banner {
    border-bottom: 1px solid var(--hairline);
    background: color-mix(in oklab, var(--accent) 10%, var(--bg-panel));
    font-size: var(--step--1);
  }
  .funding-banner[hidden] { display: none; }
  .funding-banner-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-s);
    min-height: 2.5rem;
  }
  .funding-banner-link {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.35rem 0.75rem;
    padding-block: 0.35rem;
    color: var(--text-strong);
    text-decoration: none;
  }
  .funding-banner-name { font-weight: 560; }
  .funding-banner :global(.funding-banner-chip) { padding-block: 0.1rem; font-size: var(--step--2); }
  .funding-banner-action {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--accent-strong);
    font-weight: 560;
  }
  .funding-banner-action :global(svg) {
    width: 0.95rem;
    height: 0.95rem;
    transition: transform var(--transition);
  }
  .funding-banner-link:hover .funding-banner-action :global(svg) { transform: translateX(2px); }
  .funding-banner-link:focus-visible,
  .funding-banner-close:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 4px;
  }
  .funding-banner-close {
    display: grid;
    place-items: center;
    flex: none;
    width: 1.8rem;
    height: 1.8rem;
    padding: 0;
    border: 0;
    border-radius: 4px;
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
  }
  .funding-banner-close:hover { color: var(--text-strong); background: color-mix(in oklab, currentColor 8%, transparent); }
  .funding-banner-close :global(svg) { width: 1rem; height: 1rem; }
  @media (max-width: 36rem) {
    .funding-banner-inner { justify-content: space-between; }
    .funding-banner-link { justify-content: flex-start; }
  }
</style>
