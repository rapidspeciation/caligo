---
/**
 * How a specimen stays linked to its genome, after the way Ikiam preserves
 * vouchers: the wings go into a labelled envelope (ID, species, sex), the
 * body into a tube for DNA, and the genome carries the same ID. Plays once
 * in view through the shared TierDiagram script ([data-tier-diagram]);
 * the static markup is the final state for reduced motion and no-JS.
 */
import { getDict, type Locale } from '../i18n';
import { BUTTERFLY } from '../data/diagram-glyphs';

interface Props {
  readonly locale: Locale;
}
const { locale } = Astro.props;
const t = getDict(locale).home.tiers;
const v = t.diagrams.voucher;
const ID = 'CAM041027';
const chromosomes = [70, 62, 55, 48, 41].map((h, i) => ({ x: 486 + i * 20, h, d: 3.45 + i * 0.08 }));
---

<figure class="voucher-diagram" data-tier-diagram>
  <svg viewBox="150 0 450 230" role="img" aria-label={v.desc}>
    <!-- Envelope for the wings -->
    <g class="vd-envelope">
      <rect x="206" y="24" width="214" height="106" rx="4" />
      <path d="M206 26 L313 58 L420 26" class="vd-flap" />
    </g>
    <!-- Tube for the body -->
    <g class="vd-tube">
      <rect x="230" y="156" width="166" height="34" rx="17" />
      <rect x="214" y="151" width="24" height="44" rx="4" class="vd-cap" />
    </g>

    <!-- Wings travel from the whole butterfly into the envelope -->
    <g class="vd-wings">
      <path d={BUTTERFLY.forewing} />
      <path d={BUTTERFLY.forewing} transform="scale(-1 1)" />
      <path d={BUTTERFLY.hindwing} />
      <path d={BUTTERFLY.hindwing} transform="scale(-1 1)" />
      <path d={BUTTERFLY.band} class="vd-band" />
      <path d={BUTTERFLY.band} class="vd-band" transform="scale(-1 1)" />
    </g>
    <g class="vd-antennae">
      <path d={BUTTERFLY.antennae} />
    </g>
    <!-- Body travels into the tube -->
    <g class="vd-body">
      <path d={BUTTERFLY.body} />
    </g>

    <!-- Labels: the same ID everywhere -->
    <g class="vd-label vd-label--envelope">
      <text x="318" y="80" class="vd-id">{ID}</text>
      <text x="318" y="99" class="vd-species">H. cydno</text>
      <text x="318" y="117" class="vd-meta">{v.sex}</text>
    </g>
    <text x="386" y="178" class="vd-id vd-label vd-label--tube" text-anchor="end">{ID}</text>

    <!-- DNA from the tube becomes the genome -->
    <path d="M400 173 C446 173 450 104 476 94" class="vd-arrow" pathLength="1" />
    <text x="420" y="200" class="vd-dna" text-anchor="start">{v.dna}</text>
    {chromosomes.map((c) => (
      <rect x={c.x} y={88 - c.h / 2} width="12" height={c.h} rx="6" class="vd-chr" style={`--d:${c.d}s`} />
    ))}
    <g class="vd-label vd-label--genome">
      <rect x="474" y="138" width="110" height="26" rx="3" class="vd-tag" />
      <text x="529" y="156" class="vd-id" text-anchor="middle">{ID}</text>
    </g>
  </svg>

  <button type="button" class="vd-replay" data-replay hidden>
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 12a9 9 0 1 0 3-6.7" /><path d="M3 4v5h5" /></svg>
    <span>{t.replay}</span>
  </button>
</figure>

<style>
  .voucher-diagram {
    position: relative;
    margin: 0;
  }
  .voucher-diagram > svg { display: block; width: 100%; height: auto; overflow: visible; }

  .vd-envelope rect { fill: color-mix(in oklab, var(--bg-panel) 70%, var(--highlight-dim)); stroke: var(--text-faint); stroke-width: 1.5; }
  .vd-flap { fill: none; stroke: var(--text-faint); stroke-width: 1.5; stroke-linejoin: round; }
  .vd-tube rect { fill: color-mix(in oklab, var(--bg-panel) 80%, transparent); stroke: var(--text-faint); stroke-width: 1.5; }
  .vd-tube .vd-cap { fill: var(--text-faint); stroke: none; }

  /* Final positions; the animation starts both from the whole butterfly. */
  .vd-wings { transform: translate(266px, 80px) scale(1.25); }
  .vd-wings path { fill: var(--text-muted); }
  .vd-wings .vd-band { fill: var(--highlight); }
  .vd-body { transform: translate(274px, 173px) rotate(90deg) scale(2); }
  .vd-body path { fill: none; stroke: var(--text-strong); stroke-width: 2.4; stroke-linecap: round; }
  .vd-antennae { transform: translate(222px, 98px) scale(2.1); opacity: 0; }
  .vd-antennae path { fill: none; stroke: var(--text-muted); stroke-width: 1; stroke-linecap: round; }

  .vd-id { font-family: var(--font-mono); font-size: 13px; font-weight: 700; fill: var(--accent); letter-spacing: 0.02em; }
  .vd-species { font-family: var(--font-body); font-size: 13px; font-style: italic; fill: var(--text-strong); }
  .vd-meta { font-family: var(--font-mono); font-size: 11.5px; fill: var(--text-muted); }
  .vd-tag { fill: var(--bg); stroke: var(--accent); stroke-width: 1.5; }
  .vd-arrow { fill: none; stroke: var(--text-faint); stroke-width: 2; stroke-dasharray: 1; stroke-dashoffset: 0; stroke-linecap: round; }
  .vd-dna { font-family: var(--font-mono); font-size: 12px; font-weight: 600; fill: var(--text-muted); }
  .vd-chr { fill: var(--accent); transform-box: fill-box; transform-origin: center; }

  .vd-replay {
    position: absolute;
    right: 0;
    bottom: -0.25rem;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.65rem;
    border: 1px solid var(--surface-border);
    border-radius: 999px;
    background: var(--bg);
    color: var(--text-muted);
    font: inherit;
    font-size: var(--step--2);
    cursor: pointer;
  }
  .vd-replay[hidden] { display: none; }
  .vd-replay:hover { color: var(--text-strong); border-color: var(--surface-border-strong); }
  .vd-replay svg { width: 0.8rem; height: 0.8rem; fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }

  /* ---- Animation, armed by the shared TierDiagram script ---- */
  .is-armed .vd-envelope, .is-armed .vd-tube { animation: vd-fade 0.5s 0.85s ease-out; }
  .is-armed .vd-antennae { animation: vd-antennae 1.2s 0s ease-in; }
  .is-armed .vd-wings { animation: vd-wings 1.2s 0.9s var(--ease-glide); }
  .is-armed .vd-body { animation: vd-body 1.2s 1.15s var(--ease-glide); }
  .is-armed .vd-label--envelope { animation: vd-fade 0.45s 2.3s ease-out; }
  .is-armed .vd-label--tube { animation: vd-fade 0.45s 2.6s ease-out; }
  .is-armed .vd-arrow { animation: vd-draw 0.8s 2.9s ease-out; }
  .is-armed .vd-dna { animation: vd-fade 0.4s 3.2s ease-out; }
  .is-armed .vd-chr { animation: vd-grow 0.4s var(--d) var(--ease-settle); }
  .is-armed .vd-label--genome { animation: vd-fade 0.45s 4.05s ease-out; }

  .is-armed :is(.vd-envelope, .vd-tube, .vd-antennae, .vd-wings, .vd-body, .vd-label, .vd-arrow, .vd-dna, .vd-chr) {
    animation-fill-mode: both;
    animation-play-state: paused;
  }
  .is-armed.is-playing :is(.vd-envelope, .vd-tube, .vd-antennae, .vd-wings, .vd-body, .vd-label, .vd-arrow, .vd-dna, .vd-chr) {
    animation-play-state: running;
  }

  @keyframes vd-fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes vd-antennae { from, 70% { opacity: 1; } to { opacity: 0; } }
  @keyframes vd-wings {
    from { transform: translate(222px, 98px) scale(2.1); }
    to { transform: translate(266px, 80px) scale(1.25); }
  }
  @keyframes vd-body {
    from { transform: translate(222px, 98px) rotate(0deg) scale(2.1); }
    to { transform: translate(274px, 173px) rotate(90deg) scale(2); }
  }
  @keyframes vd-draw { 0% { stroke-dashoffset: 1; opacity: 0; } 2% { opacity: 1; } 100% { stroke-dashoffset: 0; opacity: 1; } }
  @keyframes vd-grow { from { opacity: 0; transform: scaleY(0); } to { opacity: 1; transform: scaleY(1); } }
</style>
