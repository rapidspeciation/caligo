---
/**
 * A small explorable for the Science question on chromosome number in
 * Heliconius: 21 chromosomes, as in most species, split by up to 39 fissions
 * into 60, the highest count in the sapho group (Rueda-M et al. 2024).
 *
 * The one idea: a fission only persists if both pieces can still be moved
 * into the daughter cells. A toggle compares the holocentric chromosomes of
 * butterflies and moths, where the division machinery can attach along the
 * whole length, with a single centromere, as in most animals: there, every
 * piece left without the centromere is lost (the textbook behaviour of an
 * acentric fragment, labelled as a simplification). Shape carries the
 * difference (an attachment line on every piece versus one dot; lost pieces
 * become tilted dashed outlines), so it does not depend on colour.
 *
 * Laid out across the full prose column: karyotype on the left, the
 * question and the result on the right, stacked when the column is narrow.
 *
 * The markup is the final state (39 fissions, holocentric). With JavaScript
 * and motion allowed, the figure plays each time it comes into view: the
 * fissions add up from 21 to 60 chromosomes, the same splits are then shown
 * with a single centromere, and it returns to the butterfly. The toggle is
 * the one control: the reader can flip the comparison at any time. The
 * karyotype is the one drawn by the reference-genome tier diagram.
 */
import { getDict, type Locale } from '../i18n';
import { KARYOTYPE, seededRandom } from '../data/diagram-glyphs';

interface Props {
  readonly locale: Locale;
}

const { locale } = Astro.props;
const dict = getDict(locale);
const copy = dict.science.fission;
const replay = dict.science.tiers.replay;
const id = 'fission-explainer';

const MAX_FISSIONS = 39;
const W = 13;
const X0 = 60;
const VIEW = '46 10 268 226';
const PITCH = 40;
const ROW_CY = [44, 110, 176];
const GAP = 1.6;

const rand = seededRandom(60);
const chromosomes = KARYOTYPE.map((h, i) => ({
  h,
  x: X0 + (i % 7) * PITCH - W / 2,
  top: Math.round((ROW_CY[Math.floor(i / 7)] - h / 2) * 10) / 10,
  centromere: Math.round(h * (0.3 + rand() * 0.4) * 10) / 10,
  cuts: [] as { at: number; n: number }[],
}));

/* The 39 fissions, in order: each splits the longest remaining piece near
   its middle (never right at the centromere), so pieces stay legible. */
type Piece = { c: number; a: number; b: number };
let pieces: Piece[] = chromosomes.map((c, i) => ({ c: i, a: 0, b: c.h }));
for (let n = 0; n < MAX_FISSIONS; n++) {
  const longest = pieces.reduce((m, p) => (p.b - p.a > m.b - m.a ? p : m));
  const chr = chromosomes[longest.c];
  // Cut near the middle, at least 6 units from the centromere dot; widen
  // the window if a piece is short, and fall back to the plain middle.
  const len = longest.b - longest.a;
  let at = longest.a + len / 2;
  for (let tries = 0; tries < 40; tries++) {
    const spread = 0.24 + Math.min(tries, 20) * 0.01;
    const candidate = longest.a + len * (0.5 - spread / 2 + rand() * spread);
    if (Math.abs(candidate - chr.centromere) >= 6) { at = candidate; break; }
  }
  at = Math.round(at * 10) / 10;
  chr.cuts.push({ at, n });
  pieces = pieces.flatMap((p) => (p === longest ? [{ ...p, b: at }, { ...p, a: at }] : [p]));
}

/** Pieces of one chromosome after the first f fissions. */
function split(i: number, f: number) {
  const c = chromosomes[i];
  const edges = [0, ...c.cuts.filter((k) => k.n < f).map((k) => k.at).sort((a, b) => a - b), c.h];
  return edges.slice(0, -1).map((a, j) => {
    const b = edges[j + 1];
    const y0 = c.top + a + (a > 0 ? GAP : 0);
    const y1 = c.top + b - (b < c.h ? GAP : 0);
    return { y: Math.round(y0 * 10) / 10, h: Math.round((y1 - y0) * 10) / 10, kept: a <= c.centromere && c.centromere <= b };
  });
}

const finalState = chromosomes.map((_, i) => split(i, MAX_FISSIONS));
const shortest = Math.min(...finalState.flat().map((p) => p.h));
if (finalState.flat().length !== 60 || shortest < 5) {
  throw new Error(`FissionExplainer: expected 60 legible pieces (got ${finalState.flat().length}, shortest ${shortest})`);
}
const data = {
  max: MAX_FISSIONS,
  w: W,
  chr: chromosomes.map((c) => ({ x: c.x, top: c.top, h: c.h, cen: c.centromere, cuts: c.cuts.map((k) => [k.at, k.n]) })),
  copy: { unit: copy.unit, start: copy.start, splitting: copy.splitting, holoMax: copy.holoMax, mono: copy.mono, count: copy.count, countLost: copy.countLost },
};
---

<figure id={id} class="fission ink-card" data-fission data-config={JSON.stringify(data)} data-mode="holo">
  <div class="fission-grid">
    <svg viewBox={VIEW} role="img" aria-labelledby={`${id}-title ${id}-desc`}>
      <title id={`${id}-title`}>{copy.title}</title>
      <desc id={`${id}-desc`}>{copy.desc}</desc>
      <g data-karyotype>
        {chromosomes.map((c, i) => finalState[i].map((p) => (
          <g class="fs-piece">
            <rect x={c.x} y={p.y} width={W} height={p.h} rx={Math.min(W / 2, p.h / 2)} class="fs-bar" />
            <path d={`M${c.x + W / 2} ${p.y + 2.5} V${p.y + p.h - 2.5}`} class="fs-line" />
          </g>
        )))}
      </g>
      <text x={X0 - W / 2} y="228" class="fs-count" data-count>{copy.count.replace('{c}', '60')}</text>
    </svg>

    <div class="explorable-panel fission-panel" data-panel hidden>
      <fieldset class="fission-mode">
        <legend class="explorable-prompt">{copy.modeLegend}</legend>
        <div class="explorable-toggle">
          {copy.modes.map((label, n) => (
            <label>
              <input type="radio" name={`${id}-mode`} value={n === 0 ? 'holo' : 'mono'} checked={n === 0} />
              <svg class="fission-key" viewBox="0 0 14 30" aria-hidden="true" focusable="false">
                <rect x="1" y="1" width="12" height="28" rx="6" />
                {n === 0 ? <path d="M7 5 V25" /> : <circle cx="7" cy="12" r="3" />}
              </svg>
              <span>{label}</span>
            </label>
          ))}
        </div>
      </fieldset>
      <output class="explorable-result" data-result></output>
        <button type="button" class="explorable-replay" data-replay aria-label={replay} title={replay}>
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 12a9 9 0 1 0 3-6.7" /><path d="M3 4v5h5" /></svg>
        </button>
    </div>
  </div>
</figure>

<script>
  const SVG_NS = 'http://www.w3.org/2000/svg';
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  const fill = (tpl: string, vars: Record<string, string | number>) =>
    tpl.replace(/\{(\w+)\}/g, (_, key: string) => String(vars[key] ?? ''));

  document.querySelectorAll<HTMLElement>('[data-fission]').forEach((figure) => {
    const cfg = JSON.parse(figure.dataset.config ?? '{}');
    const layer = figure.querySelector<SVGGElement>('[data-karyotype]');
    const count = figure.querySelector<SVGTextElement>('[data-count]');
    const result = figure.querySelector<HTMLOutputElement>('[data-result]');
    const replay = figure.querySelector<HTMLButtonElement>('[data-replay]');
    const panel = figure.querySelector<HTMLElement>('[data-panel]');
    const modes = figure.querySelectorAll<HTMLInputElement>('input[type="radio"]');
    if (!layer || !count || !result || !replay || !panel) return;
    let frame = 0;
    let cueTimer = 0;
    // How many of the 39 fissions are drawn.
    let fissions: number = cfg.max;
    const timers = new Set<number>();
    const after = (ms: number, fn: () => void) => {
      const t = window.setTimeout(() => { timers.delete(t); fn(); }, ms);
      timers.add(t);
    };
    let touched = false;
    let cued = false;

    const el = (name: string, attrs: Record<string, string | number>) => {
      const node = document.createElementNS(SVG_NS, name);
      for (const [k, v] of Object.entries(attrs)) node.setAttribute(k, String(v));
      return node;
    };

    const render = () => {
      const f = fissions;
      const mono = figure.dataset.mode === 'mono';
      const w = cfg.w;
      const nodes: SVGElement[] = [];
      let n = 0;
      for (const c of cfg.chr) {
        const edges = [0, ...c.cuts.filter(([, k]: number[]) => k < f).map(([at]: number[]) => at).sort((a: number, b: number) => a - b), c.h];
        for (let j = 0; j < edges.length - 1; j++) {
          const a = edges[j];
          const b = edges[j + 1];
          const y = c.top + a + (a > 0 ? 1.6 : 0);
          const h = c.top + b - (b < c.h ? 1.6 : 0) - y;
          const kept = a <= c.cen && c.cen <= b;
          const lost = mono && !kept;
          const g = el('g', { class: `fs-piece${lost ? ' is-lost' : ''}` }) as SVGGElement;
          // A lost piece tilts out of line, alternately left and right.
          if (lost) g.style.setProperty('--tilt', `${n % 2 ? 16 : -16}deg`);
          g.append(el('rect', { x: c.x, y: y.toFixed(1), width: w, height: h.toFixed(1), rx: Math.min(w / 2, h / 2).toFixed(1), class: 'fs-bar' }));
          if (!mono) g.append(el('path', { d: `M${c.x + w / 2} ${(y + 2.5).toFixed(1)} V${(y + h - 2.5).toFixed(1)}`, class: 'fs-line' }));
          else if (kept) g.append(el('circle', { cx: c.x + w / 2, cy: (c.top + c.cen).toFixed(1), r: 3.2, class: 'fs-centromere' }));
          nodes.push(g);
          n++;
        }
      }
      layer.replaceChildren(...nodes);
      const total = 21 + f;
      count.textContent = mono && f > 0 ? fill(cfg.copy.countLost, { c: 21, n: f }) : fill(cfg.copy.count, { c: total });
      const unit = `${f} ${cfg.copy.unit[f === 1 ? 0 : 1]}`;
      const text = f === 0
        ? cfg.copy.start
        : f < cfg.max
          ? cfg.copy.splitting
          : mono
            ? fill(cfg.copy.mono, { f: unit, n: f })
            : fill(cfg.copy.holoMax, { f: unit, c: total });
      if (result.innerHTML !== text) result.innerHTML = text;
    };

    const stop = () => {
      cancelAnimationFrame(frame);
      window.clearTimeout(cueTimer);
      timers.forEach((t) => window.clearTimeout(t));
      timers.clear();
      frame = 0;
    };
    const take = () => { stop(); touched = true; fissions = cfg.max; result.removeAttribute('aria-live'); };
    // "Your turn": one nudge on the answer the reader is not looking at.
    const cue = () => {
      const other = [...modes].find((input) => !input.checked)?.closest('label');
      if (cued || touched || !other) return;
      cued = true;
      other.classList.add('is-cue');
      window.setTimeout(() => other.classList.remove('is-cue'), 1600);
    };
    const setMode = (mode: string) => {
      figure.dataset.mode = mode;
      modes.forEach((input) => { input.checked = input.value === mode; });
      render();
      if (reduce.matches) return;
      figure.classList.remove('is-switching');
      void figure.getBoundingClientRect();
      figure.classList.add('is-switching');
    };

    // The autoplay: the chromosomes split 39 times and all 60 pieces are
    // kept; the same splits are then shown with one centromere, where 39
    // pieces are lost; and it comes back to the butterfly.
    const play = () => {
      stop();
      result.setAttribute('aria-live', 'off');
      const t0 = performance.now();
      const run = (now: number) => {
        const k = Math.min(1, (now - t0 - 1400) / 3200);
        const eased = k <= 0 ? 0 : 1 - Math.pow(1 - k, 2);
        fissions = Math.round(eased * cfg.max);
        render();
        if (k < 1) { frame = requestAnimationFrame(run); return; }
        frame = 0;
        after(3200, () => setMode('mono'));
        after(7400, () => {
          setMode('holo');
          result.removeAttribute('aria-live');
          cueTimer = window.setTimeout(cue, 600);
        });
      };
      frame = requestAnimationFrame(run);
    };

    modes.forEach((input) => input.addEventListener('change', () => {
      take();
      setMode(input.value);
    }));
    replay.addEventListener('click', () => {
      touched = false;
      stop();
      figure.dataset.mode = 'holo';
      figure.classList.remove('is-switching');
      modes.forEach((input) => { input.checked = input.value === 'holo'; });
      if (reduce.matches) { fissions = cfg.max; render(); return; }
      play();
    });

    panel.hidden = false;
    render();

    if (!reduce.matches && 'IntersectionObserver' in window) {
      let shown = false;
      new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (entry.intersectionRatio >= 0.6 && !shown) {
            shown = true;
            if (!touched) replay.click();
          } else if (!entry.isIntersecting) {
            shown = false;
          }
        }
      }, { threshold: [0, 0.6] }).observe(figure.querySelector('svg') ?? figure);
    }
  });
</script>

<style>
  .fission {
    --stage: var(--tier-stage, var(--card));
    container-type: inline-size;
    /* Room on the right for the card's hard shadow. */
    margin: var(--space-s) var(--ink-drop) var(--space-m) 0;
    padding: 1rem 1.1rem;
    background: var(--stage);
  }
  .fission-grid { display: grid; gap: 0.75rem; }
  .fission-grid > svg {
    display: block;
    user-select: none;
    width: 100%;
    max-width: 22rem;
    height: auto;
    margin-inline: auto;
    overflow: visible;
  }
  /* Karyotype left, questions and result right, once there is room. */
  @container (min-width: 36rem) {
    .fission-grid { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1fr); gap: 1.5rem; align-items: center; }
    .fission-panel { padding-top: 0; padding-left: 1.5rem; border-top: 0; border-left: 1px dashed var(--surface-border-strong); }
    .fission-panel :global(.explorable-replay) { top: -0.15rem; }
  }
  /* Pieces are redrawn by the script, so these rules are global, scoped
     by the figure's own class instead. */
  .fission :global(.fs-bar) { fill: var(--accent); }
  .fission :global(.fs-piece) { transform-box: fill-box; transform-origin: center; }
  /* Holocentric: a line of attachment points runs the length of every piece. */
  .fission :global(.fs-line) { fill: none; stroke: var(--stage); stroke-width: 2; stroke-linecap: round; stroke-dasharray: 0.1 3.4; }
  /* One centromere: a single dot; pieces without it tilt out of line, lost. */
  .fission :global(.fs-centromere) { fill: var(--stage); }
  .fission :global(.is-lost) { transform: rotate(var(--tilt, 0deg)); }
  .fission :global(.is-lost .fs-bar) { fill: none; stroke: var(--text-muted); stroke-width: 1.25; stroke-dasharray: 2 2.2; }
  .fission:global(.is-switching) :global(.is-lost) { animation: fs-lose 0.45s var(--ease-settle) both; }
  .fs-count { font-family: var(--font-display); font-size: 16px; font-weight: 600; fill: var(--text-strong); }
  @keyframes fs-lose { from { transform: rotate(0deg); opacity: 0.2; } to { transform: rotate(var(--tilt, 0deg)); opacity: 1; } }

  /* The longest result runs to three lines; reserve them so nothing jumps. */
  .fission-panel :global(.explorable-result) { min-height: 3lh; }
  .fission-mode {
    display: grid;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }
  .fission-mode legend { padding: 0; margin-bottom: 0.45rem; }
  /* Each answer carries the mark it draws on the chromosomes. */
  .fission-key { flex: none; width: 0.7rem; height: 1.5rem; }
  .fission-key rect { fill: var(--accent); }
  .fission-key path { fill: none; stroke: var(--stage); stroke-width: 2; stroke-linecap: round; stroke-dasharray: 0.1 3.4; }
  .fission-key circle { fill: var(--stage); }
</style>
