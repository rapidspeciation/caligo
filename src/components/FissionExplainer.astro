---
/**
 * A small explorable for the Science question on chromosome number in
 * Heliconius: 21 chromosomes, as in most species, split by up to 39 fissions
 * into 60, the highest count in the sapho group (Rueda-M et al. 2024).
 *
 * A toggle compares the butterflies' holocentric chromosomes, where the
 * division machinery can attach along the whole length, with a single
 * centromere, as in humans: there, every piece without the centromere would
 * be lost at cell division. Shape carries the difference (an attachment line
 * on every piece versus one dot; lost pieces become dashed outlines), so it
 * does not depend on colour.
 *
 * The markup is the final state (39 fissions, holocentric). With JavaScript
 * and motion allowed, the slider runs from 0 to 39 each time the figure comes
 * into view, until the reader takes over. The karyotype is the one drawn by
 * the reference-genome tier diagram.
 */
import { getDict, type Locale } from '../i18n';
import { KARYOTYPE, seededRandom } from '../data/diagram-glyphs';

interface Props {
  readonly locale: Locale;
}

const { locale } = Astro.props;
const dict = getDict(locale);
const copy = dict.science.fission;
const replay = dict.science.tiers.replay;
const id = 'fission-explainer';

const MAX_FISSIONS = 39;
const W = 13;
const X0 = 60;
const PITCH = 40;
const ROW_CY = [44, 110, 176];
const GAP = 1.6;

const rand = seededRandom(60);
const chromosomes = KARYOTYPE.map((h, i) => ({
  h,
  x: X0 + (i % 7) * PITCH - W / 2,
  top: Math.round((ROW_CY[Math.floor(i / 7)] - h / 2) * 10) / 10,
  centromere: Math.round(h * (0.3 + rand() * 0.4) * 10) / 10,
  cuts: [] as { at: number; n: number }[],
}));

/* The 39 fissions, in order: each splits the longest remaining piece near
   its middle (never right at the centromere), so pieces stay legible. */
type Piece = { c: number; a: number; b: number };
let pieces: Piece[] = chromosomes.map((c, i) => ({ c: i, a: 0, b: c.h }));
for (let n = 0; n < MAX_FISSIONS; n++) {
  const longest = pieces.reduce((m, p) => (p.b - p.a > m.b - m.a ? p : m));
  const chr = chromosomes[longest.c];
  // Cut near the middle, at least 6 units from the centromere dot; widen
  // the window if a piece is short, and fall back to the plain middle.
  const len = longest.b - longest.a;
  let at = longest.a + len / 2;
  for (let tries = 0; tries < 40; tries++) {
    const spread = 0.24 + Math.min(tries, 20) * 0.01;
    const candidate = longest.a + len * (0.5 - spread / 2 + rand() * spread);
    if (Math.abs(candidate - chr.centromere) >= 6) { at = candidate; break; }
  }
  at = Math.round(at * 10) / 10;
  chr.cuts.push({ at, n });
  pieces = pieces.flatMap((p) => (p === longest ? [{ ...p, b: at }, { ...p, a: at }] : [p]));
}

/** Pieces of one chromosome after the first f fissions. */
function split(i: number, f: number) {
  const c = chromosomes[i];
  const edges = [0, ...c.cuts.filter((k) => k.n < f).map((k) => k.at).sort((a, b) => a - b), c.h];
  return edges.slice(0, -1).map((a, j) => {
    const b = edges[j + 1];
    const y0 = c.top + a + (a > 0 ? GAP : 0);
    const y1 = c.top + b - (b < c.h ? GAP : 0);
    return { y: Math.round(y0 * 10) / 10, h: Math.round((y1 - y0) * 10) / 10, kept: a <= c.centromere && c.centromere <= b };
  });
}

const finalState = chromosomes.map((_, i) => split(i, MAX_FISSIONS));
const shortest = Math.min(...finalState.flat().map((p) => p.h));
if (finalState.flat().length !== 60 || shortest < 5) {
  throw new Error(`FissionExplainer: expected 60 legible pieces (got ${finalState.flat().length}, shortest ${shortest})`);
}
const data = {
  max: MAX_FISSIONS,
  w: W,
  chr: chromosomes.map((c) => ({ x: c.x, top: c.top, h: c.h, cen: c.centromere, cuts: c.cuts.map((k) => [k.at, k.n]) })),
  copy: { unit: copy.unit, start: copy.start, holo: copy.holo, holoMax: copy.holoMax, mono: copy.mono, count: copy.count },
};
---

<figure id={id} class="fission" data-fission data-config={JSON.stringify(data)} data-mode="holo">
  <svg viewBox="0 0 360 222" role="img" aria-labelledby={`${id}-title ${id}-desc`}>
    <title id={`${id}-title`}>{copy.title}</title>
    <desc id={`${id}-desc`}>{copy.desc}</desc>
    <g data-karyotype>
      {chromosomes.map((c, i) => finalState[i].map((p) => (
        <g class="fs-piece">
          <rect x={c.x} y={p.y} width={W} height={p.h} rx={Math.min(W / 2, p.h / 2)} class="fs-bar" />
          <path d={`M${c.x + W / 2} ${p.y + 2.5} V${p.y + p.h - 2.5}`} class="fs-line" />
        </g>
      )))}
    </g>
    <text x={X0 - W / 2} y="218" class="fs-count" data-count>{copy.count.replace('{c}', '60')}</text>
  </svg>

  <div class="explorable-panel" data-panel hidden>
    <label class="explorable-label" for={`${id}-range`}>{copy.slider}</label>
    <input id={`${id}-range`} class="explorable-range" type="range" min="0" max={MAX_FISSIONS} step="1" value={MAX_FISSIONS} data-range />
    <fieldset class="fission-mode">
      <legend class="explorable-label">{copy.modeLegend}</legend>
      <div class="explorable-toggle">
        {copy.modes.map((label, n) => (
          <label>
            <input type="radio" name={`${id}-mode`} value={n === 0 ? 'holo' : 'mono'} checked={n === 0} />
            {label}
          </label>
        ))}
      </div>
    </fieldset>
    <div class="explorable-foot">
      <output class="explorable-readout" for={`${id}-range`} data-readout></output>
      <button type="button" class="explorable-replay" data-replay>
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 12a9 9 0 1 0 3-6.7" /><path d="M3 4v5h5" /></svg>
        <span>{replay}</span>
      </button>
    </div>
  </div>
</figure>

<script>
  const SVG_NS = 'http://www.w3.org/2000/svg';
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  const fill = (tpl: string, vars: Record<string, string | number>) =>
    tpl.replace(/\{(\w+)\}/g, (_, key: string) => String(vars[key] ?? ''));

  document.querySelectorAll<HTMLElement>('[data-fission]').forEach((figure) => {
    const cfg = JSON.parse(figure.dataset.config ?? '{}');
    const layer = figure.querySelector<SVGGElement>('[data-karyotype]');
    const count = figure.querySelector<SVGTextElement>('[data-count]');
    const range = figure.querySelector<HTMLInputElement>('[data-range]');
    const readout = figure.querySelector<HTMLOutputElement>('[data-readout]');
    const replay = figure.querySelector<HTMLButtonElement>('[data-replay]');
    const panel = figure.querySelector<HTMLElement>('[data-panel]');
    const modes = figure.querySelectorAll<HTMLInputElement>('input[type="radio"]');
    if (!layer || !count || !range || !readout || !replay || !panel) return;
    let frame = 0;
    let touched = false;

    const el = (name: string, attrs: Record<string, string | number>) => {
      const node = document.createElementNS(SVG_NS, name);
      for (const [k, v] of Object.entries(attrs)) node.setAttribute(k, String(v));
      return node;
    };

    const render = () => {
      const f = Number(range.value);
      const mono = figure.dataset.mode === 'mono';
      const w = cfg.w;
      const nodes: SVGElement[] = [];
      for (const c of cfg.chr) {
        const edges = [0, ...c.cuts.filter(([, n]: number[]) => n < f).map(([at]: number[]) => at).sort((a: number, b: number) => a - b), c.h];
        for (let j = 0; j < edges.length - 1; j++) {
          const a = edges[j];
          const b = edges[j + 1];
          const y = c.top + a + (a > 0 ? 1.6 : 0);
          const h = c.top + b - (b < c.h ? 1.6 : 0) - y;
          const kept = a <= c.cen && c.cen <= b;
          const g = el('g', { class: `fs-piece${mono && !kept ? ' is-lost' : ''}` });
          g.append(el('rect', { x: c.x, y: y.toFixed(1), width: w, height: h.toFixed(1), rx: Math.min(w / 2, h / 2).toFixed(1), class: 'fs-bar' }));
          if (!mono) g.append(el('path', { d: `M${c.x + w / 2} ${(y + 2.5).toFixed(1)} V${(y + h - 2.5).toFixed(1)}`, class: 'fs-line' }));
          else if (kept) g.append(el('circle', { cx: c.x + w / 2, cy: (c.top + c.cen).toFixed(1), r: 3.2, class: 'fs-centromere' }));
          nodes.push(g);
        }
      }
      layer.replaceChildren(...nodes);
      const passed = mono ? 21 : 21 + f;
      count.textContent = fill(cfg.copy.count, { c: passed });
      const unit = `${f} ${cfg.copy.unit[f === 1 ? 0 : 1]}`;
      const text = f === 0
        ? cfg.copy.start
        : mono
          ? fill(cfg.copy.mono, { f: unit, n: f })
          : fill(f === cfg.max ? cfg.copy.holoMax : cfg.copy.holo, { f: unit, c: passed });
      readout.innerHTML = text;
      range.setAttribute('aria-valuetext', text.replace(/<[^>]+>/g, ''));
      range.style.setProperty('--fill', `${(f / cfg.max) * 100}%`);
    };

    const stop = () => { cancelAnimationFrame(frame); frame = 0; };
    const take = () => { stop(); touched = true; };

    // The autoplay: the slider itself runs from 0 to 39, so the reader sees
    // which control produced the change.
    const play = () => {
      stop();
      const t0 = performance.now();
      const run = (now: number) => {
        const k = Math.min(1, (now - t0 - 300) / 2600);
        const eased = k <= 0 ? 0 : 1 - Math.pow(1 - k, 2);
        range.value = String(Math.round(eased * cfg.max));
        render();
        frame = k < 1 ? requestAnimationFrame(run) : 0;
      };
      frame = requestAnimationFrame(run);
    };

    range.addEventListener('input', () => { take(); render(); });
    modes.forEach((input) => input.addEventListener('change', () => {
      take();
      figure.dataset.mode = input.value;
      render();
    }));
    replay.addEventListener('click', () => {
      touched = false;
      figure.dataset.mode = 'holo';
      modes.forEach((input) => { input.checked = input.value === 'holo'; });
      if (reduce.matches) { range.value = String(cfg.max); render(); return; }
      play();
    });

    panel.hidden = false;
    render();

    if (!reduce.matches && 'IntersectionObserver' in window) {
      let shown = false;
      new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (entry.intersectionRatio >= 0.6 && !shown) {
            shown = true;
            if (!touched) replay.click();
          } else if (!entry.isIntersecting) {
            shown = false;
          }
        }
      }, { threshold: [0, 0.6] }).observe(figure.querySelector('svg') ?? figure);
    }
  });
</script>

<style>
  .fission {
    margin: 0 0 var(--space-m);
    max-width: 30rem;
    padding: 0.85rem 0.85rem 0.75rem;
    background: var(--bg-inset);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
  }
  .fission > svg {
    display: block;
    user-select: none;
    width: 100%;
    height: auto;
    margin-bottom: 0.5rem;
  }
  /* Pieces are redrawn by the script, so these rules are global, scoped
     by the figure's own class instead. */
  .fission :global(.fs-bar) { fill: var(--accent); }
  /* Holocentric: a line of attachment points runs the length of every piece. */
  .fission :global(.fs-line) { fill: none; stroke: var(--bg-inset); stroke-width: 2; stroke-linecap: round; stroke-dasharray: 0.1 3.4; }
  /* One centromere: a single dot; pieces without it are lost. */
  .fission :global(.fs-centromere) { fill: var(--bg-inset); }
  .fission :global(.is-lost .fs-bar) { fill: none; stroke: var(--text-faint); stroke-width: 1; stroke-dasharray: 2 2.5; }
  .fs-count { font-family: var(--font-body); font-size: 14px; font-weight: 600; fill: var(--text-strong); }

  .fission-mode {
    display: grid;
    margin: 0.35rem 0 0.25rem;
    padding: 0;
    border: 0;
    min-width: 0;
  }
  .fission-mode legend { padding: 0; margin-bottom: 0.4rem; }
</style>
