---
import { pick, type Person } from '../data/initiative';
import type { Locale } from '../i18n';

interface Props {
  readonly person: Person;
  readonly locale: Locale;
  readonly tone?: 'leaf' | 'sky' | 'rose' | 'sun';
}

const { person, locale, tone = 'leaf' } = Astro.props;
const ties = pick(person.regionalTies, locale).split(' / ');
const regionalTiesLabel = locale === 'en' ? 'Regional ties' : 'Vínculos regionales';
const base = import.meta.env.BASE_URL;
---

<article class="person-card ink-card ink-card--flat" style={`--tone: var(--tone-person-${tone})`}>
  <figure class="person-media">
    <img
      class="person-photo"
      src={`${base}${person.photo.path}`}
      alt={pick(person.photo.alt, locale)}
      width={person.photo.width}
      height={person.photo.height}
      loading="lazy"
      decoding="async"
    />
  </figure>

  <div class="person-content">
    <strong class="person-name">{person.name}</strong>
    <p class="person-role">{pick(person.role, locale)}</p>
    <p class="person-bio">{pick(person.bio, locale)}</p>
  </div>

  <div class="person-foot">
    <div class="person-place">
      <p class="person-affil mono">{person.affiliation}</p>
      <p class="person-region">
        <span class="sr-only">{regionalTiesLabel}: </span>
        {ties.map((tie) => <span class="chip person-tie">{tie}</span>)}
      </p>
    </div>
    <a
      class="person-source mono"
      href={person.source.href}
      target="_blank"
      rel="noopener noreferrer external"
    >
      {pick(person.source.label, locale)} <span class="person-source-arrow" aria-hidden="true">↗</span>
    </a>
  </div>
</article>

<style>
  /* A portrait beside the text keeps eight leaders to a compact
     directory on the home page without hiding any biography. */
  .person-card {
    /* People are not data: an ink outline without the hard shadow. */
    border-width: 1.5px;
    display: grid;
    grid-template-columns: clamp(5.5rem, 8vw, 7.5rem) minmax(0, 1fr);
    grid-template-areas: 'media content' 'foot foot';
    /* Share row tracks with the neighbouring card so both footer rules
       line up across a row. */
    grid-row: span 2;
    grid-template-rows: subgrid;
    row-gap: 0;
    margin-bottom: var(--space-m);
    column-gap: var(--space-m);
    padding: var(--space-m);
  }
  .person-media { grid-area: media; }
  .person-content { grid-area: content; }
  /* Institution and profile link run under both columns, so the space
     below the portrait is used instead of left empty. */
  .person-foot {
    grid-area: foot;
    margin-top: var(--space-s);
    padding-top: var(--space-s);
    border-top: 1px solid var(--hairline);
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    align-content: flex-start;
    justify-content: space-between;
    gap: var(--space-xs) var(--space-m);
  }
  .person-place { display: grid; gap: 0.2rem; min-width: 0; }
  /* Portraits come from different sources (studio, field, lab). One crop
     anchored on the upper third and a light shared grade make them read
     as a single set without altering anyone's likeness. */
  .person-media {
    position: relative;
    align-self: start;
    margin: 0;
    overflow: hidden;
    background: var(--bg-inset);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-xs);
  }
  .person-photo {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 22%;
    filter: saturate(0.9) contrast(1.03);
  }
  .person-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: color-mix(in oklab, var(--accent) 14%, transparent);
    mix-blend-mode: soft-light;
    pointer-events: none;
  }
  .person-content {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 0;
  }
  .person-name {
    display: block;
    margin-bottom: 0.15rem;
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 560;
    color: var(--text-strong);
    letter-spacing: -0.008em;
    line-height: 1.2;
  }
  .person-role {
    margin: 0;
    font-size: var(--step-0);
    color: var(--text);
    line-height: 1.4;
  }
  .person-bio {
    margin: 0.15rem 0 0;
    font-size: var(--step--1);
    color: var(--text-muted);
    line-height: 1.55;
  }
  .person-affil {
    margin: 0;
    font-size: var(--step--1);
    color: var(--text);
    letter-spacing: 0.01em;
    line-height: 1.45;
  }
  .person-region {
    margin: 0.2rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .person-tie {
    font-size: var(--step--2);
    font-weight: 560;
    padding: 0.1rem 0.55rem;
    border-color: color-mix(in oklab, var(--tone) 70%, transparent);
    background: color-mix(in oklab, var(--tone) 16%, transparent);
    color: var(--text-strong);
    transition: background var(--transition), border-color var(--transition);
  }
  .person-source {
    color: var(--accent);
    font-size: var(--step--2);
    letter-spacing: 0.02em;
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, var(--accent) 35%, transparent);
    text-underline-offset: 0.18em;
  }
  .person-source-arrow { display: inline-block; transition: transform var(--dur-quick) var(--ease-glide); }
  /* The whole card opens the profile; the link stays the accessible name. */
  .person-card { position: relative; }
  .person-source::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .person-source:focus-visible { outline: none; }
  .person-card:has(.person-source:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  /* Hover: the card lifts onto a hard shadow in its own wing colour, the
     portrait drops its warm grade and comes forward, the arrow leaves. */
  .person-card {
    transition: transform var(--dur-quick) var(--ease-glide),
      box-shadow var(--dur-quick) var(--ease-glide),
      border-color var(--dur-quick) var(--ease-glide);
  }
  .person-photo { transition: transform var(--dur-base) var(--ease-glide), filter var(--dur-base) var(--ease-glide); }
  .person-media::after { transition: opacity var(--dur-base) var(--ease-glide); }
  .person-name { transition: color var(--dur-quick) var(--ease-glide); }
  @media (hover: hover) and (pointer: fine) {
    .person-card:hover {
      transform: translate(-3px, -3px);
      border-color: var(--tone);
      box-shadow: 6px 6px 0 var(--tone);
    }
    .person-card:hover .person-photo { transform: scale(1.05); filter: none; }
    .person-card:hover .person-media::after { opacity: 0; }
    .person-card:hover .person-tie { background: color-mix(in oklab, var(--tone) 34%, transparent); border-color: var(--tone); }
    .person-card:hover .person-source { color: var(--accent-strong); text-decoration-color: currentColor; }
    .person-card:hover .person-source-arrow { transform: translate(2px, -2px); }
    .person-card:active { transform: translate(1px, 1px); box-shadow: 2px 2px 0 var(--tone); }
  }
  /* On touch, the card passing the middle of the screen (Base.astro). */
  .person-card:global(.is-near) {
    transform: translate(-3px, -3px);
    border-color: var(--tone);
    box-shadow: 6px 6px 0 var(--tone);
  }
  .person-card:global(.is-near) .person-photo { transform: scale(1.05); filter: none; }
  .person-card:global(.is-near) .person-media::after { opacity: 0; }
  .person-card:global(.is-near) .person-tie { background: color-mix(in oklab, var(--tone) 34%, transparent); border-color: var(--tone); }
  @media (hover: none) {
    .person-card:active { transform: translate(1px, 1px); box-shadow: 2px 2px 0 var(--tone); }
  }
  @media (prefers-reduced-motion: reduce) {
    .person-card:hover, .person-card:active, .person-card:global(.is-near) { transform: none; }
    .person-card:hover .person-photo, .person-card:global(.is-near) .person-photo { transform: none; }
  }
</style>
