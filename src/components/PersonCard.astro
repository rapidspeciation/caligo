---
import { pick, type Person } from '../data/initiative';
import { italicizeSpecies } from '../data/content';
import { srcsetFor } from '../data/image-variants';
import type { Locale } from '../i18n';
import ArrowText from './ArrowText.astro';

interface Props {
  readonly person: Person;
  readonly locale: Locale;
}

const { person, locale } = Astro.props;
const ties = pick(person.regionalTies, locale).split(' / ');
const regionalTiesLabel = locale === 'en' ? 'Regional ties' : 'Vínculos regionales';
const bioLabel = locale === 'en' ? 'Read biography' : 'Leer biografía';
/* On a phone the row also holds institution, countries and profile link. */
const moreLabel = locale === 'en' ? 'More about' : 'Más sobre';
/* The external icon travels with the last word of the profile link. */
const sourceLabel = pick(person.source.label, locale);
const base = import.meta.env.BASE_URL;
---

<article class="person-card ink-card ink-card--flat" data-card="link">
  <figure class="person-media card-media">
    <img
      class="person-photo"
      src={`${base}${person.photo.path}`}
      srcset={srcsetFor(person.photo.path, person.photo.width, base)}
      sizes="7.5rem"
      alt={pick(person.photo.alt, locale)}
      width={person.photo.width}
      height={person.photo.height}
      loading="lazy"
      decoding="async"
    />
  </figure>

  <div class="person-content">
    <strong class="person-name">{person.name}</strong>
    <p class="person-role">{pick(person.role, locale)}</p>
  </div>

  <div class="person-foot">
    <div class="person-place person-wide">
      <p class="person-affil">{person.affiliation}</p>
      <p class="person-region">
        <span class="sr-only">{regionalTiesLabel}: </span>
        {ties.map((tie) => <span class="chip chip--sm person-tie">{tie}</span>)}
      </p>
    </div>
    <a
      class="person-source person-wide card-link"
      href={person.source.href}
      target="_blank"
      rel="noopener noreferrer external"
    >
      <ArrowText text={sourceLabel} icon="external" />
    </a>
    <!-- The biography waits behind its own row, so eight people fit in
         about one screen; each row names its person for screen readers.
         On a phone the row also holds institution, countries and profile
         link (a second copy, shown only there), so the card is portrait,
         name and focus. -->
    <details class="disclosure person-more">
      <summary class="disclosure-summary">
        <span class="disclosure-summary-inner">
          <span class="person-wide">{bioLabel}<span class="sr-only">: {person.name}</span></span>
          <span class="person-narrow">{moreLabel} {person.name}</span>
        </span>
      </summary>
      <div class="disclosure-body">
        <div class="person-narrow person-narrow-place">
          <div class="person-place">
            <p class="person-affil">{person.affiliation}</p>
            <p class="person-region">
              <span class="sr-only">{regionalTiesLabel}: </span>
              {ties.map((tie) => <span class="chip chip--sm person-tie">{tie}</span>)}
            </p>
          </div>
          <a
            class="person-source"
            href={person.source.href}
            target="_blank"
            rel="noopener noreferrer external"
          >
            <ArrowText text={sourceLabel} icon="external" />
          </a>
        </div>
        <p class="person-bio" set:html={italicizeSpecies(pick(person.bio, locale))} />
      </div>
    </details>
  </div>
</article>

<style>
  /* A portrait large enough to read the face, beside name and focus, then institution, countries,
     profile link and the biography row across the card. Eight leaders
     make a compact directory; each biography opens on request. */
  .person-card {
    /* People are not data: an ink outline without the hard shadow. */
    border-width: 1.5px;
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    grid-template-areas: 'media content' 'foot foot';
    /* Share row tracks with the neighbouring cards so the footer rules
       line up across a row. */
    grid-row: span 2;
    grid-template-rows: subgrid;
    row-gap: 0;
    margin-bottom: var(--space-m);
    column-gap: var(--space-s);
    padding: var(--space-m);
  }
  .person-media { grid-area: media; }
  .person-content { grid-area: content; }
  /* Institution and profile link run under both columns, so the space
     below the portrait is used instead of left empty. */
  .person-foot {
    grid-area: foot;
    margin-top: var(--space-s);
    padding-top: var(--space-s);
    border-top: 1px solid var(--hairline);
    /* Institution, regional ties, then the profile link on a line of its
       own, so the link reads as one phrase instead of wrapping in a corner. */
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    /* The biography row sits at the foot, level across a row of cards. */
    grid-template-rows: auto auto 1fr;
    gap: var(--space-xs);
  }
  .person-place { display: grid; gap: 0.2rem; min-width: 0; }
  /* Portraits come from different sources (studio, field, lab). One crop
     anchored on the upper third and a light shared grade make them read
     as a single set without altering anyone's likeness. */
  .person-media {
    position: relative;
    align-self: start;
    margin: 0;
    overflow: hidden;
    background: var(--bg-inset);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-xs);
  }
  .person-photo {
    display: block;
    width: 100%;
    /* Square: the face keeps the frame's full width while the card stays
       short enough for eight people in about one screen. */
    aspect-ratio: 1;
    object-fit: cover;
    object-position: 50% 22%;
    filter: saturate(0.9) contrast(1.03);
  }
  .person-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: color-mix(in oklab, var(--accent) 14%, transparent);
    mix-blend-mode: soft-light;
    pointer-events: none;
  }
  .person-content {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 0;
  }
  .person-name {
    display: block;
    margin-bottom: 0.15rem;
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 560;
    color: var(--text-strong);
    letter-spacing: -0.008em;
    line-height: 1.2;
  }
  .person-role {
    margin: 0;
    font-size: var(--step-0);
    color: var(--text);
    line-height: 1.4;
  }
  .person-bio {
    margin: 0;
    font-size: var(--step--1);
    color: var(--text-muted);
    line-height: 1.55;
  }
  /* The biography row closes the card, like the background row on a pilot
     project: a plain row, not a box. */
  .person-more { --disclosure-pad-x: 0; align-self: end; margin-top: calc(-1 * var(--space-2xs)); }
  .person-more > .disclosure-summary {
    padding-block: 0.75rem;
    padding-right: 0.3rem;
    font-size: var(--step--1);
    font-weight: 560;
  }
  .person-more:not([open]) > .disclosure-summary { border-bottom-color: transparent; padding-bottom: 0; }
  .person-more > .disclosure-body { padding-block: var(--space-xs) 0; }
  .person-affil {
    margin: 0;
    font-size: var(--step--1);
    font-weight: 560;
    color: var(--text);
    line-height: 1.4;
  }
  .person-region {
    margin: 0.2rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .person-tie {
    border-color: color-mix(in oklab, var(--card-tone) 70%, transparent);
    background: color-mix(in oklab, var(--card-tone) 16%, transparent);
    color: var(--text-strong);
    transition: background var(--transition), border-color var(--transition);
  }
  .person-source {
    justify-self: start;
    color: var(--link);
    font-size: var(--step--1);
    font-weight: 560;
    line-height: 1.4;
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, var(--link) 40%, transparent);
    text-underline-offset: 0.18em;
  }
  /* On the dark card the brighter rust (8:1) keeps the link legible. */
  :global([data-mode='dark']) .person-source { color: var(--accent-strong); }
  /* The site's external icon, after the label, at text size. */
  .person-source :global(svg) { width: 1em; height: 1em; }
  /* Raised (see global.css, "Card behaviour"): the portrait drops its warm
     grade, the country chips fill in and the arrow leaves. */
  .person-photo { transition: transform var(--dur-base) var(--ease-glide), filter var(--dur-base) var(--ease-glide); }
  .person-media::after { transition: opacity var(--dur-base) var(--ease-glide); }
  .person-card:global(.is-near) .person-photo { filter: none; }
  .person-card:global(.is-near) .person-media::after { opacity: 0; }
  .person-card:global(.is-near) .person-tie { background: color-mix(in oklab, var(--card-tone) 34%, transparent); border-color: var(--card-tone); }
  @media (hover: hover) and (pointer: fine) {
    .person-card:hover .person-photo { filter: none; }
    .person-card:hover .person-media::after { opacity: 0; }
    .person-card:hover .person-tie { background: color-mix(in oklab, var(--card-tone) 34%, transparent); border-color: var(--card-tone); }
    .person-card:hover .person-source { color: var(--link-hover); text-decoration-color: currentColor; }
    .person-card:hover .person-source :global(svg) { transform: translate(2px, -2px); }
  }

  /* Four to a row: a little less padding and a smaller focus line, so the
     text beside the portrait keeps a readable width. */
  @media (min-width: 72rem) {
    .person-card { padding: var(--space-s); column-gap: 0.8rem; }
    .person-name { font-size: var(--step-0); }
    .person-role { font-size: var(--step--1); line-height: 1.45; }
  }
  /* Wide screens show institution, countries and profile link on the
     card; a phone keeps them in the row below (see markup). */
  .person-narrow { display: none; }
  @media (max-width: 30rem) {
    .person-card { grid-template-columns: 4.75rem minmax(0, 1fr); padding: var(--space-s); }
    .person-wide { display: none; }
    .person-narrow { display: inline; }
    .person-narrow-place {
      display: grid;
      gap: var(--space-xs);
      margin-bottom: var(--space-s);
      padding-bottom: var(--space-s);
      border-bottom: 1px solid var(--hairline);
    }
    .person-foot { grid-template-rows: auto; gap: 0; margin-top: var(--space-xs); padding-top: 0; }
    .person-more { margin-top: 0; }
  }
</style>
