---
import { getDict, localePath, type Locale } from '../i18n';
import Icon from './Icon.astro';
import { navItems } from '../config/nav';
import { LINKS } from '../data/content';

interface Props {
  locale: Locale;
  /** Current page path; the join button is left out where the page itself
      ends with a join block. */
  page?: string;
}
const { locale, page } = Astro.props;
/* Participate is the join page, and Home closes on "Súmate" with the form. */
const PAGES_ENDING_WITH_JOIN = ['/participate', '/'];
const showJoin = !PAGES_ENDING_WITH_JOIN.includes(page ?? '');
/* Home's "Súmate" section already shows the address just above the footer. */
const showEmail = page !== '/';
const t = getDict(locale);
const base = import.meta.env.BASE_URL;

---

<footer class="site-footer">
  <div class="container-wide footer-grid">
    <div class="footer-brand">
      <img
        class="footer-emblem"
        src={`${base}media/brand/caligo-emblem-transparent.webp`}
        alt=""
        aria-hidden="true"
        width="163"
        height="131"
        loading="lazy"
        decoding="async"
      />
      <div class="footer-brand-text">
        <span class="footer-name">Caligo</span>
        <p class="footer-tagline">{t.footer.tagline}</p>
      </div>
    </div>

    {showJoin && (
      <a class="btn btn--primary footer-join" href={`${localePath(locale, '/participate')}#join`}>
        {t.join.ctaSecondary}<Icon name="arrow-right" />
      </a>
    )}
  </div>

  <div class="container-wide footer-base">
    {/* One quiet row: every page, and the network's address, so a reader
        at the bottom of a long page can go on without scrolling back up.
        Home leaves the address out: its "Súmate" section shows it. */}
    <div class="footer-links">
      <ul class="footer-pages" role="list">
        {navItems(t).map((item) => (
          <li><a href={localePath(locale, item.path)} aria-current={item.path === page ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
      {showEmail && (
        <a class="footer-email" href={`mailto:${LINKS.contactEmail}`}><Icon name="mail" />{LINKS.contactEmail}</a>
      )}
    </div>
    <p class="muted">© {new Date().getFullYear()} {t.footer.rights}</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--hairline);
    background: var(--bg-raised);
    padding-block: var(--space-m);
  }

  .footer-grid {
    display: grid;
    gap: var(--space-m);
    align-items: center;
    grid-template-columns: 1fr;
  }

  /*
    Footer brand — horizontal lockup: the transparent emblem sits at the
    left, while the name and tagline stack beside it. aria-hidden on the
    emblem keeps screen readers from double-announcing "Caligo".
  */
  .footer-brand {
    display: flex;
    align-items: center;
    gap: var(--space-m);
    flex-wrap: wrap;
  }
  .footer-emblem {
    display: block;
    width: clamp(72px, 8vw, 96px);
    height: auto;
    padding: 0.35rem;
    border-radius: var(--radius-lg);
    object-fit: contain;
    flex: 0 0 auto;
  }
  /* Dark mode: the ivory badge from the header, with the same hairline. */
  :global(html[data-mode='dark']) .footer-emblem {
    background: var(--c-warm-050);
    border: 1px solid var(--hairline);
  }
  .footer-brand-text {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
    flex: 1 1 12rem;
  }
  .footer-name {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 560;
    letter-spacing: -0.02em;
    color: var(--link);
    line-height: 1.1;
  }
  .footer-tagline {
    margin: 0;
    color: var(--text);
    max-width: 42ch;
    line-height: 1.4;
  }

  .footer-join { justify-self: start; }

  .footer-base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-xs);
    margin-top: var(--space-m);
    padding-top: var(--space-m);
    border-top: 1px solid var(--hairline);
    font-size: var(--step--1);
  }
  .footer-base p {
    max-width: 62ch;
  }
  .footer-links {
    flex: 1 1 100%;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xs) var(--space-m);
  }
  .footer-pages {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem var(--space-m);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* Phones: the page links in an even three-column grid instead of a
     ragged wrap with orphans on the second line. */
  @media (max-width: 48rem) {
    .footer-pages {
      display: grid;
      grid-template-columns: repeat(3, auto);
      justify-content: start;
      gap: 0.5rem 1.25rem;
    }
  }
  .footer-links a {
    color: var(--text);
    text-decoration: none;
  }
  .footer-links a:hover { color: var(--link); text-decoration: underline; text-underline-offset: 0.2em; }
  .footer-links a[aria-current='page'] { color: var(--link); }
  .footer-email { display: inline-flex; align-items: center; gap: 0.4em; }
  .footer-email :global(svg) { flex: none; width: 1em; height: 1em; }
  @media (pointer: coarse) {
    .footer-links a { display: inline-flex; align-items: center; min-height: 44px; }
  }

  @media (min-width: 46rem) {
    .footer-grid {
      grid-template-columns: 1fr auto;
    }
  }
</style>
