---
import { EVENTS, pick, italicizeSpecies } from '../data/initiative';
import { localePath, type Locale } from '../i18n';
import { PILOT_INTRO, PILOT_DEADLINE } from '../data/pilot-call';
import Icon from './Icon.astro';
import DeadlineChip from './DeadlineChip.astro';
import WhenChip from './WhenChip.astro';

interface Props {
  readonly locale: Locale;
  readonly compact?: boolean;
}

const { locale, compact = false } = Astro.props;
const funding = PILOT_INTRO[locale];

// One chronological list: the funding call sits between the workshop that
// came before it and the hackathon after it. Each card says how long ago
// or how soon, in the visitor's own calendar.
type Entry =
  | { kind: 'call'; sort: string }
  | { kind: 'event'; sort: string; event: (typeof EVENTS)[number] };
const entries: Entry[] = [
  { kind: 'call' as const, sort: PILOT_DEADLINE },
  ...EVENTS.map((event) => ({ kind: 'event' as const, sort: event.start, event })),
].sort((a, b) => a.sort.localeCompare(b.sort));
const todayLabel = locale === 'es' ? 'Hoy' : 'Today';
/* Every card leads somewhere, so the whole card is the link. */
const eventLinks: Record<string, { href: string; label: string; external?: boolean; tone: string }> = {
  'bogota-2026': {
    href: `${localePath(locale, '/projects')}#heliconius`,
    label: locale === 'es' ? 'Proyecto piloto de Heliconius' : 'The Heliconius pilot project',
    tone: 'leaf',
  },
  'campinas-2027': {
    href: 'https://www.even3.com.br/bob-elen-2027/',
    label: locale === 'es' ? 'Sitio del congreso' : 'Congress website',
    external: true,
    tone: 'sky',
  },
};
---

<ol class:list={['timeline-list', { 'timeline-list--compact': compact }]} role="list" data-timeline data-locale={locale}>
  {entries.map((entry) => entry.kind === 'call' ? (
    <li class="timeline-item ink-card" id="event-colombia-funding" data-end={PILOT_DEADLINE} style="--tone: var(--tone-person-rose)">
      <div class="timeline-when">
        <DeadlineChip locale={locale} class="timeline-chip" />
        <time class="timeline-dates mono" datetime={PILOT_DEADLINE}>{funding.date}</time>
      </div>
      <h3 class="timeline-name">{funding.call}</h3>
      <p class="timeline-location mono">Colombia</p>
      <p class="timeline-summary">{funding.description}</p>
      <a class="text-link timeline-link" href={localePath(locale, '/funding')}>{funding.funding}<Icon name="arrow-right" /></a>
    </li>
  ) : (
    <li class="timeline-item ink-card" id={`event-${entry.event.id}`} data-end={entry.event.end ?? entry.event.start} style={`--tone: var(--tone-person-${eventLinks[entry.event.id]?.tone ?? 'leaf'})`}>
      <div class="timeline-when">
        <WhenChip locale={locale} start={entry.event.start} end={entry.event.end} class="timeline-chip" />
        <time class="timeline-dates mono" datetime={entry.event.start}>{pick(entry.event.dates, locale)}</time>
      </div>
      <h3 class="timeline-name">{pick(entry.event.name, locale)}</h3>
      <p class="timeline-location mono">{pick(entry.event.location, locale)}</p>
      <p class="timeline-summary" set:html={italicizeSpecies(pick(entry.event.summary, locale))} />
      {eventLinks[entry.event.id] && (
        <a
          class="text-link timeline-link"
          href={eventLinks[entry.event.id].href}
          target={eventLinks[entry.event.id].external ? '_blank' : undefined}
          rel={eventLinks[entry.event.id].external ? 'noopener noreferrer external' : undefined}
        >
          <span set:html={italicizeSpecies(eventLinks[entry.event.id].label)} />
          <Icon name={eventLinks[entry.event.id].external ? 'external' : 'arrow-right'} />
        </a>
      )}
    </li>
  ))}
  <li class="timeline-today" data-timeline-today aria-hidden="true" hidden>
    <span class="timeline-today-label chip chip--sun">{todayLabel} <span data-today-date></span></span>
  </li>
</ol>

<script is:inline>
  /* Places a "Today" pin between past and upcoming entries, in the
     visitor's own calendar. Without JavaScript the pin stays hidden and
     every node reads as a plain point on the track. */
  (function () {
    function place() {
      document.querySelectorAll('[data-timeline]').forEach(function (list) {
        var now = new Date();
        var today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
        var items = list.querySelectorAll('.timeline-item');
        var past = 0;
        items.forEach(function (item, i) {
          var p = item.getAttribute('data-end').split('-');
          var done = new Date(+p[0], +p[1] - 1, +p[2]) < today;
          item.setAttribute('data-when', done ? 'past' : 'upcoming');
          item.style.order = String(i * 2);
          if (done) past++;
        });
        var pin = list.querySelector('[data-timeline-today]');
        if (!pin) return;
        list.style.setProperty('--past', String(past));
        list.style.setProperty('--count', String(items.length));
        pin.style.order = String(past * 2 - 1);
        pin.querySelector('[data-today-date]').textContent =
          new Intl.DateTimeFormat(list.getAttribute('data-locale'), { day: 'numeric', month: 'short' }).format(today);
        pin.hidden = false;
      });
    }
    if (!window.__caligoTimeline) {
      window.__caligoTimeline = true;
      document.addEventListener('astro:page-load', place);
    }
    place();
  })();
</script>

<style>
  .timeline-list {
    list-style: none;
    /* margin-top intentionally not reset — the page owns vertical rhythm
       via `.section > .container-wide > * + *` in global.css. */
    margin-block-end: 0;
    margin-inline: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  .timeline-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    padding: 1.1rem 1.2rem 1.25rem;
  }
  .timeline-when {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.7rem;
    margin-bottom: 0.35rem;
  }
  .timeline-dates {
    font-size: var(--step--2);
    color: var(--text-muted);
    letter-spacing: 0.02em;
  }
  .timeline-name {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--step-0);
    font-weight: 650;
    color: var(--text-strong);
    letter-spacing: -0.006em;
    line-height: 1.3;
    text-wrap: balance;
  }
  .timeline-location {
    margin: 0;
    font-size: var(--step--2);
    color: var(--text-faint);
    letter-spacing: 0.04em;
  }
  .timeline-summary {
    margin: 0.3rem 0 0;
    font-size: var(--step--1);
    color: var(--text);
    line-height: 1.55;
    max-width: var(--measure);
  }
  .timeline-link { margin-top: auto; padding-top: 0.5rem; font-size: var(--step--1); }

  /* The whole card is the link. On hover it lifts onto a hard shadow in its
     own colour and its node on the track lights up to match. */
  .timeline-item { position: relative; }
  .timeline-link::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .timeline-link:focus-visible { outline: none; }
  .timeline-item:has(.timeline-link:focus-visible) { outline: 2px solid var(--accent); outline-offset: 3px; }
  .timeline-item {
    transition: transform var(--dur-quick) var(--ease-glide),
      box-shadow var(--dur-quick) var(--ease-glide),
      border-color var(--dur-quick) var(--ease-glide);
  }
  .timeline-item::before { transition: transform var(--dur-quick) var(--ease-settle), background var(--dur-quick), border-color var(--dur-quick); }
  @media (hover: hover) and (pointer: fine) {
    .timeline-item:hover {
      transform: translate(-3px, -3px);
      border-color: var(--tone);
      box-shadow: 7px 7px 0 var(--tone);
    }
    .timeline-list--compact .timeline-item:hover::before,
    .timeline-list--compact .timeline-item[data-when]:hover::before {
      transform: translate(3px, 3px) scale(1.5);
      background: var(--tone);
      border-color: var(--tone);
    }
    /* Keep the track line still while the card lifts. */
    .timeline-list--compact .timeline-item:hover::after { transform: translate(3px, 3px); }
    .timeline-item:hover .timeline-name { color: var(--accent-strong); }
    .timeline-item:active { transform: translate(1px, 1px); box-shadow: 2px 2px 0 var(--tone); }
    .timeline-list--compact .timeline-item:active::before,
    .timeline-list--compact .timeline-item:active::after { transform: translate(-1px, -1px); }
  }
  /* On touch, the card passing the middle of the screen (Base.astro). */
  .timeline-item:global(.is-near) {
    transform: translate(-3px, -3px);
    border-color: var(--tone);
    box-shadow: 7px 7px 0 var(--tone);
  }
  .timeline-item:global(.is-near) .timeline-name { color: var(--accent-strong); }
  @media (hover: none) {
    .timeline-item:active { transform: translate(1px, 1px); box-shadow: 2px 2px 0 var(--tone); }
  }
  @media (prefers-reduced-motion: reduce) {
    .timeline-item:global(.is-near) { transform: none; }
    .timeline-item:hover, .timeline-item:active,
    .timeline-list--compact .timeline-item:hover::before,
    .timeline-list--compact .timeline-item:hover::after { transform: none; }
  }
  /* ---- Track: one line through the entries in date order ----
     Past entries sit on a solid line with filled nodes; upcoming ones on a
     dashed line with open nodes. The Today pin falls in the gap between. */
  .timeline-today[hidden] { display: none; }
  .timeline-today-label { font-size: var(--step--2); }
  .timeline-list--compact {
    --gap: 1rem;
    --track-y: 2.6rem;
    position: relative;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--gap);
    padding-top: calc(var(--track-y) + 1.2rem);
  }
  .timeline-list--compact .timeline-item { position: relative; }
  .timeline-list--compact .timeline-item::before {
    content: '';
    position: absolute;
    z-index: 1;
    top: calc(-1.2rem - 7px);
    left: 1.2rem;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 2px solid var(--ink-line);
    background: var(--ink-line);
    box-sizing: border-box;
  }
  .timeline-list--compact .timeline-item::after {
    content: '';
    position: absolute;
    top: calc(-1.2rem - 1px);
    left: -2px;
    width: calc(100% + var(--gap) + 4px);
    border-top: 2px solid var(--ink-line);
  }
  .timeline-list--compact .timeline-item:nth-last-child(2)::after { width: calc(100% + 4px); }
  .timeline-list--compact .timeline-item[data-when='upcoming']::before { background: var(--bg-raised); }
  .timeline-list--compact .timeline-item[data-when='upcoming']::after {
    border-top-style: dashed;
    border-top-color: color-mix(in oklab, var(--ink-line) 55%, transparent);
  }
  /* Wide: the pin stands in the gap before the first upcoming entry. */
  .timeline-list--compact .timeline-today {
    position: absolute;
    z-index: 2;
    top: 0;
    bottom: 0;
    left: calc(var(--past) * (100% + var(--gap)) / var(--count) - var(--gap) / 2);
    width: 0;
    display: flex;
    justify-content: center;
    pointer-events: none;
  }
  .timeline-list--compact .timeline-today::after {
    content: '';
    position: absolute;
    top: 1.5rem;
    bottom: 0;
    left: -1px;
    border-left: 2px solid var(--tone-sun);
  }
  .timeline-list--compact .timeline-today-label { position: absolute; top: 0; z-index: 1; }
  @media (max-width: 64rem) {
    /* Stacked: no track; the pin becomes a labelled rule between entries. */
    .timeline-list--compact { display: flex; flex-direction: column; padding-top: 0; }
    .timeline-list--compact .timeline-item::before,
    .timeline-list--compact .timeline-item::after { content: none; }
    .timeline-list--compact .timeline-today {
      position: static;
      width: auto;
      justify-content: flex-start;
      align-items: center;
      gap: 0.6rem;
    }
    .timeline-list--compact .timeline-today::after {
      position: static;
      flex: 1;
      border-left: 0;
      border-top: 2px solid var(--tone-sun);
    }
    .timeline-list--compact .timeline-today-label { position: static; }
  }
</style>
