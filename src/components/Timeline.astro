---
import { EVENTS, pick, italicizeSpecies } from '../data/initiative';
import { localePath, type Locale } from '../i18n';
import { PILOT_INTRO, PILOT_DEADLINE } from '../data/pilot-call';
import Icon from './Icon.astro';
import DeadlineChip from './DeadlineChip.astro';
import WhenChip from './WhenChip.astro';

interface Props {
  readonly locale: Locale;
  readonly compact?: boolean;
}

const { locale, compact = false } = Astro.props;
const funding = PILOT_INTRO[locale];

// One chronological list: the funding call sits between the workshop that
// came before it and the hackathon after it. Each card says how long ago
// or how soon, in the visitor's own calendar.
type Entry =
  | { kind: 'call'; sort: string }
  | { kind: 'event'; sort: string; event: (typeof EVENTS)[number] };
const entries: Entry[] = [
  { kind: 'call' as const, sort: PILOT_DEADLINE },
  ...EVENTS.map((event) => ({ kind: 'event' as const, sort: event.start, event })),
].sort((a, b) => a.sort.localeCompare(b.sort));
---

<ol class:list={['timeline-list', { 'timeline-list--compact': compact }]} role="list">
  {entries.map((entry) => entry.kind === 'call' ? (
    <li class="timeline-item ink-card" id="event-colombia-funding">
      <div class="timeline-when">
        <DeadlineChip locale={locale} class="timeline-chip" />
        <time class="timeline-dates mono" datetime={PILOT_DEADLINE}>{funding.date}</time>
      </div>
      <h3 class="timeline-name">{funding.call}</h3>
      <p class="timeline-location mono">Colombia</p>
      <p class="timeline-summary">{funding.description}</p>
      <a class="text-link timeline-link" href={localePath(locale, '/funding')}>{funding.funding}<Icon name="arrow-right" /></a>
    </li>
  ) : (
    <li class="timeline-item ink-card" id={`event-${entry.event.id}`}>
      <div class="timeline-when">
        <WhenChip locale={locale} start={entry.event.start} end={entry.event.end} class="timeline-chip" />
        <time class="timeline-dates mono" datetime={entry.event.start}>{pick(entry.event.dates, locale)}</time>
      </div>
      <h3 class="timeline-name">{pick(entry.event.name, locale)}</h3>
      <p class="timeline-location mono">{pick(entry.event.location, locale)}</p>
      <p class="timeline-summary" set:html={italicizeSpecies(pick(entry.event.summary, locale))} />
    </li>
  ))}
</ol>

<style>
  .timeline-list {
    list-style: none;
    /* margin-top intentionally not reset — the page owns vertical rhythm
       via `.section > .container-wide > * + *` in global.css. */
    margin-block-end: 0;
    margin-inline: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  .timeline-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    padding: 1.1rem 1.2rem 1.25rem;
  }
  .timeline-when {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.7rem;
    margin-bottom: 0.35rem;
  }
  .timeline-dates {
    font-size: var(--step--2);
    color: var(--text-muted);
    letter-spacing: 0.02em;
  }
  .timeline-name {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--step-0);
    font-weight: 650;
    color: var(--text-strong);
    letter-spacing: -0.006em;
    line-height: 1.3;
    text-wrap: balance;
  }
  .timeline-location {
    margin: 0;
    font-size: var(--step--2);
    color: var(--text-faint);
    letter-spacing: 0.04em;
  }
  .timeline-summary {
    margin: 0.3rem 0 0;
    font-size: var(--step--1);
    color: var(--text);
    line-height: 1.55;
    max-width: var(--measure);
  }
  .timeline-link { margin-top: auto; padding-top: 0.5rem; font-size: var(--step--1); }
  .timeline-list--compact {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  @media (max-width: 64rem) {
    .timeline-list--compact {
      grid-template-columns: 1fr;
    }
  }
</style>
