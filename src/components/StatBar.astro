---
import CardIcon, { type CardIconName } from './CardIcon.astro';
import { italicizeSpecies } from '../data/content';

type MetricKind = 'participants' | 'facilities' | 'countries' | 'pilots';

interface Metric {
  readonly value: number | string;
  readonly label: string;
  readonly asOf?: string;
  /** One short factual line under the number. */
  readonly note?: string;
  readonly kind?: MetricKind;
  readonly href?: string;
}

interface Props {
  readonly metrics: readonly Metric[];
  readonly variant?: 'bar' | 'community-cards';
}

const { metrics, variant = 'bar' } = Astro.props;
const icons: Record<MetricKind, CardIconName> = { participants: 'people', facilities: 'facility', countries: 'globe', pilots: 'project' };
// Members stay on cream so the highlighter can carry them; the other
// three take the site-wide tone for their kind of thing.
const tones: Record<MetricKind, string | undefined> = { participants: undefined, facilities: 'ink-card--leaf', countries: 'ink-card--sky', pilots: 'ink-card--rose' };
---

{metrics.length >= 2 && variant === 'community-cards' && (
  <ul class="metric-cards" role="list">
    {metrics.map((metric) => (
      <li class="metric-card">
        <a class:list={['metric-card__link', 'ink-card', metric.kind && tones[metric.kind]]} href={metric.href}>
          <span class="metric-card__label">{metric.label}</span>
          {metric.kind && <CardIcon name={icons[metric.kind]} class="metric-icon" />}
          <strong class="metric-card__value">
            {metric.kind === 'participants' ? <span class="marker">{metric.value}</span> : metric.value}
          </strong>
          {(metric.note ?? metric.asOf) && <span class="metric-card__note" set:html={italicizeSpecies(metric.note ?? metric.asOf ?? '')} />}
        </a>
      </li>
    ))}
  </ul>
)}

{metrics.length >= 2 && variant === 'bar' && (
  <ul class="stat-bar" role="list">
    {metrics.map((metric) => (
      <li class="stat-item">
        <span class="stat-value">{metric.value}</span>
        <span class="stat-label mono">{metric.label}</span>
        {metric.asOf && <span class="stat-asof mono">{metric.asOf}</span>}
      </li>
    ))}
  </ul>
)}

<style>
  .metric-cards {
    display: grid;
    grid-template-columns: 1.3fr repeat(3, minmax(0, 1fr));
    gap: .7rem 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  /* Label, number and note sit on shared rows, so a label that wraps to
     two lines never knocks its number out of line with the others. */
  .metric-card { min-width: 0; list-style: none; display: grid; grid-row: span 3; grid-template-rows: subgrid; }
  .metric-card__link {
    display: grid;
    grid-row: span 3;
    grid-template-rows: subgrid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas: 'label icon' 'value value' 'note note';
    align-content: start;
    column-gap: .75rem;
    min-width: 0;
    padding: 1rem 1.15rem 1.1rem;
    color: var(--text);
  }
  .metric-card__label {
    grid-area: label;
    align-self: start;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: 500;
    letter-spacing: .08em;
    line-height: 1.35;
    text-transform: uppercase;
    color: var(--text-strong);
  }
  .metric-card :global(.metric-icon) { grid-area: icon; align-self: start; width: 1.6rem; height: 1.6rem; }
  .metric-card__value {
    grid-area: value;
    justify-self: start;
    align-self: end;
    color: var(--text-strong);
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 3.6vw, 3.4rem);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    letter-spacing: -.045em;
    line-height: 1;
  }
  .metric-card__note {
    grid-area: note;
    max-width: 30ch;
    color: var(--text-muted);
    font-size: .84rem;
    line-height: 1.45;
  }
  .metric-card__link:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }

  .stat-bar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-m) var(--space-l);
    list-style: none;
    margin: 0;
    padding: var(--space-m);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    background: var(--bg-panel);
  }
  .stat-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }
  .stat-value {
    color: var(--text-strong);
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 560;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.018em;
    line-height: 1;
  }
  .stat-label {
    color: var(--text-faint);
    font-size: var(--step--2);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .stat-asof {
    color: var(--text-faint);
    font-size: var(--step--2);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
  }


  @media (max-width: 70rem) {
    .metric-cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 36rem) {
    .metric-cards { gap: .6rem .75rem; }
    .metric-card__link { padding: .85rem .9rem .95rem; }
    .metric-card :global(.metric-icon) { display: none; }
    .metric-card__label { grid-column: 1 / -1; font-size: .68rem; letter-spacing: .06em; }
    .metric-card__value { font-size: 2.3rem; }
    .metric-card__note { font-size: .78rem; }
  }
</style>
