---
import { getDict, switchLocalePath, LOCALES, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getDict(locale);

const SHORT: Record<Locale, string> = { en: 'EN', es: 'ES' };
const FULL: Record<Locale, string> = { en: 'English', es: 'Español' };
---

<div class="lang" role="group" aria-label={t.common.chooseLanguage}>
  {
    LOCALES.map((code) =>
      code === locale ? (
        <span class="lang-item is-active" aria-current="true" lang={code}>
          <span aria-hidden="true">{SHORT[code]}</span>
          <span class="sr-only">{FULL[code]}</span>
        </span>
      ) : (
        <a
          class="lang-item"
          href={switchLocalePath(Astro.url.pathname, code)}
          lang={code}
          hreflang={code}
          data-lang-choice={code}
        >
          <span aria-hidden="true">{SHORT[code]}</span>
          <span class="sr-only">{FULL[code]}</span>
        </a>
      )
    )
  }
</div>

<style>
  .lang {
    display: inline-flex;
    align-items: center;
    padding: 2px;
    border: 1px solid var(--surface-border);
    border-radius: var(--radius);
    background: color-mix(in oklab, var(--bg-panel) 55%, transparent);
  }
  .lang-item {
    display: inline-grid;
    place-items: center;
    min-width: 2rem;
    height: 1.9rem;
    padding-inline: 0.5rem;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    color: var(--text-muted);
    text-decoration: none;
    border-radius: calc(var(--radius) - 3px);
    transition: color var(--transition), background var(--transition);
  }
  .lang-item:hover {
    color: var(--text-strong);
  }
  .lang-item.is-active {
    color: var(--accent-contrast);
    background: var(--accent);
    /* The pill slides across when the language changes. */
    view-transition-name: lang-current;
  }
  .lang-item:active { transform: translateY(1px); }
  @media (pointer: coarse) {
    .lang-item { min-width: 2.5rem; height: 2.4rem; }
  }
</style>

<script>
  // Fetch the other-language page in the background once this page has
  // fully loaded and the browser is idle, so the EN/ES switch is instant
  // without taking bandwidth from the page's own photo and fonts. A plain
  // <link rel="prefetch">: Astro's own prefetch module adds two script files
  // to every page and, measured, delayed the first paint by about 45 ms.
  const done = new Set<string>();
  function prefetch(href: string) {
    if (done.has(href)) return;
    done.add(href);
    const link = document.createElement('link');
    link.rel = 'prefetch';
    link.href = href;
    document.head.appendChild(link);
  }
  function prefetchOtherLanguage() {
    const run = () => {
      document.querySelectorAll<HTMLAnchorElement>('a[data-lang-choice]').forEach((a) => prefetch(a.href));
    };
    const idle = () => ('requestIdleCallback' in window ? requestIdleCallback(run, { timeout: 3000 }) : setTimeout(run, 500));
    if (document.readyState === 'complete') idle();
    else window.addEventListener('load', idle, { once: true });
  }
  document.addEventListener('astro:page-load', prefetchOtherLanguage);

  // Remember an explicit EN/ES choice, so the bare domain opens that
  // language next time (src/pages/index.astro reads 'caligo-lang').
  document.addEventListener('click', (event) => {
    const link = (event.target as Element | null)?.closest?.('[data-lang-choice]');
    if (!link) return;
    try { localStorage.setItem('caligo-lang', link.getAttribute('data-lang-choice') ?? ''); } catch { /* storage unavailable */ }
  });
</script>
