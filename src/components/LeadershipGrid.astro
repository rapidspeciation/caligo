---
import type { Locale } from '../i18n';
import { LEADERS } from '../data/initiative';
import PersonCard from './PersonCard.astro';

interface Props {
  readonly locale: Locale;
}

const { locale } = Astro.props;
/* One wing colour per card, so hovering lights each person differently. */
const TONES = ['leaf', 'sky', 'rose', 'sun'] as const;
---

<div class="leadership-grid">
  {LEADERS.map((person, i) => (
    <PersonCard person={person} locale={locale} tone={TONES[i % TONES.length]} />
  ))}
</div>

<style>
  .leadership-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 var(--space-m);
    margin-top: var(--space-m);
  }
  @media (max-width: 52rem) {
    .leadership-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
