---
/**
 * Live countdown for the funding call. The server renders the static
 * "open until" text; the shared `caligoDeadlines()` script in Base.astro
 * swaps it for a day count in the visitor's local date, or for how long
 * ago the call closed ("Closed 9 days ago").
 */
import Icon from './Icon.astro';
import { PILOT_DEADLINE, PILOT_INTRO, isCallClosed } from '../data/pilot-call';
import type { Locale } from '../i18n';

interface Props {
  readonly locale: Locale;
  readonly class?: string;
  /** A call other than the current one (a closed call on the timeline). */
  readonly deadline?: string;
}
const { locale, class: className, deadline = PILOT_DEADLINE } = Astro.props;
const chip = PILOT_INTRO[locale].chip;
const closed = deadline === PILOT_DEADLINE ? isCallClosed() : true;
---

<span
  class:list={['chip', 'deadline-chip', className]}
  data-deadline={deadline}
  data-state={closed ? 'closed' : 'open'}
  data-days={chip.days}
  data-tomorrow={chip.tomorrow}
  data-today={chip.today}
  data-closed={chip.closed}
  data-closed-ago={chip.closedAgo}
>
  <Icon name="clock" />
  <span data-deadline-text>{closed ? chip.closed : chip.open}</span>
</span>

<style>
  /* Open: the sun pill that asks for attention. Closed: the dashed
     "done" pill shared with finished events. */
  .deadline-chip[data-state='open'] {
    --chip-fill: var(--pastel-sun);
    color: var(--on-pastel);
  }
  .deadline-chip[data-state='closed'] {
    --chip-fill: transparent;
    border-style: dashed;
    color: var(--text-muted);
  }
</style>
