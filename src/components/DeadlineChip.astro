---
/**
 * Live countdown for the funding call. The server renders the static
 * "open until" text; the shared `caligoDeadlines()` script in Base.astro
 * swaps it for a day count in the visitor's local date, or for how long
 * ago the call closed ("Closed 9 days ago").
 */
import Icon from './Icon.astro';
import { PILOT_DEADLINE, PILOT_INTRO } from '../data/pilot-call';
import { isPast } from '../data/hackathon';
import type { Locale } from '../i18n';

interface Props {
  readonly locale: Locale;
  readonly class?: string;
  /** A call other than the current one (a closed call on the timeline). */
  readonly deadline?: string;
  /** Wording for a deadline other than a funding call (e.g. a registration). */
  readonly strings?: (typeof PILOT_INTRO)[Locale]['chip'];
}
const { locale, class: className, deadline = PILOT_DEADLINE, strings } = Astro.props;
const chip = strings ?? PILOT_INTRO[locale].chip;
const closed = isPast(deadline);
---

<span
  class:list={['chip', 'deadline-chip', className]}
  data-deadline={deadline}
  data-deadline-kind={strings ? 'other' : undefined}
  data-state={closed ? 'closed' : 'open'}
  data-days={chip.days}
  data-tomorrow={chip.tomorrow}
  data-today={chip.today}
  data-closed={chip.closed}
  data-closed-ago={chip.closedAgo}
>
  <Icon name="clock" />
  <span data-deadline-text>{closed ? chip.closed : chip.open}</span>
</span>

<style>
  /* Open: the deep green pill (deadline), so it never competes with the
     rust action beside it. Closed: the dashed "done" pill shared with
     finished events. */
  .deadline-chip[data-state='open'] {
    --chip-fill: var(--deadline-fill);
    --ink-line: var(--deadline-line);
    --ink-inner: var(--deadline-line);
    color: var(--deadline-text);
  }
  .deadline-chip[data-state='closed'] {
    --chip-fill: transparent;
    border-style: dashed;
    color: var(--text-muted);
  }
</style>
