---
import { FACILITIES, pick } from '../data/initiative';
import type { Locale } from '../i18n';
import ArrowText from './ArrowText.astro';

interface Props {
  readonly locale: Locale;
}

const { locale } = Astro.props;


// "NextSeq 2000, MinION, PromethION (Hi-C expertise planned)" becomes one
// tag per instrument; commas inside parentheses stay with their tag.
function splitPlatforms(text: string): string[] {
  const out: string[] = [];
  let depth = 0, current = '';
  for (const ch of text) {
    if (ch === '(') depth++;
    if (ch === ')') depth--;
    if (ch === ',' && depth === 0) { out.push(current.trim()); current = ''; continue; }
    current += ch;
  }
  if (current.trim()) out.push(current.trim());
  return out;
}

// "PromethION (Hi-C expertise planned)": the instrument becomes the tag and
// the note in brackets follows it as a dashed tag (planned, not yet there)
// that wraps as words instead of stretching.
function splitNote(platform: string): { name: string; note?: string } {
  const m = platform.match(/^(.*?)\s*\((.+)\)$/);
  return m ? { name: m[1], note: m[2] } : { name: platform };
}


const labels = {
  caption:     { en: 'Partner facilities', es: 'Centros asociados' },
  institution: { en: 'Institution', es: 'Institución' },
  country:     { en: 'Country', es: 'País' },
  platforms:   { en: 'Platforms', es: 'Plataformas' },
  website:     { en: 'Website', es: 'Sitio web' },
} as const;
---

<div class="facility-table-wrapper ink-card">
  <table class="facility-table">
    <caption class="facility-caption">{labels.caption[locale]}</caption>
    <thead>
      <tr>
        <th scope="col" class="col-institution">{labels.institution[locale]}</th>
        <th scope="col" class="col-country">{labels.country[locale]}</th>
        <th scope="col" class="col-platforms">{labels.platforms[locale]}</th>
        <th scope="col" class="col-website">{labels.website[locale]}</th>
      </tr>
    </thead>
    <tbody>
      {FACILITIES.map((facility) => (
        <tr>
          <td class="cell-institution">{facility.institution}</td>
          <td class="cell-country">{pick(facility.country, locale)}</td>
          <td class="cell-platforms">
            <ul class="platform-list" role="list">
              {splitPlatforms(typeof facility.platforms === 'string' ? facility.platforms : pick(facility.platforms, locale)).map(splitNote).map(({ name, note }) => (
                <li class="platform-item"><span class="chip chip--sm chip--mono platform">{name}</span>{note && <span class="chip chip--sm chip--mono chip--done platform platform-note">{note}</span>}</li>
              ))}
            </ul>
          </td>
          <td class="cell-website">
            {facility.websites.map((website) => (
              <a href={website.href} target="_blank" rel="noopener noreferrer external">
                <ArrowText text={website.label} icon="external" />
              </a>
            ))}
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .facility-table-wrapper {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .facility-table {
    width: 100%;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
    font-size: var(--step--1);
  }
  /* The h3 above names the table, so the caption is for screen readers
     only; the column headers carry the green band that tops the box. */
  .facility-caption {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  thead th {
    padding: var(--space-s) var(--space-m);
    text-align: left;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--on-pastel);
    background: var(--pastel-leaf);
    border-bottom: var(--ink-w) solid var(--ink-line);
    white-space: nowrap;
  }
  tbody tr {
    border-bottom: 1px solid var(--hairline);
  }
  tbody tr:last-child {
    border-bottom: none;
  }
  tbody td {
    padding: var(--space-s) var(--space-m);
    /* Facts read at body size; the mono instrument tags stay a step down. */
    font-size: var(--step-0);
    color: var(--text);
    line-height: 1.4;
    vertical-align: top;
  }
  .cell-institution {
    font-weight: 600;
    color: var(--text-strong);
  }
  .cell-country {
    white-space: nowrap;
  }
  .platform-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* Instrument tags read at the table's own size and wrap like words. */
  .platform-item { display: inline-flex; flex-wrap: wrap; align-items: center; gap: 0.3rem; }
  /* Soft tags: a faint hairline and tint instead of an ink outline, so a
     table full of instruments reads quietly inside its green box. */
  .platform {
    font-size: var(--step--1);
    white-space: normal;
    --chip-fill: color-mix(in oklab, var(--text) 5%, transparent);
    --ink-inner: var(--surface-border);
    border-width: 1px;
  }
  .platform-note {
    --chip-fill: transparent;
    --ink-inner: color-mix(in oklab, var(--text) 45%, transparent);
    color: var(--text);
  }
  .cell-website {
    display: grid;
    gap: 0.35rem;
  }
  .cell-website a :global(svg) { width: 1em; height: 1em; }
  .cell-website a {
    color: var(--accent-strong);
    text-underline-offset: 0.16em;
  }
  /* Phones: each facility becomes a short record, so nobody has to pan
     sideways to reach the website column. */
  @media (max-width: 40rem) {
    .facility-table-wrapper { overflow: visible; }
    .facility-table thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    .facility-table, .facility-table tbody, .facility-table tr, .facility-table td { display: block; width: auto; }
    tbody td { padding: 0.15rem var(--space-m); }
    tbody tr { padding-block: var(--space-s); }
    .cell-institution { padding-bottom: 0.3rem; }
    .cell-country { color: var(--text-muted); white-space: normal; }
    .cell-platforms { padding-block: 0.3rem; }
    .facility-table td.cell-website { display: grid; padding-top: 0.4rem; }
  }
  .col-institution { width: 32%; }
  .col-country     { width: 12%; }
  .col-platforms   { width: 34%; }
  .col-website     { width: 22%; }
</style>
