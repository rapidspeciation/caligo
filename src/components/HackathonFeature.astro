---
/**
 * Home feature for the Genome Assembly & Curation Hackathon, placed right
 * under the hero while the event is still ahead. One card: the facts and
 * the registration action on the left, the official poster on the right
 * (it enlarges in the shared lightbox). Dates switch the states in the
 * visitor's own calendar: registration open until the deadline, then a
 * "registration closed" note, and the whole section hides once the event
 * has ended. Copy and dates live in `data/hackathon.ts`.
 */
import Icon from './Icon.astro';
import ArrowText from './ArrowText.astro';
import DeadlineChip from './DeadlineChip.astro';
import {
  HACKATHON,
  HACKATHON_CONGRESS_URL,
  HACKATHON_END,
  HACKATHON_FLYER,
  HACKATHON_REGISTRATION_DEADLINE,
  HACKATHON_REGISTRATION_URL,
  HACKATHON_START,
  isPast,
} from '../data/hackathon';
import type { Locale } from '../i18n';

interface Props {
  readonly locale: Locale;
}
const { locale } = Astro.props;
const c = HACKATHON[locale];
const base = import.meta.env.BASE_URL;
const closed = isPast(HACKATHON_REGISTRATION_DEADLINE);
const over = isPast(HACKATHON_END);
const [congressHead, congressTail] = c.congress.split('{link}');
// From 720 px up: at card size (25rem) a 480 px file made the poster soft.
const srcset = HACKATHON_FLYER.srcset.filter((s) => s.width >= 720).map((s) => `${base}${s.path} ${s.width}w`).join(', ');
---

<section
  id="hackathon"
  class="section section--tight hackathon-section"
  aria-labelledby="hackathon-title"
  data-show-until={HACKATHON_END}
  hidden={over}
>
  <div class="container-wide">
    <article class="hackathon-card ink-card" data-tone="leaf">
      <div class="hackathon-copy">
        <p class="hackathon-eyebrow content-label">{c.eyebrow}</p>
        <h2 id="hackathon-title" class="hackathon-title">{c.title}</h2>

        <ul class="hackathon-facts" role="list">
          <li><Icon name="calendar" /><time datetime={HACKATHON_START}>{c.dates}</time></li>
          <li><Icon name="map-pin" /><span>{c.place}</span></li>
          <li><Icon name="users" /><span>{c.mode}</span></li>
        </ul>

        <ul class="check-list hackathon-points content-body" role="list">
          {c.points.map((p) => (
            <li><Icon name="check" /><span><strong>{p.label}</strong> {p.text}</span></li>
          ))}
        </ul>

        <div class="hackathon-action" data-show-until={HACKATHON_REGISTRATION_DEADLINE} hidden={closed}>
          <a class="btn btn--primary" href={HACKATHON_REGISTRATION_URL} target="_blank" rel="external noopener">
            <span><ArrowText text={c.register} icon="external" /></span><span class="sr-only"> {c.newTab}</span>
          </a>
          <div class="hackathon-deadline">
            <span class="hackathon-deadline-label">{c.deadlineLabel}</span>
            <strong><time datetime={HACKATHON_REGISTRATION_DEADLINE}>{c.deadline}</time></strong>
          </div>
          <DeadlineChip locale={locale} deadline={HACKATHON_REGISTRATION_DEADLINE} strings={c.chip} />
        </div>
        {/* After the deadline: the dashed "registration closed" pill, as on
            Funding, in place of the button row. */}
        <div class="hackathon-status" data-show-after={HACKATHON_REGISTRATION_DEADLINE} hidden={!closed}>
          <DeadlineChip locale={locale} deadline={HACKATHON_REGISTRATION_DEADLINE} strings={c.chip} />
          <p class="content-body hackathon-closed">{c.closedNote}</p>
        </div>

        <p class="content-meta hackathon-congress">
          {congressHead}<a class="text-link" href={HACKATHON_CONGRESS_URL} target="_blank" rel="external noopener"><ArrowText text={c.congressLink} icon="external" /><span class="sr-only"> {c.newTab}</span></a>{congressTail}
        </p>
      </div>

      <a
        class="hackathon-flyer"
        href={`${base}${HACKATHON_FLYER.full}`}
        aria-label={c.flyerOpen}
        data-lightbox
        data-caption={c.flyerCaption}
      >
        <img
          src={`${base}${HACKATHON_FLYER.srcset[1].path}`}
          srcset={srcset}
          sizes="(min-width: 52rem) 25rem, 24rem"
          alt={c.flyerAlt}
          width={HACKATHON_FLYER.width}
          height={HACKATHON_FLYER.height}
          loading="lazy"
          decoding="async"
        />
        <span class="hackathon-zoom" aria-hidden="true"><Icon name="zoom-in" /></span>
      </a>
    </article>
  </div>
</section>
{/* Settle the dated states before first paint (the banner's call runs
    before this section exists). */}
<script is:inline>window.caligoDeadlines && window.caligoDeadlines();</script>

<style>
  .hackathon-section[hidden] { display: none; }
  .hackathon-section { padding-block: var(--space-l); scroll-margin-top: 4rem; }

  .hackathon-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(16rem, 34%, 25rem);
    gap: var(--space-l);
    align-items: center;
    padding: var(--space-l);
  }

  .hackathon-copy { display: grid; gap: var(--space-s); min-width: 0; }
  .hackathon-eyebrow { color: var(--accent-strong); }
  .hackathon-title {
    margin: 0;
    font-size: var(--step-3);
    line-height: 1.1;
    color: var(--text-strong);
    text-wrap: balance;
  }

  /* Date, place and format: the three facts a visitor checks first. */
  .hackathon-facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-m);
    margin: 0;
    padding: var(--space-xs) var(--space-s);
    list-style: none;
    background: var(--bg);
    border: 1px solid var(--hairline-strong, var(--hairline));
    border-radius: var(--radius);
    font-size: var(--step-0);
    font-weight: 560;
    color: var(--text-strong);
  }
  .hackathon-facts li { display: inline-flex; align-items: center; gap: 0.45rem; }
  .hackathon-facts :global(svg) { width: 1.15rem; height: 1.15rem; flex: none; color: var(--deadline-fill); }
  :global([data-mode='dark']) .hackathon-facts :global(svg) { color: var(--card-tone); }

  .hackathon-points { margin-block: var(--space-2xs); }
  .hackathon-points strong { color: var(--text-strong); font-weight: 600; }

  .hackathon-action {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-s) var(--space-m);
  }
  .hackathon-action[hidden], .hackathon-status[hidden] { display: none; }
  .hackathon-deadline { display: grid; line-height: 1.3; font-size: var(--step--1); color: var(--text-muted); }
  .hackathon-deadline strong { color: var(--text-strong); font-size: var(--step-0); font-weight: 600; }
  .hackathon-status { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-xs) var(--space-s); }
  .hackathon-closed { margin: 0; }
  .hackathon-congress { margin: 0; color: var(--text-muted); }
  .hackathon-congress .text-link { display: inline; }

  /* The poster: readable at card size, full size in the lightbox. */
  .hackathon-flyer {
    position: relative;
    display: block;
    border-radius: calc(var(--radius-card) - 4px);
    overflow: hidden;
    border: 1px solid var(--hairline);
    box-shadow: var(--ink-drop) var(--ink-drop) 0 var(--card-tone);
    transition: transform var(--transition), box-shadow var(--transition);
  }
  .hackathon-flyer img {
    display: block;
    width: 100%;
    height: auto;
    transition: transform 400ms ease;
  }
  @media (hover: hover) {
  .hackathon-flyer:hover { transform: translate(-2px, -2px); box-shadow: calc(var(--ink-drop) + 2px) calc(var(--ink-drop) + 2px) 0 var(--card-tone); }
  .hackathon-flyer:hover img { transform: scale(1.03); }
  }
  .hackathon-flyer:active { transform: translate(1px, 1px); box-shadow: 1px 1px 0 var(--card-tone); }
  .hackathon-flyer:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .hackathon-zoom {
    position: absolute;
    right: 0.6rem;
    bottom: 0.6rem;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    background: color-mix(in oklab, #1c1714 78%, transparent);
    color: #fffdf7;
  }
  .hackathon-zoom :global(svg) { width: 1.1rem; height: 1.1rem; }

  @media (prefers-reduced-motion: reduce) {
    .hackathon-flyer, .hackathon-flyer img { transition: none; }
    .hackathon-flyer:hover img { transform: none; }
  }

  @media (max-width: 64rem) { .hackathon-card { align-items: start; } }

  /* Phones and narrow tablets: facts and action first, the poster below. */
  @media (max-width: 52rem) {
    .hackathon-card { grid-template-columns: 1fr; padding: var(--space-m); gap: var(--space-m); }
    .hackathon-flyer { max-width: 24rem; justify-self: center; width: 100%; }
    .hackathon-title { font-size: var(--step-2); }
  }
  @media (max-width: 36rem) {
    .hackathon-action .btn { width: 100%; justify-content: center; }
  }
</style>
