---
/**
 * Local pilot projects from Caligo's calls (Colombia first), on the Pilot
 * projects page. One card per project: photo on the left, then the title,
 * the team's own summary, and who leads it in a column on the right. The
 * section sits on the raised panel band, so it reads as its own set above
 * the proposed pilots. On phones the card stacks; a photo smaller than the
 * frame (one team sent 208 px) keeps its own size instead of being blown up.
 * Data in `data/local-pilots.ts`.
 */
import Icon from './Icon.astro';
import { italicizeSpecies } from '../data/content';
import { LOCAL_PILOTS, SHOWN_LOCAL_PILOTS, LOCAL_PILOTS_COPY } from '../data/local-pilots';
import { srcsetFor } from '../data/image-variants';
import type { Locale } from '../i18n';

interface Props { readonly locale: Locale; }
const { locale } = Astro.props;
const c = LOCAL_PILOTS_COPY[locale];
const base = import.meta.env.BASE_URL;
const shown = SHOWN_LOCAL_PILOTS.length;
const rest = LOCAL_PILOTS.length - shown;
const word = (n: number) => c.numbers[n] ?? String(n);
const more = rest > 0 ? (rest === 1 ? c.moreOne : c.more).replace('{Shown}', word(shown).replace(/^./, (ch) => ch.toUpperCase())).replace('{shown}', word(shown)).replace('{rest}', word(rest)) : '';
/** Two institutions are joined by "and"/"y" or ";" in the data. */
const manyPlaces = (s: string) => /;| (?:and|y) (?:Universidad|Instituto|Centro)\b/.test(s);
---

<section id="local-pilots" class="section section--panel local-pilots" aria-labelledby="local-pilots-title">
  <div class="container-wide">
    <header class="local-head">
      <h2 id="local-pilots-title" class="content-heading">{c.title}</h2>
      <p class="content-body local-lead">{c.lead}{more && <> {more}</>}</p>
      <a class="text-link local-jump" href="#proposed-projects"><span>{c.jump}</span><Icon name="arrow-down" /></a>
    </header>

    <ol class="local-list" role="list">
      {SHOWN_LOCAL_PILOTS.map((p, i) => {
        const photo = p.photo!;
        const srcset = srcsetFor(photo.path, photo.width, base);
        const small = photo.width < 400;
        return (
          <li id={`local-${p.id}`} class="local-card ink-card ink-card--flat">
            <figure class:list={['local-media', { 'local-media--contain': photo.fit === 'contain', 'local-media--small': small, 'local-media--light': photo.lightBackdrop }]}>
              <div class="local-frame">
              <img
                src={`${base}${photo.path}`}
                srcset={srcset}
                sizes={srcset ? '(min-width: 48rem) 13rem, 100vw' : undefined}
                width={photo.width}
                height={photo.height}
                alt={photo.alt[locale]}
                loading={i === 0 ? 'eager' : 'lazy'}
                decoding="async"
                style={photo.position ? `object-position: ${photo.position}` : undefined}
              />
              </div>
              {photo.caption && <figcaption set:html={italicizeSpecies(photo.caption)} />}
            </figure>
            <h3 class="local-title" set:html={italicizeSpecies(p.title[locale])} />
            <p class="local-summary content-body" set:html={italicizeSpecies(p.summary[locale])} />
            {(p.leaders.length > 0 || p.where) && (
              <dl class="local-meta">
                {p.leaders.length > 0 && (
                  <div class="local-meta-leaders">
                    <dt><Icon name="users" /><span>{p.leaders.length === 1 ? c.leadersOne : c.leaders}</span></dt>
                    <dd>{p.leaders.join(', ')}</dd>
                  </div>
                )}
                {p.where && (
                  <div>
                    <dt><Icon name="map-pin" /><span>{manyPlaces(p.where[locale]) ? c.whereMany : c.where}</span></dt>
                    <dd>{p.where[locale]}</dd>
                  </div>
                )}
              </dl>
            )}
          </li>
        );
      })}
    </ol>
  </div>
</section>

<style>
  .local-pilots { scroll-margin-top: var(--scroll-margin-top, 4rem); }
  .local-head { display: grid; gap: var(--space-2xs); margin-bottom: var(--space-m); }
  .local-head > * { margin: 0; }
  .local-lead { max-width: var(--measure); }
  .local-jump { justify-self: start; padding-block: 0.35rem; font-size: var(--step--1); font-weight: 600; }
  .local-jump :global(svg) { width: 1rem; height: 1rem; }
  @media (pointer: coarse) { .local-jump { min-height: 44px; display: inline-flex; align-items: center; } }
  .local-jump:hover :global(svg) { transform: translateY(3px); }

  .local-list {
    display: grid;
    gap: var(--space-m);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Phones: one column, photo on top. */
  .local-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: 'media' 'title' 'summary' 'meta';
    gap: var(--space-s);
    align-items: start;
    margin: 0;
    padding: var(--space-s);
    border-width: 1px;
    border-left-width: 4px;
    scroll-margin-top: var(--scroll-margin-top, 4rem);
  }
  .local-media { grid-area: media; margin: 0; display: grid; gap: 0.3rem; }
  .local-media img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    height: auto;
    object-fit: cover;
    border-radius: 6px;
    border: 1px solid var(--hairline);
    background: var(--bg);
  }
  /* A specimen on white: shown whole, with a little air, and dimmed so it
     does not glare on the dark theme. */
  .local-media--contain img { object-fit: contain; padding: 0.4rem; background: #fff; }
  :global([data-mode='dark']) .local-media--contain img { filter: brightness(0.78) sepia(0.12) contrast(1.06); }
  /* Photos on a pale sheet or card get a lighter version of the same dimming. */
  :global([data-mode='dark']) .local-media--light img { filter: brightness(0.85) sepia(0.06) contrast(1.03); }
  /* A photo smaller than the frame keeps its own size; on phones it sits
     centred on a plain panel, so the space beside it looks intended. */
  .local-media--small img { max-width: 13rem; aspect-ratio: 4 / 3; }
  @media (max-width: 47.99rem) {
    .local-media--small .local-frame {
      display: grid;
      place-items: center;
      padding: var(--space-xs);
      background: var(--bg);
      border: 1px solid var(--hairline);
      border-radius: 6px;
    }
    /* The frame owns the hairline: no box inside a box. */
    .local-media--small img { border: 0; border-radius: 4px; }
  }
  .local-media figcaption { font-size: var(--step--1); color: var(--text-muted); line-height: 1.3; }

  .local-title {
    grid-area: title;
    margin: 0;
    max-width: 44rem;
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 600;
    line-height: 1.3;
    color: var(--text-strong);
    text-wrap: pretty;
  }
  .local-summary { grid-area: summary; margin: 0; max-width: var(--measure); }

  .local-meta {
    grid-area: meta;
    display: grid;
    gap: var(--space-xs);
    margin: 0;
    padding-top: var(--space-xs);
    border-top: 1px solid var(--hairline);
    font-size: var(--step--1);
  }
  .local-meta > div { display: grid; gap: 0.15rem; align-content: start; }
  .local-meta dt {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--text-muted);
  }
  .local-meta dt :global(svg) { width: 1rem; height: 1rem; flex: none; color: var(--deadline-line); }
  .local-meta dd { margin: 0; color: var(--text); }
  .local-meta-leaders dd { color: var(--text-strong); font-weight: 560; }

  /* Tablets: the photo as a column on the left, the text beside it. */
  @media (min-width: 48rem) {
    .local-card {
      grid-template-columns: 13rem minmax(0, 1fr);
      grid-template-areas:
        'media title'
        'media summary'
        'media meta';
      grid-template-rows: auto auto 1fr;
      gap: var(--space-xs) var(--space-l);
      padding: var(--space-m);
    }
    .local-media img { aspect-ratio: 4 / 3; }
  }

  /* Tablets and small laptops: leaders and institution side by side. */
  @media (min-width: 48rem) and (max-width: 71.99rem) {
    .local-meta { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-m); }
  }

  /* Wide screens: who leads it moves to a third column, level with the
     title (from 72rem, so the summary keeps a readable width). */
  @media (min-width: 72rem) {
    .local-card {
      grid-template-columns: 13rem minmax(0, 1fr) 15rem;
      grid-template-areas:
        'media title meta'
        'media summary meta';
      grid-template-rows: auto 1fr;
    }
    .local-meta {
      align-self: start;
      padding: 0 0 0 var(--space-m);
      border-top: 0;
      border-left: 1px solid var(--hairline);
    }
  }
</style>
