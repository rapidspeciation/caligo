---
/**
 * SciencePage introduces the shared reference-genome programme, then moves
 * from published examples into the four research questions that motivate
 * Caligo's proposed pilot projects. Publication figures appear once, above the research questions.
 */
import Base from '../../layouts/Base.astro';
import PageHeader from '../PageHeader.astro';
import MediaCandidateViewer from '../MediaCandidateViewer.astro';
import Icon from '../Icon.astro';
import FigureLightbox from '../FigureLightbox.astro';
import TierDiagram from '../TierDiagram.astro';
import { getDict, localePath, type Locale } from '../../i18n';
import { getSource, getMediaModule } from '../../data/records';
import { EVENTS, pick } from '../../data/initiative';
import { publicationExamples, scienceFeedback } from '../../data/science-feedback';
import { italicizeSpecies } from '../../data/content';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getDict(locale);
const s = t.science;
const feedback = scienceFeedback[locale];
const base = import.meta.env.BASE_URL;

const anchors = [
  'chromosomes',
  'connectivity',
  'soybean-movement-resistance',
  'panacea-migration',
] as const;
const questionSourceIds = {
  chromosomes: ['rueda-2024', 'mackay-smith-2026'],
  connectivity: ['seraphim-2016', 'iucn-parides-2018', 'icmbio-parides-2021'],
  'soybean-movement-resistance': ['horikoshi-2021', 'braga-2024'],
  'panacea-migration': ['gallice-2020', 'batesia-2026'],
} as const;

/** The image beside the prose. */
const questionAside: Record<string, { photo?: string }> = {
  chromosomes: { photo: 'pilot-heliconius' },
  connectivity: { photo: 'pilot-parides' },
  'soybean-movement-resistance': { photo: 'pilot-soybean' },
  'panacea-migration': { photo: 'pilot-panacea' },
};

const pilotContinuation: Record<string, { cardIndex: number; slug: string } | undefined> = {
  chromosomes: { cardIndex: 0, slug: 'heliconius' },
  connectivity: { cardIndex: 1, slug: 'parides-ascanius' },
  'soybean-movement-resistance': { cardIndex: 2, slug: 'soybean-lepidoptera' },
  'panacea-migration': { cardIndex: 3, slug: 'panacea-prola' },
};

const TIER_KINDS = ['barcode', 'resequencing', 'reference'] as const;
const tiers = t.science.tiers;

const sourcesLabel = locale === 'es' ? 'Fuentes' : 'Sources';
---

<Base locale={locale} title={s.metaTitle} description={s.metaDescription} page="/science">

  <PageHeader title={feedback.pageTitle} intro={feedback.pageIntro} />

  <section class="section reference-section" aria-labelledby="reference-heading">
    <div class="container-wide reference-layout">
      <div class="reference-copy">
        <h2 id="reference-heading" class="section-heading content-heading">
          {feedback.reference.heading}
        </h2>
        {feedback.reference.body.map((para) => <p class="prose-para content-body">{para}</p>)}
      </div>
      <aside class="genome-goal" aria-labelledby="genome-goal-heading">
        <p class="goal-number mono">{locale === 'es' ? '1.000' : '1,000'}</p>
        <h3 id="genome-goal-heading" class="goal-heading">{feedback.reference.goalHeading}</h3>
        <p class="content-body">{feedback.reference.goalBody}</p>
        <a target="_blank"
          class="btn standards-link"
          href="https://www.earthbiogenome.org/report-on-assembly-standards"
          rel="external noopener"
        >
          <Icon name="external" />{feedback.reference.standardsLink}
        </a>
      </aside>
    </div>
  </section>

  <!-- Three tiers of genomic data, from Nicol's vision document. Each card
       carries a didactic diagram that plays once in view. -->
  <section id="tiers" class="section tiers-section" aria-labelledby="tiers-heading">
    <div class="container-wide">
      <div class="tiers-head">
        <h2 id="tiers-heading" class="section-heading content-heading">{tiers.heading}</h2>
        <p class="content-body">{tiers.intro}</p>
      </div>
      <ol class="tier-list" role="list">
        {tiers.items.map((item, i) => (
          <li class="tier-card">
            <TierDiagram locale={locale} kind={TIER_KINDS[i]} />
            <div class="tier-copy">
              <p class="tier-label mono">{tiers.tierLabel} {i + 1}</p>
              <h3 class="tier-title">{item.title}</h3>
              <p class="tier-body">{item.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section analysis-section" aria-labelledby="analysis-heading">
    <div class="container-wide analysis-layout">
      <div class="analysis-main">
      <div class="analysis-heading-group">
        <h2 id="analysis-heading" class="section-heading content-heading">
          {feedback.analysis.heading}
        </h2>
      </div>
      <div class="analysis-copy">
        {feedback.analysis.body.map((para) => <p class="prose-para content-body">{para}</p>)}
        <a class="text-link" href={localePath(locale, '/projects')}>
          {feedback.analysis.projectsLink}<Icon name="arrow-right" />
        </a>
      </div>
      </div>
      <ul class="training-events" role="list" aria-label={feedback.analysis.eyebrow}>
        {EVENTS.map((event) => (
          <li class="training-event">
            <time class="training-event-date mono">{pick(event.dates, locale)}</time>
            <span class="training-event-name">{pick(event.name, locale)}</span>
            <span class="training-event-place">{pick(event.location, locale)}</span>
            <p class="training-event-summary" set:html={italicizeSpecies(pick(event.summary, locale))} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section publications-section" aria-labelledby="publications-heading">
    <div class="container-wide">
      <div class="publications-intro">
        <h2 id="publications-heading" class="section-heading content-heading">
          {feedback.publications.heading}
        </h2>
        <p class="content-body">{feedback.publications.intro}</p>
      </div>

      <div class="publication-grid">
        {publicationExamples.map((publication, index) => (
          <article class="publication-card" data-lift>
            <div class="publication-index mono" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </div>
            <a target="_blank" class="publication-title" href={publication.url} rel="external noopener">
              <h3 set:html={italicizeSpecies(publication.title)} />
              <Icon name="external" />
            </a>
            <figure>
              <a
                class="publication-image-wrap"
                href={`${base}${publication.figure.src}`}
                aria-label={`${feedback.publications.figureLabel}: ${publication.title}`}
                data-lightbox
                data-caption={publication.figure.caption[locale]}
              >
                <span class="publication-zoom" aria-hidden="true"><Icon name="zoom-in" /></span>
                <img
                  src={`${base}${publication.figure.src}`}
                  alt={publication.figure.alt[locale]}
                  width={publication.figure.width}
                  height={publication.figure.height}
                  loading="lazy"
                  decoding="async"
                />
              </a>
              <figcaption>
                <p class="publication-caption" set:html={italicizeSpecies(publication.figure.caption[locale])} />
                <p class="publication-credit mono">
                  <a target="_blank" href={publication.url} rel="external noopener">{publication.citation}</a>
                  {' · '}
                  <a target="_blank" href={publication.figure.licenceUrl} rel="license external noopener">
                    {publication.figure.licence}
                  </a>
                  {publication.figure.changes && (
                    <span>{' · '}{publication.figure.changes[locale]}</span>
                  )}
                </p>
              </figcaption>
            </figure>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="questions-section" aria-labelledby="questions-heading">
    <div class="container-wide">
      <div class="questions-intro">
        <div class="questions-intro-copy">
          <h2 id="questions-heading" class="section-heading content-heading">
            {feedback.evidence.heading}
          </h2>
          <p class="content-body">{feedback.evidence.intro}</p>
        </div>
      </div>

      {s.questions.map((q, i) => {
        const anchor = anchors[i];
        const aside = questionAside[anchor];
        const continuation = pilotContinuation[anchor];
        const media = aside.photo ? getMediaModule(aside.photo) : undefined;
        const thumb = media?.candidates.find((c) => c.kind === 'documentary') ?? media?.candidates[0];
        const sources = questionSourceIds[anchor]
          .map((sourceId) => getSource(sourceId))
          .filter((source) => source !== undefined);
        return (
          <details id={anchor} class="question disclosure" data-question>
            <summary class="question-summary">
              {thumb && (
                <img class="question-thumb" src={`${base}${thumb.path}`} alt="" width={thumb.width} height={thumb.height} loading="lazy" decoding="async" />
              )}
              <span class="question-summary-text">
                <span class="question-label content-label">{i + 1} · {t.home.researchLabels[i]}</span>
                <h3 class="question-heading content-heading" set:html={italicizeSpecies(q.heading)} />
              </span>
              <span class="question-chevron" aria-hidden="true"><Icon name="arrow-right" /></span>
            </summary>
            <div class="disclosure-body question-body">
            <div class:list={['split', { 'split--prose-only': !aside.photo }]}>
              <div class="split-prose">
                {q.answer.map((para) => <p class="content-body" set:html={italicizeSpecies(para)} />)}
                <p class="question-sources content-meta">
                  <span class="question-sources-label content-label">{sourcesLabel}: </span>
                  {sources.map((src, n) => (
                    <>
                      {n > 0 && ' · '}
                      <a target="_blank" href={src.url} rel="external noopener">
                        {src.inlineLabel?.[locale] ?? src.shortLabel ?? src.citation}
                      </a>
                    </>
                  ))}
                </p>
                {continuation && (
                  <a
                    class="pilot-continuation"
                    href={`${localePath(locale, '/projects')}#${continuation.slug}`}
                  >
                    <span class="pilot-continuation-label content-label">{s.pilotContinuationLabel}</span>
                    <span class="pilot-continuation-title">
                      {t.home.researchCards[continuation.cardIndex].projectLink}
                      <Icon name="arrow-right" />
                    </span>
                  </a>
                )}
              </div>

              {aside.photo && (
                <div class="split-figure">
                  <MediaCandidateViewer moduleId={aside.photo} locale={locale} aspectRatio="4 / 3" captionMode="compact" singleImage />
                </div>
              )}
            </div>
            </div>
          </details>
        );
      })}
    </div>
  </section>

  <FigureLightbox locale={locale} />

  <script is:inline>
    /* Links to /science/#<question> (from Home and Pilot projects) open
       that question instead of leaving it collapsed. */
    (function () {
      function openTarget() {
        var id = decodeURIComponent(location.hash.slice(1));
        var target = id && document.getElementById(id);
        if (target && target.matches('[data-question]')) target.open = true;
      }
      if (!window.__caligoQuestionHash) {
        window.__caligoQuestionHash = true;
        document.addEventListener('astro:page-load', openTarget);
        window.addEventListener('hashchange', openTarget);
      }
      openTarget();
    })();
  </script>

  <section class="section" aria-labelledby="ethics-heading">
    <div class="container-wide prose-column">
      <h2 id="ethics-heading" class="section-heading content-heading">{feedback.ethics.heading}</h2>
      {feedback.ethics.body.map((para) => <p class="prose-para content-body">{para}</p>)}
    </div>
  </section>

</Base>

<style>
  .section-eyebrow {
    margin-bottom: var(--space-s);
  }
  .section-heading {
    margin-bottom: var(--space-m);
    max-width: 28ch;
  }
  .prose-para {
    margin-bottom: var(--space-m);
    max-width: var(--measure);
  }
  .prose-para:last-child { margin-bottom: 0; }

  /* ---- Reference genome overview ---- */
  .reference-section {
    background: var(--bg-raised);
  }
  .reference-layout,
  .analysis-layout {
    display: grid;
    gap: var(--space-l);
    align-items: start;
  }
  .reference-copy {
    max-width: var(--measure);
  }
  .genome-goal {
    padding: var(--space-l);
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius);
    background: var(--bg);
  }
  .goal-number {
    margin-bottom: var(--space-xs);
    color: var(--accent-strong);
    font-size: clamp(3.5rem, 10vw, 7rem);
    font-weight: 440;
    letter-spacing: -0.08em;
    line-height: 0.9;
  }
  .goal-heading {
    margin-bottom: var(--space-s);
    max-width: 20ch;
  }
  .standards-link {
    margin-top: var(--space-m);
    width: fit-content;
  }
  @media (min-width: 60rem) {
    .reference-layout {
      grid-template-columns: minmax(0, 1.12fr) minmax(20rem, 0.88fr);
      gap: clamp(3rem, 7vw, 7rem);
    }
  }

  /* ---- Shared analysis ---- */
  .analysis-section {
    border-block: 1px solid var(--hairline);
  }
  .analysis-copy {
    max-width: var(--measure);
  }
  .analysis-copy .text-link {
    margin-top: var(--space-m);
    width: fit-content;
  }
  .analysis-heading-group, .analysis-copy { max-width: 70ch; }
  .analysis-heading-group .section-heading { max-width: none; }
  @media (min-width: 60rem) {
    .analysis-layout {
      grid-template-columns: minmax(0, 1.12fr) minmax(20rem, 0.88fr);
      column-gap: clamp(3rem, 7vw, 7rem);
    }
    .training-events { align-self: center; }
  }
  .training-events {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--hairline-strong);
  }
  .training-event {
    display: grid;
    gap: 0.2rem;
    padding-block: var(--space-m);
    border-bottom: 1px solid var(--hairline);
  }
  .training-event-date {
    color: var(--accent-strong);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
  }
  .training-event-name {
    color: var(--text-strong);
    font-weight: 620;
    line-height: 1.3;
  }
  .training-event-place {
    color: var(--text-faint);
    font-size: var(--step--1);
  }
  .training-event-summary {
    margin-top: var(--space-2xs, 0.25rem);
    color: var(--text-muted);
    font-size: var(--step--1);
    line-height: 1.55;
  }

  /* ---- Publication examples ---- */
  .publications-section {
    background: var(--bg-raised);
  }
  .publications-intro {
    max-width: var(--measure);
    margin-bottom: var(--space-l);
  }
  .publication-grid {
    display: grid;
    gap: var(--space-m);
  }
  .publication-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: var(--space-m);
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius);
    background: var(--bg);
  }
  .publication-index {
    margin-bottom: var(--space-s);
    color: var(--accent-strong);
    font-size: var(--step--1);
  }
  .publication-title {
    display: flex;
    gap: var(--space-s);
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: var(--space-m);
    color: var(--text-strong);
    text-decoration: none;
  }
  .publication-title h3 {
    font-size: clamp(1.15rem, 1rem + 0.5vw, 1.45rem);
    line-height: 1.25;
  }
  .publication-title :global(svg) {
    flex: 0 0 auto;
    margin-top: 0.15em;
  }
  .publication-card figure {
    display: flex;
    flex: 1;
    flex-direction: column;
    margin: 0;
  }
  .publication-image-wrap {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
    min-height: 0;
    overflow: hidden;
    border: 1px solid var(--hairline);
    border-radius: calc(var(--radius) - 2px);
    background: #fff;
  }
  .publication-image-wrap { cursor: zoom-in; }
  .publication-zoom {
    position: absolute;
    right: 0.5rem;
    bottom: 0.5rem;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: rgba(12, 11, 10, 0.7);
    color: #F6F7F3;
    opacity: 0.85;
    transition: opacity var(--transition), transform var(--transition);
  }
  .publication-zoom :global(svg) { width: 1.05rem; height: 1.05rem; }
  .publication-image-wrap:hover .publication-zoom,
  .publication-image-wrap:focus-visible .publication-zoom { opacity: 1; transform: scale(1.06); }
  .publication-image-wrap img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .publication-card figcaption {
    margin-top: var(--space-s);
  }
  .publication-caption {
    color: var(--text);
    font-size: var(--step--1);
    line-height: 1.5;
  }
  .publication-credit {
    margin-top: var(--space-xs);
    color: var(--text-faint);
    font-size: var(--step--2);
    line-height: 1.5;
  }
  .publication-credit a {
    color: var(--text-muted);
  }
  @media (min-width: 48rem) {
    .publication-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 76rem) {
    .publication-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .questions-section {
    padding-block: var(--space-xl);
  }
  .questions-intro { margin-bottom: var(--space-l); }
  .questions-intro-copy { max-width: var(--measure); }

  /* ---- Shape 1: prose beside an image ----
     One rule, used by every block on the page. The image column carries
     the figure's own caption and credit, so it is never a bare picture. */
  .split {
    display: grid;
    gap: var(--space-l);
    grid-template-columns: 1fr;
    align-items: start;
  }
  @media (min-width: 60rem) {
    .split { grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); }
  }
  .split-prose > p {
    margin-bottom: var(--space-m);
    max-width: var(--measure);
  }
  .split-prose > p:last-child { margin-bottom: 0; }
  .split-figure { min-width: 0; }

  .split--prose-only {
    display: block;
  }

  /* ---- Questions: one expandable row each ---- */
  .question {
    scroll-margin-top: 5rem;
    border-top: 1px solid var(--hairline);
  }
  .question:last-of-type { border-bottom: 1px solid var(--hairline); }
  .question-summary {
    list-style: none;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-m);
    padding: var(--space-m) 0;
    cursor: pointer;
  }
  .question-summary::-webkit-details-marker { display: none; }
  .question-summary::marker { content: ''; }
  .question-thumb {
    width: clamp(4.5rem, 9vw, 7rem);
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-xs);
    border: 1px solid var(--hairline);
  }
  /* Once open, the large photo beside the answer takes over. */
  .question[open] .question-thumb { display: none; }
  .question[open] .question-summary { grid-template-columns: minmax(0, 1fr) auto; }
  .question-summary:focus:not(:focus-visible) { outline: none; box-shadow: none; }
  .question-summary-text { display: grid; gap: var(--space-2xs); min-width: 0; }
  .question-label { color: var(--accent-strong); }
  .question-heading { max-width: 34ch; transition: color var(--transition); }
  .question-summary:hover .question-heading { color: var(--accent-strong); }
  .question-chevron {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--surface-border);
    border-radius: 50%;
    color: var(--text-muted);
    transition: transform var(--transition), color var(--transition), border-color var(--transition);
  }
  .question-chevron :global(svg) { width: 1rem; height: 1rem; transform: rotate(90deg); }
  .question[open] .question-chevron { transform: rotate(180deg); color: var(--accent-strong); border-color: var(--accent); }
  .question-body { padding: 0 0 var(--space-l); }
  /* The photo stays in view while the answer is read. */
  @media (min-width: 60rem) {
    .question .split-figure { position: sticky; top: calc(var(--scroll-margin-top) + 1rem); }
  }
  @media (max-width: 40rem) {
    .question-summary { grid-template-columns: auto minmax(0, 1fr); }
    .question-chevron { display: none; }
  }

  .question-sources {
    margin-top: var(--space-m);
  }
  .question-sources-label {
    display: inline;
  }
  .question-sources a {
    color: var(--accent-strong);
    text-decoration: underline;
    text-underline-offset: 0.15em;
    text-decoration-color: var(--hairline-strong);
  }
  .question-sources a:hover { text-decoration-color: currentColor; }
  .pilot-continuation {
    margin-top: var(--space-m);
    width: fit-content;
    max-width: 100%;
    display: grid;
    gap: 0.3rem;
    padding: var(--space-s) var(--space-m);
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius);
    background: var(--bg-raised);
    text-decoration: none;
    transition: border-color var(--transition), background var(--transition);
  }
  .pilot-continuation:hover {
    border-color: var(--accent);
    background: var(--bg-panel);
  }
  .pilot-continuation-title {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 560;
    color: var(--accent-strong);
    line-height: 1.4;
  }
  .pilot-continuation-title :global(svg) { width: 1em; height: 1em; flex: none; transition: transform var(--transition); }
  .pilot-continuation:hover .pilot-continuation-title :global(svg) { transform: translateX(3px); }
  /* ---- H3 Three tiers of genomic data ---- */
  .tiers-head > * + * { margin-top: var(--space-s); }
  .tiers-head .section-heading { margin-bottom: 0; }
  .tiers-section { border-top: 1px solid var(--hairline); }
  .tier-list {
    list-style: none;
    padding: 0;
    margin: var(--space-l) 0 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 1.6vw, 1.5rem);
  }
  .tier-card {
    min-width: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--bg);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
  }
  .tier-copy { padding: var(--space-s) var(--space-m) var(--space-m); }
  .tier-label {
    margin: 0;
    font-size: var(--step--2);
    letter-spacing: 0.06em;
    color: var(--accent);
  }
  .tier-title {
    margin: 0.3rem 0 0;
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 560;
    letter-spacing: -0.015em;
    color: var(--text-strong);
  }
  .tier-body {
    margin: 0.5rem 0 0;
    font-size: var(--step-0);
    line-height: 1.55;
    color: var(--text-muted);
