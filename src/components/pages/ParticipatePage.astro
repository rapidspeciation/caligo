---
import Base from '../../layouts/Base.astro';
import PageHeader from '../PageHeader.astro';
import Icon from '../Icon.astro';
import CopyEmail from '../CopyEmail.astro';
import DiscordButton from '../DiscordButton.astro';
import { LINKS } from '../../data/content';
import { getDict, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getDict(locale);
const p = t.participate;
const stepLabel = locale === 'es' ? 'Paso' : 'Step';
---

<Base locale={locale} title={p.metaTitle} description={p.metaDescription} page="/participate">

  <PageHeader title={p.title} intro={p.intro} />

  <!--
    Three routes in, side by side: register, meet the community, help run it.
    Nicol listed all three links on 2026-07-14 as ones that "deben estar ahí".
  -->
  <section class="section section--tight routes-section">
    <div class="container-wide">
      <ol class="routes" role="list">
        <li id="join" class="route route--primary" aria-labelledby="join-heading">
          <p class="route-step content-label">{stepLabel} 1</p>
          <h2 id="join-heading" class="route-title">{t.join.title}</h2>
          <p class="route-body">{t.join.body}</p>
          <div class="route-action">
            <a class="btn" href={LINKS.joinForm} target="_blank" rel="noopener noreferrer">
              {t.join.cta}<Icon name="external" />
            </a>
            <p class="route-note">{t.join.privacyNote}</p>
          </div>
        </li>
        <li class="route" aria-labelledby="discord-heading">
          <p class="route-step content-label">{stepLabel} 2</p>
          <h2 id="discord-heading" class="route-title">{p.discord.heading}</h2>
          <p class="route-body">{p.discord.body}</p>
          <div class="route-action"><DiscordButton locale={locale} class="btn--ghost" showPendingNote /></div>
        </li>
        <li class="route" aria-labelledby="committee-heading">
          <p class="route-step content-label">{stepLabel} 3</p>
          <h2 id="committee-heading" class="route-title">{t.committee.heading}</h2>
          <p class="route-body">{t.committee.body}</p>
          <div class="route-action">
            <a class="btn btn--ghost" href={LINKS.committeeForm} target="_blank" rel="noopener noreferrer">
              {t.committee.cta}<Icon name="external" />
            </a>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <section class="section section--panel" aria-labelledby="ways-heading">
    <div class="container-wide ways-layout">
      <div class="ways-head">
        <h2 id="ways-heading">{p.audiences.heading}</h2>
        <p class="content-body">{p.audiences.intro}</p>
        <p class="content-body ways-closing">{p.audiences.closing}</p>
      </div>
      <ul class="ways-list" role="list">
        {p.audiences.items.map((item, i) => (
          <li class="way">
            <h3>{item.title}</h3>
            <p class="content-body">{item.body}</p>
            {i === 1 && <a class="text-link" href="#contact">{p.audiences.proposalLink}<Icon name="arrow-right" /></a>}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" aria-label={`${p.benefits.heading} · ${p.languagePolicy.heading}`}>
    <div class="container-wide pair">
      <div class="pair-item">
        <h2 id="benefits-heading" class="pair-heading">{p.benefits.heading}</h2>
        <p class="content-body">{p.benefits.intro}</p>
        <ul class="benefits-list" role="list">
          {p.benefits.items.map((item) => (
            <li><Icon name="check" /><span>{item}</span></li>
          ))}
        </ul>
      </div>
      <div class="pair-item">
        <h2 id="lang-policy-heading" class="pair-heading">{p.languagePolicy.heading}</h2>
        <p class="content-body">{p.languagePolicy.body}</p>
        <p class="languages" aria-hidden="true">
          <span lang="es">Español</span><span lang="en">English</span><span lang="pt">Português</span>
        </p>
      </div>
    </div>
  </section>

  <section class="section section--close" aria-labelledby="contact">
    <div class="container-wide contact-layout">
      <div class="contact-head">
        <h2 id="contact">{p.contact.heading}</h2>
        <p class="content-body">{p.contact.body}</p>
        <CopyEmail locale={locale} />
      </div>
      <div class="contact-note">
        <h3>{p.beforeSubmitting.heading}</h3>
        <p class="content-body">{p.beforeSubmitting.body}</p>
      </div>
    </div>
  </section>

</Base>

<style>
  /* ---- Three routes ---- */
  .routes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-m);
  }
  @media (min-width: 56rem) {
    .routes { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  .route {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    padding: clamp(1.25rem, 2.4vw, 1.9rem);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-lg);
    background: var(--bg-raised);
    scroll-margin-top: var(--scroll-margin-top);
  }
  .route--primary {
    border-color: color-mix(in oklab, var(--accent) 45%, transparent);
    background: color-mix(in oklab, var(--accent) 7%, var(--bg-raised));
  }
  .route-step { color: var(--accent-strong); }
  .route-title {
    margin: 0;
    font-size: var(--step-2);
    line-height: 1.15;
  }
  .route-body {
    margin: 0;
    color: var(--text);
    line-height: 1.55;
  }
  .route-action {
    margin-top: auto;
    padding-top: var(--space-s);
    display: grid;
    justify-items: start;
    gap: var(--space-xs);
  }
  .route-action .btn { min-height: 44px; }
  .route-note {
    margin: 0;
    font-size: var(--step--2);
    color: var(--text-faint);
    line-height: 1.45;
  }

  /* ---- What you can bring ---- */
  .ways-layout {
    display: grid;
    gap: var(--space-l);
  }
  @media (min-width: 60rem) {
    .ways-layout {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.6fr);
      column-gap: clamp(var(--space-l), 5vw, var(--space-2xl));
      align-items: start;
    }
    .ways-head { position: sticky; top: calc(var(--scroll-margin-top) + 1rem); }
  }
  .ways-head > * + * { margin-top: var(--space-m); }
  .ways-head h2 { max-width: 16ch; }
  .ways-closing { color: var(--text-muted); }
  .ways-layout > .ways-list { margin-top: 0; }
  .ways-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--space-l);
    border-top: 1px solid var(--hairline-strong);
  }
  .way {
    padding-block: var(--space-m);
    border-bottom: 1px solid var(--hairline);
    display: grid;
    align-content: start;
    gap: var(--space-xs);
  }
  .way h3 { font-size: var(--step-0); font-family: var(--font-body); font-weight: 620; }
  .way p { margin: 0; }
  .way .text-link { font-size: var(--step--1); margin-top: var(--space-2xs); }
  @media (max-width: 40rem) {
    .ways-list { grid-template-columns: 1fr; }
  }

  /* ---- Outcomes and languages ---- */
  .pair {
    display: grid;
    gap: var(--space-xl);
  }
  @media (min-width: 60rem) {
    .pair { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0; }
    .pair-item:first-child { padding-right: clamp(2rem, 4vw, 4rem); }
    .pair-item + .pair-item { padding-left: clamp(2rem, 4vw, 4rem); border-left: 1px solid var(--hairline); }
  }
  .pair-item > * + * { margin-top: var(--space-m); }
  .pair-heading { font-size: var(--step-2); }
  .benefits-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-s);
  }
  .benefits-list li {
    display: flex;
    gap: 0.7rem;
    align-items: baseline;
    line-height: 1.5;
  }
  .benefits-list :global(svg) {
    flex: none;
    width: 1rem;
    height: 1rem;
    color: var(--accent);
    transform: translateY(0.15rem);
  }
  .languages {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }
  .languages span {
    padding: 0.35rem 0.8rem;
    border: 1px solid var(--hairline-strong);
    border-radius: 999px;
    font-family: var(--font-display);
    font-size: var(--step-0);
    color: var(--text-strong);
  }

  /* ---- Contact ---- */
  .section--close { background: var(--bg-raised); border-top: 1px solid var(--hairline); }
  .contact-layout {
    display: grid;
    gap: var(--space-l);
  }
  @media (min-width: 52rem) {
    .contact-layout {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      gap: var(--space-xl);
      align-items: center;
    }
  }
  .contact-head > * + * { margin-top: var(--space-m); }
  .contact-head h2 { max-width: 20ch; }
  .contact-head :global(.email-contact) { margin-top: var(--space-m); }
  .contact-head .content-body { max-width: var(--measure); }
  .contact-note {
    padding: var(--space-m) var(--space-l);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-lg);
    background: var(--bg);
  }
  .contact-note h3 {
    margin: 0 0 var(--space-xs);
    font-family: var(--font-body);
    font-size: var(--step-0);
    font-weight: 620;
  }
  .contact-note p { margin: 0; }
</style>
