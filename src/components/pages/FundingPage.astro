---
import Base from '../../layouts/Base.astro';
import PageHeader from '../PageHeader.astro';
import Icon from '../Icon.astro';
import DeadlineChip from '../DeadlineChip.astro';
import { PILOT_INTRO, PILOT_APPLICATION_URL, PILOT_DEADLINE, PAST_CALLS, isCallClosed } from '../../data/pilot-call';
import { LINKS } from '../../data/content';
import { getDict } from '../../i18n';
import { localePath, type Locale } from '../../i18n';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const intro = PILOT_INTRO[locale];
const join = getDict(locale).join;
const closed = isCallClosed();
---
<Base locale={locale} title={intro.funding + ' | Caligo'} description={intro.description} page="/funding">
  <PageHeader title={intro.funding} />
  <section id="funding-opportunities" class="section section--panel" aria-labelledby="funding-call-title">
    <div class="container-wide">
      <div class="funding-layout">
        <div class="funding-summary ink-card ink-card--rose" data-card="link">
          <h2 id="funding-call-title" class="content-heading">{intro.call}</h2>
          <p class="content-body" data-when-call="open" hidden={closed}>{intro.description}</p>
          <p class="content-body" data-when-call="open" hidden={closed}>{intro.coverage}</p>
          <p class="content-body" data-when-call="closed" hidden={!closed}>{intro.descriptionClosed}</p>
          <p class="funding-deadline content-body"><span class="funding-deadline-label">{intro.deadline}</span><strong class="funding-date"><time datetime={PILOT_DEADLINE}>{intro.date}</time></strong></p>
          <DeadlineChip locale={locale} />
          <div class="funding-open" data-when-call="open" hidden={closed}>
            {PILOT_APPLICATION_URL ? (
              <a class="btn btn--primary card-link" href={PILOT_APPLICATION_URL} target="_blank" rel="external noopener">{intro.apply}<Icon name="external" /></a>
            ) : (
              <p class="content-meta">{intro.pending}</p>
            )}
            <p class="content-meta">{intro.share}</p>
          </div>
          <div class="funding-closed" data-when-call="closed" hidden={!closed}>
            <p class="content-body">{intro.closedNote}</p>
            <a class="btn btn--primary card-link" href={LINKS.joinForm} target="_blank" rel="noopener noreferrer">{join.cta}<Icon name="external" /></a>
          </div>
        </div>
        <div class="funding-conditions">
          <h3 class="content-heading">{intro.eligibility}</h3>
          <ul class="content-body">{intro.conditions.map((condition) => <li>{condition}</li>)}</ul>
          <a class="text-link" href={localePath(locale, '/projects') + '#proposed-projects'}>{intro.check}<Icon name="arrow-right" /></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="past-calls-title">
    <div class="container-wide">
      <h2 id="past-calls-title" class="content-heading">{intro.past}</h2>
      <ul class="past-calls" role="list">
        {PAST_CALLS.map((call) => (
          <li class="past-call ink-card ink-card--flat">
            <div class="past-call-when">
              <DeadlineChip locale={locale} deadline={call.deadline} />
              <time class="past-call-date mono" datetime={call.deadline}>{call.date[locale]}</time>
            </div>
            <h3>{call.name[locale]}</h3>
            <p class="content-body">{call.summary[locale]}</p>
            <p class="content-body">{call.coverage[locale]}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

</Base>
<style>
  .past-calls { list-style: none; padding: 0; display: grid; gap: var(--space-m); margin-top: var(--space-m); max-width: 44rem; }
  .past-call { display: grid; gap: var(--space-2xs); padding: var(--space-m); }
  .past-call-when { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem 0.7rem; margin-bottom: 0.35rem; }
  .past-call-date { font-size: var(--step--2); color: var(--text-muted); }
  .past-call h3 { margin: 0; font-family: var(--font-body); font-size: var(--step-0); font-weight: 650; }
  .past-call p { margin: 0; }
  .funding-layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--space-xl); margin-top: var(--space-m); }
  .funding-summary { display: grid; align-content: start; justify-items: start; gap: var(--space-s); }
  .funding-summary { padding: clamp(1.25rem, 2.6vw, 2rem); }
  .funding-deadline { display: grid; gap: 0.15rem; padding-block: var(--space-xs) 0; }
  .funding-deadline-label { font-family: var(--font-mono); font-size: var(--step--2); letter-spacing: 0.08em; text-transform: uppercase; }
  .funding-date { font-family: var(--font-display); font-size: var(--step-2); font-weight: 700; letter-spacing: -0.02em; line-height: 1.15; }
  .funding-open, .funding-closed { display: grid; justify-items: start; gap: var(--space-s); }
  .funding-open[hidden], .funding-closed[hidden] { display: none; }
  .funding-conditions ul { padding-left: 1.25rem; margin-block: var(--space-m); }
  .funding-conditions li + li { margin-top: var(--space-s); }

  @media (max-width: 48rem) {
    .funding-layout { grid-template-columns: 1fr; gap: var(--space-l); }
  }
</style>
