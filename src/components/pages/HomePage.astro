---
import Base from '../../layouts/Base.astro';
import CopyEmail from '../CopyEmail.astro';
import DiscordButton from '../DiscordButton.astro';
import { LINKS } from '../../data/content';
import HeroMedia from '../HeroMedia.astro';
import LeadershipGrid from '../LeadershipGrid.astro';
import { ABOUT_FEEDBACK } from '../../data/about-feedback';
import { pick } from '../../data/initiative';
import Icon from '../Icon.astro';
import CommunityStats from '../CommunityStats.astro';
import Timeline from '../Timeline.astro';
import NetworkMap from '../NetworkMap.astro';
import { getDict, localePath, type Locale } from '../../i18n';
import { getMedia } from '../../data/records';
import { italicizeSpecies } from '../../data/content';
import TierDiagram from '../TierDiagram.astro';
import VoucherLink from '../VoucherLink.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getDict(locale);
const h = t.home;
const base = import.meta.env.BASE_URL;
const TIER_KINDS = ['barcode', 'resequencing', 'reference'] as const;

const heroMedia = getMedia('hero-caligo-tambopata');
if (!heroMedia) {
  throw new Error("HomePage: missing 'hero-caligo-tambopata' media record.");
}

const desktopSrcset = [
  { width: 800,  height: 451,  path: `${base}media/hero/caligo-tambopata-800w.jpg` },
  { width: 1200, height: 677,  path: `${base}media/hero/caligo-tambopata-1200w.jpg` },
  { width: 1600, height: 902,  path: `${base}media/hero/caligo-tambopata-1600w.jpg` },
  { width: 2400, height: 1354, path: `${base}media/hero/caligo-tambopata-2400w.jpg` },
] as const;
---

<Base locale={locale} title={h.metaTitle} description={h.metaDescription} page="/">

  <!-- ====================== H1 — Cinematic hero ====================== -->
  <section id="overview" class="hero-cinematic" aria-labelledby="hero-title">
    <span id="h1" hidden aria-hidden="true" data-legacy-anchor="h1" />
    <div class="hero-media-frame">
      <HeroMedia
        mediaId="hero-caligo-tambopata"
        locale={locale}
        kind="photo"
        desktopSrcset={desktopSrcset}
        hideCaption
      />
    </div>

    <div class="hero-overlay">
      <div class="container-wide hero-overlay-inner">
        <div class="hero-copy">
          <p class="hero-eyebrow mono">{h.hero.kicker}</p>
          <h1 id="hero-title" class="hero-title">{h.hero.title}{' '}<em>{h.hero.focus}</em></h1>
          <p class="hero-tagline">{h.hero.body}</p>
          <div class="hero-actions">
            <a class="btn hero-btn-primary" href={localePath(locale, '/science')}>
              {h.hero.scienceAction}<Icon name="arrow-right" />
            </a>
            <a class="btn hero-btn-ghost" href={localePath(locale, '/projects')}>
              {h.hero.projectsAction}
            </a>
          </div>
        </div>
      </div>
    </div>

    <p class="hero-attribution mono">
      {heroMedia.credit[locale]}
      {' · '}
      <a target="_blank" href={heroMedia.sourceItemPage} rel="external noopener">{t.mediaViewer.sourceLinkLabel}</a>
      {' · '}
      <a target="_blank" href={heroMedia.licenceUrl} rel="license external noopener">{heroMedia.licence}</a>
    </p>
  </section>

  <!-- ==================== STAT BAR — network metrics ==================== -->
  <section class="section section--tight stat-bar-section">
    <div class="container-wide">
      <CommunityStats locale={locale} />
    </div>
  </section>

  <!-- ====================== H2 — Vision ======================
       Nicol's vision line from the Draft Vision and Governance document,
       set as an editorial headline in the hero's serif-accent style. Keeps
       the old #why-lepidoptera anchor. -->
  <section id="why-lepidoptera" class="section vision" aria-labelledby="vision-title">
    <div class="container-wide vision-layout">
      <p class="vision-kicker">{h.vision.kicker}</p>
      <h2 id="vision-title" class="vision-statement">{h.vision.statement}{' '}<em>{h.vision.statementFocus}</em></h2>
      <div class="vision-lead">
        <p class="lead">{h.vision.lead}</p>
        <a class="text-link" href={localePath(locale, '/about')}>{t.cta.readVision}<Icon name="arrow-right" /></a>
      </div>
      <div class="vision-body">
        {h.vision.body.map((para) => <p>{para}</p>)}
      </div>
    </div>
  </section>

  <!-- ====================== H3 — Three tiers of genomic data ======================
       From the Draft Vision and Governance document. Each card carries a
       didactic diagram (TierDiagram) that plays once in view. -->
  <section id="building" class="section section--panel tiers" aria-labelledby="tiers-title">
    <span id="tiers" hidden aria-hidden="true" />
    <div class="container-wide">
      <div class="tiers-head">
        <h2 id="tiers-title">{h.tiers.heading}</h2>
        <p class="lead">{h.tiers.intro}</p>
      </div>
      <ol class="tier-list" role="list">
        {h.tiers.items.map((item, i) => (
          <li class="tier-card">
            <TierDiagram locale={locale} kind={TIER_KINDS[i]} />
            <div class="tier-copy">
              <p class="tier-label mono">{h.tiers.tierLabel} {i + 1}</p>
              <h3 class="tier-title">{item.title}</h3>
              <p class="tier-body">{item.body}</p>
            </div>
          </li>
        ))}
      </ol>
      <figure class="principle">
        <div class="principle-art"><VoucherLink locale={locale} /></div>
        <blockquote class="principle-quote">
          <p>{h.tiers.principle}</p>
        </blockquote>
        <figcaption class="principle-label mono">{h.tiers.principleLabel}</figcaption>
      </figure>
    </div>
  </section>

  <!-- ====================== Bogotá proof point ====================== -->
  <section id="bogota" class="section proof" aria-labelledby="proof-title">
    <div class="container-wide proof-layout">
      <div class="proof-copy">
        <p class="proof-date mono">{h.proof.date}</p>
        <div class="proof-headline">
          <span class="proof-numeral" aria-hidden="true">8</span>
          <h2 id="proof-title" set:html={italicizeSpecies(h.proof.heading)} />
        </div>
        <p class="lead proof-body">{h.proof.body}</p>
        <a class="text-link" href={`${localePath(locale, '/projects')}#heliconius`}><span set:html={italicizeSpecies(h.proof.link)} /><Icon name="arrow-right" /></a>
      </div>
      <figure class="proof-plate">
        <span class="proof-pin" aria-hidden="true"></span>
        <img
          src={`${base}media/network/bogota-workshop-sequencer.jpg`}
          width="1100"
          height="1487"
          alt={h.proof.photoAlt}
          loading="lazy"
          decoding="async"
        />
        <figcaption class="proof-plate-label mono">
          <span>{h.proof.plateLabel}</span>
          <span>{h.proof.photoCredit}</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- ====================== H4 — Leadership team ======================
       Requested by Nicol on 27 September 2026 in place of the four research
       questions, which remain on Science and Pilot projects. The legacy
       anchors keep old links to this part of the page working. -->
  <section id="leadership" class="section section--panel" aria-labelledby="leadership-title">
    <span id="questions" hidden aria-hidden="true" />
    <span id="h4" hidden aria-hidden="true" data-legacy-anchor="h4" />
    <span id="proposed-pilots" hidden aria-hidden="true" />
    <span id="h5" hidden aria-hidden="true" data-legacy-anchor="h5" />
    <div class="container-wide">
      <h2 id="leadership-title">{pick(ABOUT_FEEDBACK.network.leadershipHeading, locale)}</h2>
      <p class="lead">{pick(ABOUT_FEEDBACK.network.leadershipIntro, locale)}</p>
      <LeadershipGrid locale={locale} />
    </div>
  </section>

  <!-- ====================== Network map ====================== -->
  <section id="network" class="section network-section" aria-labelledby="network-map-title">
    <div class="container-wide">
      <NetworkMap locale={locale} />
    </div>
  </section>

  <!-- ====================== H5 — Recent and upcoming activity ====================== -->
  <section id="activity" class="section section--panel" aria-labelledby="activity-title">
    <div class="container-wide activity-layout">
      <div class="activity-intro">
        <p class="section-eyebrow mono">{h.activity.eyebrow}</p>
        <h2 id="activity-title">{h.activity.heading}</h2>
        <p class="lead">{h.activity.intro}</p>
      </div>
      <Timeline locale={locale} compact />
    </div>
  </section>

  <!-- ====================== H6 — Participate + brand close ====================== -->
  <section id="discover-caligo" class="section section--close" aria-labelledby="h6-title">
    <span id="h6" hidden aria-hidden="true" data-legacy-anchor="h6" />
    <div class="container-wide close-layout">
      <div class="close-copy">
        <h2 id="h6-title">{h.closing.title}</h2>
        <p class="lead close-body">{h.closing.body}</p>
        <div class="close-actions">
          <a class="btn btn--primary" href={LINKS.joinForm} target="_blank" rel="noopener noreferrer">
            {t.join.cta}<Icon name="external" />
          </a>
          <DiscordButton locale={locale} />
          <CopyEmail locale={locale} />
        </div>
      </div>
    </div>
  </section>
</Base>

<style>

  /* ---- Scroll margins for semantic + legacy anchors ---- */
  #overview, #from-organism-to-genome, #building, #bogota, #why-lepidoptera,
  #leadership, #questions, #proposed-pilots, #activity, #discover-caligo,
  #h1, #h2, #h3, #h4, #h5, #h6 { scroll-margin-top: 5rem; }

  /* The stat bar and the vision share one background, so they need only
     the vision's top gap. */
  .stat-bar-section {
    padding-bottom: 0;
  }

  /* ---- H1 Cinematic hero ---- */
  .hero-cinematic {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: clamp(34rem, 56.42vw, 48rem);
    background: #000;
    border-bottom: 1px solid var(--hairline);
  }
  .hero-media-frame {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .hero-media-frame :global(.hero-media) {
    width: 100%;
    height: 100%;
    margin: 0;
  }
  .hero-media-frame :global(.hero-media picture),
  .hero-media-frame :global(.hero-media img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    display: block;
  }
  .hero-overlay {
    position: relative;
    z-index: 2;
    min-height: inherit;
    display: flex;
    align-items: flex-end;
    padding-block: clamp(2rem,6vh,4rem) clamp(2.5rem,8vh,5rem);
  }
  .hero-overlay-inner { width: min(100% - 2.5rem, var(--container-wide)); }
  .hero-copy {
    max-width: 40rem;
    margin-left: auto;
    color: #F6F7F3;
  }
  .hero-eyebrow {
    margin: 0;
    font-size: var(--step--2);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: color-mix(in oklab, #F6F7F3 78%, transparent);
    text-shadow: 0 1px 6px rgba(0,0,0,0.45);
  }
  .hero-title {
    margin-top: var(--space-s);
    font-family: var(--font-display);
    font-size: clamp(1.85rem, 3.3vw, 3.25rem);
    font-weight: 560;
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: #F6F7F3;
    max-width: 24ch;
    text-wrap: balance;
    text-shadow: 0 1px 16px rgba(0,0,0,0.45);
  }
  .hero-tagline {
    margin-top: var(--space-m);
    max-width: 44ch;
    font-size: clamp(1rem, 1.2vw, 1.2rem);
    line-height: 1.5;
    color: color-mix(in oklab, #F6F7F3 92%, transparent);
    text-shadow: 0 1px 12px rgba(0,0,0,0.5);
  }
  .hero-actions {
    margin-top: var(--space-l);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
  }
  .hero-btn-primary {
    background: #F6F7F3;
    color: #262524;
    border-color: transparent;
  }
  .hero-btn-primary:hover { background: #FFFFFF; color: #1a1a1a; }
  .hero-btn-ghost {
    background: transparent;
    color: #F6F7F3;
    border: 1px solid color-mix(in oklab, #F6F7F3 45%, transparent);
  }
  .hero-btn-ghost:hover {
    background: color-mix(in oklab, #F6F7F3 12%, transparent);
    border-color: #F6F7F3;
    color: #F6F7F3;
  }
  .hero-attribution {
    position: absolute;
    z-index: 3;
    bottom: 0.75rem;
    right: clamp(1rem, 3vw, 1.6rem);
    margin: 0;
    max-width: 44ch;
    text-align: right;
    font-size: 0.75rem;
    line-height: 1.4;
    color: color-mix(in oklab, #F6F7F3 80%, transparent);
    text-shadow: 0 1px 4px rgba(0,0,0,0.6);
    pointer-events: auto;
  }
  .hero-attribution a {
    color: color-mix(in oklab, #F6F7F3 80%, transparent);
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, #F6F7F3 30%, transparent);
    text-underline-offset: 0.15em;
  }
  .hero-attribution a:hover { color: #F6F7F3; text-decoration-color: currentColor; }
  @media (min-width: 60.001rem) {
    /*
      Shift the photograph left so the butterfly's head clears the text
      column. The source is 2400x1354 (1.77) and the hero renders at almost
      exactly that aspect, so `object-fit: cover` crops vertically and
      `object-position` has no horizontal room to pan — moving the subject
      requires actually widening the rendered image and pulling it left.
      12% is enough to clear the head at every desktop width without
      cropping into the wing pattern.
    */
    .hero-media-frame :global(.hero-media img) {
      width: 112%;
      max-width: none;
      margin-left: -12%;
    }

    /* Start beyond the specimen; use the remaining dark field for copy. */
    .hero-overlay-inner {
      width: 100%;
      margin-inline: 0;
      padding-inline: 60% clamp(1.25rem, 3vw, 4rem);
    }
    .hero-copy {
      max-width: none;
      margin-left: 0;
    }
  }
  @media (max-width: 60rem) {
    /* Mobile hero — translate the desktop's horizontal composition into a
       vertical one: photograph first, then a dedicated dark copy field. */
    .hero-cinematic {
      min-height: auto;
      background: #000;
    }
    .hero-media-frame {
      position: relative;
      inset: auto;
      height: auto;
      aspect-ratio: 2400 / 1354;
    }
    .hero-overlay {
      min-height: auto;
      align-items: flex-start;
      padding-block: 0 1rem;
    }
    .hero-copy {
      max-width: 100%;
      margin-left: 0;
    }
    .hero-eyebrow {
      font-size: 0.68rem;
      line-height: 1.4;
    }
    .hero-title {
      margin-top: 0.55rem;
      max-width: 20ch;
      font-size: clamp(1.75rem, 7.2vw, 2.15rem);
      line-height: 1.06;
      text-wrap: pretty;
    }
    .hero-tagline {
      margin-top: 0.9rem;
      max-width: 38ch;
      font-size: 0.94rem;
      line-height: 1.48;
    }
    .hero-actions {
      margin-top: 1.1rem;
      display: grid;
      grid-template-columns: 1fr;
      gap: 0.55rem;
    }
    .hero-actions .btn {
      width: 100%;
      min-height: 2.8rem;
      justify-content: space-between;
      padding: 0.7rem 1rem;
      font-size: 0.9rem;
    }
    .hero-attribution {
      position: relative;
      inset: auto;
      margin: 0;
      padding: 0 1rem 0.85rem;
      max-width: none;
      text-align: left;
      font-size: 0.72rem;
      line-height: 1.4;
      color: rgba(246,247,243,0.8);
    }
  }

  /* ---- Common section rhythm ---- */
  .section h2 {
    max-width: 32ch;
    font-size: clamp(1.75rem, 1.55rem + 0.8vw, 2.25rem);
  }
  .section .lead { max-width: var(--measure); }
  .section .lead {
    font-size: clamp(1rem, 0.96rem + 0.16vw, 1.125rem);
    line-height: 1.55;
  }
  .section-eyebrow {
    margin: 0;
    font-size: var(--step--2);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-faint);
  }


  /* ---- H2 Vision: editorial headline in the hero's serif-accent style ---- */
  .vision { padding-block: clamp(3.5rem, 7vw, 6rem) clamp(3rem, 6vw, 5rem); }
  .vision-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    column-gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }
  .section > .vision-layout > * + * { margin-top: 0; }
  .vision-kicker {
    grid-column: 1 / -1;
    margin: 0;
    color: var(--text-muted);
    font-size: var(--step-0);
  }
  .section .vision-statement {
    grid-column: 1 / -1;
    margin: var(--space-s) 0 var(--space-l);
    max-width: 19ch;
    font-size: clamp(2.3rem, 1.3rem + 4vw, 5rem);
    font-weight: 440;
    line-height: 1.03;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }
  .vision-statement em {
    font-family: Georgia, 'Times New Roman', serif;
    font-weight: 400;
    letter-spacing: -0.03em;
    color: var(--text-muted);
  }
  .vision-lead > * + * { margin-top: var(--space-m); }
  .section .vision-lead .lead {
    color: var(--text-strong);
    font-size: clamp(1.1rem, 1rem + 0.45vw, 1.35rem);
    line-height: 1.45;
    max-width: 34ch;
  }
  .vision-body { padding-top: 0.2rem; }
  .vision-body p {
    margin: 0;
    max-width: 52ch;
    color: var(--text-muted);
    font-size: clamp(1rem, 0.96rem + 0.16vw, 1.125rem);
    line-height: 1.55;
  }
  .vision-body p + p { margin-top: var(--space-s); }
  @media (max-width: 48rem) {
    .vision-layout { grid-template-columns: 1fr; }
    .vision-body { margin-top: var(--space-l); }
  }

  /* ---- H3 Three tiers of genomic data ---- */
  .tiers-head > * + * { margin-top: var(--space-s); }
  .tiers-head .lead { color: var(--text-muted); }
  .tier-list {
    list-style: none;
    padding: 0;
    margin: var(--space-l) 0 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 1.6vw, 1.5rem);
  }
  .tier-card {
    min-width: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--bg);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
  }
  .tier-copy { padding: var(--space-s) var(--space-m) var(--space-m); }
  .tier-label {
    margin: 0;
    font-size: var(--step--2);
    letter-spacing: 0.06em;
    color: var(--accent);
  }
  .tier-title {
    margin: 0.3rem 0 0;
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 560;
    letter-spacing: -0.015em;
    color: var(--text-strong);
  }
  .tier-body {
    margin: 0.5rem 0 0;
    font-size: var(--step-0);
    line-height: 1.55;
    color: var(--text-muted);
  }
  @media (max-width: 60rem) {
    .tier-list { grid-template-columns: 1fr; max-width: 34rem; }
  }

  .principle {
    display: grid;
    grid-template-columns: minmax(12rem, 17rem) minmax(0, 1fr);
    grid-template-areas: 'art quote' 'art label';
    column-gap: clamp(1.5rem, 4vw, 3.5rem);
    row-gap: var(--space-xs);
    align-items: center;
    margin: var(--space-xl) 0 0;
    padding-top: var(--space-l);
    border-top: 1px solid var(--hairline);
  }
  .principle-art { grid-area: art; }
  .principle-quote { grid-area: quote; margin: 0; align-self: end; }
  .principle-quote p {
    margin: 0;
    max-width: 40ch;
    font-family: Georgia, 'Times New Roman', serif;
    font-style: italic;
    font-size: clamp(1.3rem, 1.05rem + 1vw, 1.95rem);
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--text-strong);
    text-wrap: pretty;
  }
  .principle-label {
    grid-area: label;
    align-self: start;
    margin: 0;
    font-size: var(--step--2);
    letter-spacing: 0.06em;
    color: var(--text-faint);
  }
  @media (max-width: 48rem) {
    .principle {
      grid-template-columns: 1fr;
      grid-template-areas: 'quote' 'label' 'art';
      row-gap: var(--space-s);
    }
    .principle-art { max-width: 17rem; margin-top: var(--space-s); }
  }

  /* ---- Bogotá proof point (static) ---- */
  .proof-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(15rem, 0.65fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
  }
  .proof-copy > * + * { margin-top: var(--space-m); }
  .proof-date {
    margin: 0;
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    color: var(--accent);
  }
  .proof-copy .proof-headline {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    column-gap: clamp(1rem, 2.5vw, 2rem);
    margin-top: var(--space-s);
  }
  .proof-numeral {
    font-family: var(--font-display);
    font-size: clamp(6rem, 4rem + 7vw, 10.5rem);
    font-weight: 300;
    line-height: 0.8;
    letter-spacing: -0.06em;
    color: var(--accent);
  }
  .section .proof-headline h2 {
    margin: 0;
    max-width: 18ch;
    font-size: clamp(1.6rem, 1.3rem + 1.2vw, 2.45rem);
    line-height: 1.12;
    text-wrap: balance;
  }
  .proof-body { color: var(--text-muted); }
  .proof-plate {
    position: relative;
    justify-self: end;
    width: 100%;
    max-width: 23rem;
    margin: 0;
    padding: 0.55rem 0.55rem 0;
    background: var(--bg-raised);
    border: 1px solid var(--hairline);
    box-shadow: 0 18px 30px -26px color-mix(in oklab, var(--text-strong) 45%, transparent);
    transform: rotate(0.8deg);
  }
  .proof-plate img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1100 / 1300;
    object-fit: cover;
    object-position: 50% 62%;
  }
  .proof-pin {
    position: absolute;
    z-index: 1;
    top: -0.3rem;
    left: 50%;
    width: 0.62rem;
    height: 0.62rem;
    margin-left: -0.31rem;
    border-radius: 50%;
