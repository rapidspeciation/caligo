---
import Base from '../../layouts/Base.astro';
import CopyEmail from '../CopyEmail.astro';
import DiscordButton from '../DiscordButton.astro';
import { LINKS } from '../../data/content';
import HeroMedia from '../HeroMedia.astro';
import LeadershipGrid from '../LeadershipGrid.astro';
import { ABOUT_FEEDBACK } from '../../data/about-feedback';
import { pick } from '../../data/initiative';
import Icon from '../Icon.astro';
import CommunityStats from '../CommunityStats.astro';
import Timeline from '../Timeline.astro';
import NetworkMap from '../NetworkMap.astro';
import { getDict, localePath, type Locale } from '../../i18n';
import { getMedia } from '../../data/records';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getDict(locale);
const h = t.home;
const base = import.meta.env.BASE_URL;

const heroMedia = getMedia('hero-caligo-tambopata');
if (!heroMedia) {
  throw new Error("HomePage: missing 'hero-caligo-tambopata' media record.");
}

const desktopSrcset = [
  { width: 800,  height: 451,  path: `${base}media/hero/caligo-tambopata-800w.jpg` },
  { width: 1200, height: 677,  path: `${base}media/hero/caligo-tambopata-1200w.jpg` },
  { width: 1600, height: 902,  path: `${base}media/hero/caligo-tambopata-1600w.jpg` },
  { width: 2400, height: 1354, path: `${base}media/hero/caligo-tambopata-2400w.jpg` },
] as const;
---

<Base locale={locale} title={h.metaTitle} description={h.metaDescription} page="/">

  <!-- ====================== H1 — Cinematic hero ====================== -->
  <section id="overview" class="hero-cinematic" aria-labelledby="hero-title">
    <span id="h1" hidden aria-hidden="true" data-legacy-anchor="h1" />
    <div class="hero-media-frame">
      <HeroMedia
        mediaId="hero-caligo-tambopata"
        locale={locale}
        kind="photo"
        desktopSrcset={desktopSrcset}
        hideCaption
      />
    </div>

    <div class="hero-overlay">
      <div class="container-wide hero-overlay-inner">
        <div class="hero-copy">
          <p class="hero-eyebrow mono">{h.hero.kicker}</p>
          <h1 id="hero-title" class="hero-title">{h.hero.title}{' '}<em>{h.hero.focus}</em></h1>
          <p class="hero-tagline">{h.hero.body}</p>
          <div class="hero-actions">
            <a class="btn hero-btn-primary" href={`${localePath(locale, '/participate')}#join`}>
              {t.join.ctaSecondary}<Icon name="arrow-right" />
            </a>
            <div class="hero-more">
              <a class="hero-text-link" href={localePath(locale, '/science')}>
                <span class="hero-text-label">{h.hero.scienceAction}</span><Icon name="arrow-right" />
              </a>
              <a class="hero-text-link" href={localePath(locale, '/projects')}>
                <span class="hero-text-label">{h.hero.projectsAction}</span><Icon name="arrow-right" />
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <p class="hero-attribution">
      {heroMedia.credit[locale]}
      {' · '}
      <a target="_blank" href={heroMedia.sourceItemPage} rel="external noopener">{t.mediaViewer.sourceLinkLabel}</a>
      {' · '}
      <a target="_blank" href={heroMedia.licenceUrl} rel="license external noopener">{heroMedia.licence}</a>
    </p>
  </section>

  <!-- ==================== STAT BAR — network metrics ==================== -->
  <section class="section section--tight stat-bar-section">
    <div class="container-wide">
      <CommunityStats locale={locale} />
    </div>
  </section>

  <!-- ====================== H2 — Why butterflies and moths ======================
       Psyche's second homepage section. This copy already existed under
       `home.intro` but was rendered on /about/ instead, so the homepage
       never answered "why this group of animals" at all.
  -->
  <section id="why-lepidoptera" class="section" aria-labelledby="h2b-title">
    <div class="container-wide intro-layout">
      <div class="intro-copy">
        <div class="intro-head">
          <h2 id="h2b-title">{h.intro.title}</h2>
          <a class="text-link intro-link" href={localePath(locale, '/about')}>{t.cta.readVision}<Icon name="arrow-right" /></a>
        </div>
        {h.intro.body.map((para) => <p class="lead">{para}</p>)}
      </div>
    </div>
  </section>

  <!-- ====================== H3 — What Caligo is building ====================== -->
  <section id="building" class="section section--panel" aria-labelledby="building-title">
    <div class="container-wide">
      <h2 id="building-title">{h.building.heading}</h2>
      <ul class="rule-list rule-list--numbered building-grid" role="list">
        {h.building.items.map((item, index) => (
          <li class="building-item">
            <span class="rule-index mono" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ====================== H4 — Leadership team ======================
       Requested by Nicol on 27 September 2026 in place of the four research
       questions, which remain on Science and Pilot projects. The legacy
       anchors keep old links to this part of the page working. -->
  <section id="leadership" class="section" aria-labelledby="leadership-title">
    <span id="questions" hidden aria-hidden="true" />
    <span id="h4" hidden aria-hidden="true" data-legacy-anchor="h4" />
    <span id="proposed-pilots" hidden aria-hidden="true" />
    <span id="h5" hidden aria-hidden="true" data-legacy-anchor="h5" />
    <div class="container-wide">
      <h2 id="leadership-title">{pick(ABOUT_FEEDBACK.network.leadershipHeading, locale)}</h2>
      <p class="lead">{pick(ABOUT_FEEDBACK.network.leadershipIntro, locale)}</p>
      <LeadershipGrid locale={locale} />
    </div>
  </section>

  <!-- ====================== Network map ====================== -->
  <section id="network" class="section network-section" aria-labelledby="network-map-title">
    <div class="container-wide">
      <NetworkMap locale={locale} />
    </div>
  </section>

  <!-- ====================== H5 — Recent and upcoming activity ====================== -->
  <section id="activity" class="section section--panel" aria-labelledby="activity-title">
    <div class="container-wide">
      <div class="activity-intro">
        <h2 id="activity-title">{h.activity.heading}</h2>
        <p class="lead">{h.activity.intro}</p>
      </div>
      <Timeline locale={locale} compact />
    </div>
  </section>

  <!-- ====================== H6 — Participate + brand close ====================== -->
  <section id="discover-caligo" class="section section--close" aria-labelledby="h6-title">
    <span id="h6" hidden aria-hidden="true" data-legacy-anchor="h6" />
    <div class="container-wide close-layout">
      <div class="close-copy">
        <h2 id="h6-title">{h.closing.title}</h2>
        <p class="lead close-body">{h.closing.body}</p>
        <div class="close-actions">
          <a class="btn btn--primary" href={LINKS.joinForm} target="_blank" rel="noopener noreferrer">
            {t.join.cta}<Icon name="external" />
          </a>
          <DiscordButton locale={locale} class="btn--ghost" />
          <CopyEmail locale={locale} class="btn--ghost" />
        </div>
      </div>
    </div>
  </section>
</Base>

<style>

  /* ---- Scroll margins for semantic + legacy anchors ---- */
  #overview, #from-organism-to-genome, #building,
  #leadership, #questions, #proposed-pilots, #activity, #discover-caligo,
  #h1, #h2, #h3, #h4, #h5, #h6 { scroll-margin-top: 5rem; }

  /* The stat bar and the introduction share one background, so they need
     only the introduction's top gap. The following priority panel changes
     colour, so retain a smaller closing gap before that visible boundary. */
  /* Heading, intro and both rows of leaders in one laptop screen. */
  @media (min-width: 82rem) {
    #leadership { padding-block: var(--space-l); }
    #leadership .lead { margin-top: var(--space-xs); }
  }

  .stat-bar-section {
    padding-bottom: 0;
  }
  #why-lepidoptera {
    padding-bottom: var(--space-l);
  }

  /* ---- H1 Cinematic hero ---- */
  .hero-cinematic {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: clamp(34rem, 56.42vw, 48rem);
    background: #000;
    border-bottom: 1px solid var(--hairline);
  }
  .hero-media-frame {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .hero-media-frame :global(.hero-media) {
    width: 100%;
    height: 100%;
    margin: 0;
  }
  .hero-media-frame :global(.hero-media picture),
  .hero-media-frame :global(.hero-media img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    display: block;
  }
  .hero-overlay {
    position: relative;
    z-index: 2;
    min-height: inherit;
    display: flex;
    align-items: flex-end;
    padding-block: clamp(2rem,6vh,4rem) clamp(2.5rem,8vh,5rem);
  }
  .hero-overlay-inner { width: min(100% - 2.5rem, var(--container-wide)); }
  .hero-copy {
    max-width: 40rem;
    margin-left: auto;
    color: #F6F7F3;
  }
  .hero-eyebrow {
    margin: 0;
    font-size: var(--step--2);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: color-mix(in oklab, #F6F7F3 78%, transparent);
    text-shadow: 0 1px 6px rgba(0,0,0,0.45);
  }
  .hero-title {
    margin-top: var(--space-s);
    font-family: var(--font-display);
    font-size: clamp(1.85rem, 3.3vw, 3.25rem);
    font-weight: 560;
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: #F6F7F3;
    max-width: 24ch;
    text-wrap: balance;
    text-shadow: 0 1px 16px rgba(0,0,0,0.45);
  }
  .hero-tagline {
    margin-top: var(--space-m);
    max-width: 44ch;
    font-size: clamp(1rem, 1.2vw, 1.2rem);
    line-height: 1.5;
    color: color-mix(in oklab, #F6F7F3 92%, transparent);
    text-shadow: 0 1px 12px rgba(0,0,0,0.5);
  }
  .hero-actions {
    margin-top: var(--space-l);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
  }
  /* Reading on: two quieter links, a step lighter than the button and set
     a little apart from it. */
  .hero-more {
    display: grid;
    justify-items: start;
    gap: 0.45rem;
    margin-top: 1rem;
  }
  /* Text in one column, the arrow in its own fixed column beside the first
     line, so a label that wraps on a phone stays a tidy block. */
  .hero-text-link {
    display: grid;
    grid-template-columns: minmax(0, auto) 1em;
    column-gap: 0.4em;
    align-items: start;
    /* Uses the full text panel and sits a touch below body size so the
       longer question fits one line at desktop widths. */
    max-width: 100%;
    font-size: 0.9em;
    /* A warm grey a step below the button's white: still a clear,
       underlined link (over 7:1 on the darkened photo). */
    color: #D8D1C5;
    font-weight: 420;
    line-height: 1.35;
    text-decoration: none;
    text-shadow: 0 1px 8px rgba(0,0,0,0.5);
  }
  .hero-text-label {
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, #D8D1C5 45%, transparent);
    text-underline-offset: 0.3em;
  }
  .hero-text-link:hover { color: #FFFFFF; }
  .hero-text-link:hover .hero-text-label { text-decoration-color: currentColor; }
  .hero-text-link :global(svg) { width: 1em; height: 1em; margin-top: 0.18em; }
  /* Phones, where the question wraps: both arrows share one column at the
     right of the text, so the two links read as a matched pair. */
  @media (max-width: 40rem) {
    .hero-more { grid-template-columns: minmax(0, 1fr) 1em; column-gap: 0.4em; justify-items: stretch; }
    .hero-text-link { grid-column: 1 / -1; grid-template-columns: subgrid; }
  }
  .hero-attribution {
    position: absolute;
    z-index: 3;
    bottom: 0.75rem;
    right: clamp(1rem, 3vw, 1.6rem);
    margin: 0;
    max-width: 44ch;
    text-align: right;
    font-size: 0.75rem;
    line-height: 1.4;
    color: color-mix(in oklab, #F6F7F3 80%, transparent);
    text-shadow: 0 1px 4px rgba(0,0,0,0.6);
    pointer-events: auto;
  }
  .hero-attribution a {
    color: color-mix(in oklab, #F6F7F3 80%, transparent);
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, #F6F7F3 30%, transparent);
    text-underline-offset: 0.15em;
  }
  .hero-attribution a:hover { color: #F6F7F3; text-decoration-color: currentColor; }
  @media (min-width: 60.001rem) {
    /*
      Shift the photograph left so the butterfly's head clears the text
      column. The source is 2400x1354 (1.77) and the hero renders at almost
      exactly that aspect, so `object-fit: cover` crops vertically and
      `object-position` has no horizontal room to pan — moving the subject
      requires actually widening the rendered image and pulling it left.
      12% is enough to clear the head at every desktop width without
      cropping into the wing pattern.
    */
    .hero-media-frame :global(.hero-media img) {
      width: 112%;
      max-width: none;
      margin-left: -12%;
    }

    /* Start beyond the specimen; use the remaining dark field for copy. */
    .hero-overlay-inner {
      width: 100%;
      margin-inline: 0;
      padding-inline: 60% clamp(1.25rem, 3vw, 4rem);
    }
    .hero-copy {
      max-width: none;
      margin-left: 0;
    }
  }
  @media (max-width: 60rem) {
    /* Mobile hero — translate the desktop's horizontal composition into a
       vertical one: photograph first, then a dedicated dark copy field. */
    .hero-cinematic {
      min-height: auto;
      background: #000;
    }
    .hero-media-frame {
      position: relative;
      inset: auto;
      height: auto;
      aspect-ratio: 2400 / 1354;
    }
    .hero-overlay {
      min-height: auto;
      align-items: flex-start;
      padding-block: 0 1rem;
    }
    .hero-copy {
      max-width: 100%;
      margin-left: 0;
    }
    .hero-eyebrow {
      font-size: 0.68rem;
      line-height: 1.4;
    }
    .hero-title {
      margin-top: 0.55rem;
      max-width: 20ch;
      font-size: clamp(1.75rem, 7.2vw, 2.15rem);
      line-height: 1.06;
      text-wrap: pretty;
    }
    .hero-tagline {
      margin-top: 0.9rem;
      max-width: 38ch;
      font-size: 0.94rem;
      line-height: 1.48;
    }
    .hero-actions {
      margin-top: 1.1rem;
      display: grid;
      grid-template-columns: 1fr;
      gap: 0.55rem;
    }
    .hero-actions .btn {
      width: 100%;
      min-height: 2.8rem;
      justify-content: space-between;
      padding: 0.7rem 1rem;
      font-size: 0.9rem;
    }
    .hero-attribution {
      position: relative;
      inset: auto;
      margin: 0;
      padding: 0 1rem 0.85rem;
      max-width: none;
      text-align: left;
      font-size: 0.72rem;
      line-height: 1.4;
      color: rgba(246,247,243,0.8);
    }
  }

  /* ---- Common section rhythm ---- */
  .section h2 {
    max-width: 32ch;
    /* One section-heading size on every page. */
    font-size: var(--step-2);
  }
  .section .lead { max-width: var(--measure); }
  .section .lead,
  .building-item p {
    font-size: clamp(1rem, 0.96rem + 0.16vw, 1.125rem);
    line-height: 1.55;
  }
  .section-eyebrow {
    margin: 0;
    font-size: var(--step--2);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  /* ---- H3 Initiative priorities ---- */
  .building-grid { margin-top: var(--space-l); }
  .building-item p { margin: var(--space-xs) 0 0; }

  .network-section { border-top: 1px solid var(--hairline); }

  /* ---- H5 Current activity ---- */
  /* Intro above, the timeline across the whole container, so the four
     cards get room for their dates and summaries. */
  .activity-intro > * + * {
    margin-top: var(--space-m);
  }

  /* ---- H6 Participate + brand close ---- */
  .section--close {
    background: var(--bg-inset);
  }
  .close-layout {
    display: block;
  }
  /* This block sits inside .close-layout, not directly in .container-wide,
     so the global section rhythm does not reach it. Restate it locally
     rather than leave the heading flush against its paragraph. */
  .close-copy { min-width: 0; }
  .close-copy > * + * { margin-top: var(--space-m); }
  .close-body { max-width: var(--measure); }
  .close-actions {
    margin-top: var(--space-l);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-m);
  }

  .hero-title { font-size: clamp(2.2rem, 3.9vw, 4.25rem); font-weight: 460; letter-spacing: -.045em; }
  .hero-title em { display: block; margin-top: .18em; font-family: Georgia, 'Times New Roman', serif; font-weight: 400; letter-spacing: -.035em; line-height: 1.08; }
  .hero-overlay { align-items: center; }
  .hero-copy { padding-bottom: 1rem; }
  .hero-actions { gap: .75rem; }
  /* The hero keeps its own quiet buttons: no ink outline or hard shadow
     over the photograph. */
  /* The hero keeps its own quiet button: a pill without the hard shadow
     over the photograph. It still lifts under the pointer. */
  .hero-actions { flex-direction: column; align-items: flex-start; }
  .hero-actions .btn { border-width: 1px; box-shadow: none; }
  .hero-actions .btn:hover { transform: translateY(-2px); box-shadow: 0 6px 16px rgba(0,0,0,0.35); }
  .hero-actions .btn:active { transform: none; box-shadow: none; }
  .hero-attribution { max-width: 48ch; }
  .intro-layout { display: grid; grid-template-columns: 1fr; }
  .intro-copy > * + * { margin-top: var(--space-m); }
  .intro-copy h2 { max-width: 25ch; }
  @media (min-width: 60rem) {
    /* Same two equal columns and divider position as the priorities grid
       below, so both vertical rules line up. */
    .intro-copy { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 0; position: relative; }
    .intro-copy::after { content: ''; position: absolute; inset-block: 0; left: 50%; width: 1px; background: var(--hairline); }
    /* Heading and its link stay together at the top of the left column. */
    .intro-head { grid-column: 1; grid-row: 1 / span 2; align-self: start; padding-right: var(--space-m); }
    .intro-copy .lead { grid-column: 2; padding-left: var(--space-m); }
    .intro-copy .lead:first-of-type { grid-row: 1; margin-top: 0; }
    .intro-copy .lead:last-of-type { grid-row: 2; }
  }
  .intro-head h2 { max-width: 25ch; }
  .intro-link { margin-top: var(--space-s); }
  .section--close { border-top: 1px solid var(--hairline); background: var(--bg); }
  .close-copy h2 { max-width: 25ch; }
  @media (max-width: 60rem) { .hero-title { font-size: clamp(2rem, 5vw, 3rem); max-width: 24ch; } .hero-copy { padding-block: 1.25rem; } .hero-overlay { padding-bottom: .5rem; } }
  @media (max-width: 48rem) { .intro-layout { grid-template-columns: 1fr; gap: 2rem; } }
  /* Phone home: the leadership list and the activity timeline are the
     longest stacks on the page. Same content, tighter cards. */
  @media (max-width: 30rem) {
    #leadership :global(.person-card) {
      grid-template-columns: 5.5rem minmax(0, 1fr);
      column-gap: 0.75rem;
      margin-bottom: var(--space-xs);
      padding: 0.75rem 0.85rem;
    }
    #leadership :global(.person-name) { font-size: var(--step-0); margin-bottom: 0; }
    #leadership :global(.person-role) { font-size: var(--step--1); }
    #leadership :global(.person-content) { gap: 0.2rem; }
    #leadership :global(.person-foot) { margin-top: 0.5rem; }
    #leadership :global(.person-more > .disclosure-summary) { padding-block: 0.55rem; }
  }
  @media (max-width: 40rem) {
    #activity :global(.timeline-list--compact) { --gap: 0.7rem; }
    #activity :global(.timeline-item) { gap: 0.2rem; padding: 0.85rem 0.95rem 0.95rem; }
    #activity :global(.timeline-when) { gap: 0.3rem 0.55rem; margin-bottom: 0.15rem; }
    #activity :global(.timeline-summary) { margin-top: 0.15rem; }
    #activity :global(.timeline-link) { padding-top: 0.35rem; }
    /* The open call is the one thing here to act on now. */
    #activity :global(#event-funding:has([data-when-call='open']:not([hidden])) .timeline-name) { font-size: var(--step-1); }
    #activity :global(#event-funding .timeline-link [data-when-call='open']) { font-weight: 700; }
  }
  /* Phones: a slightly taller band that trims the empty black at the right,
     so the moth's eye and the wing stripes beside it fill the frame. */
  @media (max-width: 40rem) {
    .hero-media-frame { aspect-ratio: auto; height: clamp(13.75rem, 66vw, 16.5rem); }
    .hero-media-frame :global(.hero-media img) { object-position: 42% 62%; }
  }
  @media (min-width: 40rem) and (max-width: 60rem) {
    .hero-tagline { max-width: 65ch; }
    .hero-actions { justify-items: start; }
    .hero-actions .btn { width: auto; }
  }
</style>
