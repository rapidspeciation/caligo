---
import { italicizeSpecies } from '../../data/content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../PageHeader.astro';
import Icon from '../Icon.astro';
import CardIcon, { type CardIconName } from '../CardIcon.astro';
import DeadlineChip from '../DeadlineChip.astro';
import { PILOT_INTRO, isCallClosed } from '../../data/pilot-call';
import MediaCandidateViewer from '../MediaCandidateViewer.astro';
import { getDict, localePath, type Locale } from '../../i18n';
import { PILOTS, getSource, getMediaModule } from '../../data/records';
import { PROJECTS } from '../../data/content';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getDict(locale);

const proj = t.projects as Record<string, unknown>;
const pageTitle =
  (proj.header && typeof (proj.header as Record<string, unknown>).title === 'string'
    ? (proj.header as Record<string, unknown>).title
    : proj.title) as string;
const metaTitle = proj.metaTitle as string;
const metaDescription = proj.metaDescription as string;

const intro = PILOT_INTRO[locale];
const p = t.pilots;
const pp = t.projects.pilotProposal;

const publishedPilots = PILOTS.filter((pilot) => pilot.publish);

const sourcesLabel = locale === 'es' ? 'Fuentes' : 'Sources';

// Map from PILOTS.id to PROJECTS.id for the proposal lookup.
const pilotToProjectId: Record<string, string> = {
  'pilot-heliconius': 'heliconius',
  'pilot-parides':    'parides',
  'pilot-soybean':    'soybean-pests',
  'pilot-panacea':    'panacea',
};

const projectById = new Map(PROJECTS.map((pr) => [pr.id, pr]));

// One icon per reason, in the order of PILOT_INTRO.reasons.
const reasonIcons: readonly CardIconName[] = [
  'capacity', 'workflow', 'training', 'regulation', 'data', 'budget', 'results', 'connect',
];
const callClosed = isCallClosed();
---

<Base locale={locale} title={metaTitle} description={metaDescription} page="/projects">
  <div id="overview">
    <PageHeader title={pageTitle} intro={intro.opening} />
  </div>

  <section class="section pilot-introduction">
    <div class="container-wide">
      <div class="pilot-intro-layout">
        <div class="intro-copy content-body">
          {intro.body.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <aside class="funding-callout ink-card ink-card--rose" data-card="link" aria-labelledby="funding-callout-title">
          <h2 id="funding-callout-title" class="funding-callout-title">{intro.call}</h2>
          <DeadlineChip locale={locale} />
          <p class="content-body" data-when-call="open" hidden={callClosed}>{intro.covered} {intro.logistics}</p>
          <p class="content-body" data-when-call="closed" hidden={!callClosed}>{intro.descriptionClosed}</p>
          <a class="btn btn--primary card-link" href={localePath(locale, '/funding')}><span data-when-call="open" hidden={callClosed}>{intro.apply}</span><span data-when-call="closed" hidden={!callClosed}>{intro.seePast}</span><Icon name="arrow-right" /></a>
        </aside>
      </div>
    </div>
  </section>


  {/*
    container-wide supplies the gutter and the centring. This used to come
    from `section-rail-layout`, which was removed with the sidebar — and
    took the page's left and right margins with it, so the images and
    diagrams sat flush against the viewport edge.
  */}
  <div class="projects-layout container-wide">
    {/* The page title already names the list, so it carries no heading of
        its own; the anchor stays for links from Funding. */}
    <ol id="proposed-projects" class="pilots" aria-label={intro.projects}>
      {
        publishedPilots.map((pilot) => {
          const project = projectById.get(pilotToProjectId[pilot.id]);
          return (
            <li id={pilot.slug} class="pilot ink-card" data-card="toggle">
            <!-- Media: the left column on desktop -->
            <div class="pilot-media card-media">
              {getMediaModule(pilot.id) && (
                <MediaCandidateViewer moduleId={pilot.id} locale={locale} aspectRatio="4 / 3" singleImage sizes="(min-width: 68rem) 20rem, 100vw" />
              )}
            </div>

            <!-- Text: the right column on desktop -->
            <div class="pilot-text">
              <h2 class="pilot-heading content-heading" set:html={italicizeSpecies(pilot.heading[locale])} />

              {pilot.taxon && (
                <p class="pilot-taxon content-meta mono chip">
                  <em>{pilot.taxon}</em>
                </p>
              )}

              <!-- One-sentence research question -->
              <p class="pilot-hook content-lead" set:html={italicizeSpecies(pilot.hook[locale])} />

              <!-- What Caligo proposes to test, and who leads it, side by side on desktop -->
              <div class="pilot-fields">
                <div class="pilot-field">
                  <p class="pilot-field-label content-label">{p.fieldLabels.proposedQuestion}</p>
                  <p class="pilot-field-value content-body" set:html={italicizeSpecies(pilot.proposedQuestion[locale])} />
                </div>

                {project && (
                  <div class="pilot-field pilot-field--leads">
                    <p class="pilot-field-label content-label">{pp.leadsLabel}</p>
                    <p class="pilot-field-value content-body">
                      {project.leads}
                    </p>
                  </div>
                )}
              </div>

            </div>

            <!--
              Published background, starting material and sources share one
              disclosure so each pilot opens on its question and proposal.
              On desktop it closes the text column, beside the photograph.
            -->
            <details class="disclosure pilot-more" data-pilot-more>
              <summary class="disclosure-summary">
                <span class="disclosure-summary-inner">{pp.backgroundLabel}</span>
              </summary>
              <div class="disclosure-body pilot-more-body">
                <p class="pilot-body-text content-body" set:html={italicizeSpecies(pilot.publishedContext[locale])} />
                <div class="pilot-more-side">

                {project && (
                  <div class="pilot-field">
                    <p class="pilot-field-label content-label">{pp.resourcesLabel}</p>
                    <p class="pilot-field-value content-body" set:html={italicizeSpecies(project.resources?.[locale] ?? '')} />
                  </div>
                )}

                <p class="pilot-source-line content-meta">
                  <span class="pilot-source-label content-label">{sourcesLabel}: </span>
                  {pilot.sourceIds.map((sid, i) => {
                    const src = getSource(sid);
                    if (!src) return null;
                    return (
                      <>
                        {i > 0 && ' · '}
                        <a target="_blank" href={src.url} rel="external noopener">{src.shortLabel ?? src.citation}</a>
                      </>
                    );
                  })}
                </p>
                </div>
              </div>
            </details>
            </li>
          );
        })
      }
    </ol>
  </div>

  {/* Why pilots first: the reasons follow the proposals, so the proposals
      come into view sooner. */}
  <section class="section section--panel" aria-labelledby="pilot-purpose">
    <div class="container-wide">
      <h2 id="pilot-purpose" class="content-heading">{intro.why}</h2>
      <ul class="rule-list pilot-reasons" role="list">
        {intro.reasons.map(([title, body], i) => (
          <li class="content-body">
            <CardIcon name={reasonIcons[i]} />
            <div>
              <strong class="rule-title">{title}</strong>
              <p>{body}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<script is:inline>
  /* A link to /projects/#<pilot> arrives for the full proposal, so open
     that pilot's background instead of leaving it collapsed. */
  (function () {
    function openTarget() {
      var id = decodeURIComponent(location.hash.slice(1));
      if (!id) return;
      var target = document.getElementById(id);
      var more = target && target.querySelector('[data-pilot-more]');
      if (more) more.open = true;
    }
    if (!window.__caligoPilotHash) {
      window.__caligoPilotHash = true;
      document.addEventListener('astro:page-load', openTarget);
      window.addEventListener('hashchange', openTarget);
    }
    openTarget();
  })();
</script>

<style>
  .intro-copy { max-width: var(--measure); }
  .intro-copy p + p { margin-top: var(--space-s); }
  .pilot-intro-layout {
    display: grid;
    gap: var(--space-l);
    align-items: start;
  }
  @media (min-width: 60rem) {
    .pilot-intro-layout { grid-template-columns: minmax(0, 1.25fr) minmax(18rem, 0.75fr); gap: clamp(2rem, 5vw, 5rem); }
  }
  .funding-callout {
    display: grid;
    justify-items: start;
    gap: var(--space-s);
    padding: var(--space-l);
  }
  .funding-callout-title {
    margin: 0;
    font-size: var(--step-1);
    line-height: 1.25;
  }
  .funding-callout .btn { margin-top: var(--space-xs); }
  /* Structure and titles come from `.rule-list` (global.css). */
  .pilot-reasons { margin-block: var(--space-m); }
  .pilot-reasons li { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: var(--space-s); align-items: start; }
  .pilot-reasons p { margin-top: var(--space-xs); }
  .pilots { scroll-margin-top: var(--scroll-margin-top); }

  .pilots {
    list-style: none;
    padding: 0;
    margin: var(--space-m) 0 var(--space-xl);
    display: grid;
    gap: var(--space-m);
    min-width: 0;
  }

  /* Each pilot project is one ink card: its photograph framed as a print,
     its question and leads beside it. */
  .pilot {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-s);
    padding: clamp(0.85rem, 1.4vw, 1.1rem);
    scroll-margin-top: var(--scroll-margin-top);
  }
  .pilot-media :global(.mcv-stage) {
    border: var(--ink-w) solid var(--ink-line);
    border-radius: 8px;
    overflow: hidden;
  }

  /* Desktop: a compact row. The photograph and its credit fill the left
     column; question, proposal, leads and the background row fill the
     right, so the next project starts sooner. */
  @media (min-width: 68rem) {
    .pilot {
      grid-template-columns: minmax(0, 20rem) minmax(0, 1fr);
      grid-template-rows: auto 1fr;
      grid-template-areas: 'media text' 'media more';
      column-gap: var(--space-l);
      row-gap: 0;
      align-items: start;
    }
    .pilot-media { grid-area: media; }
    .pilot-text { grid-area: text; }
    /* The background row follows the leads on every card; when the photo
       runs taller, the spare room falls below it, not above. */
    .pilot-more { grid-area: more; align-self: start; margin-top: var(--space-xs); }
    .pilot-more-body {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      column-gap: var(--space-l);
    }
  }

  /* ============================================================
     Media slot
     ============================================================ */
  .pilot-media :global(.media-candidate-viewer) { gap: 0.6rem; }
  .pilot-media :global(.mcv-caption) { gap: 0.25rem; }
  .pilot-media :global(.mcv-caption-text) { font-size: var(--step--1); line-height: 1.45; }
  .pilot-media {
    min-width: 0;
  }
  .pilot-media :global(.mcv-stage) {
    max-height: min(60vh, 26rem);
  }
  .pilot-media :global(img),
  .pilot-media :global(picture) {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  /* ============================================================
     Text slot
     ============================================================ */
  .pilot-text {
    min-width: 0;
    display: grid;
    gap: var(--space-xs);
    align-content: start;
  }

  /* One line for most titles on desktop, three at most on a phone. */
  .pilot-heading {
    max-width: 56ch;
    font-size: clamp(1.3rem, 1.15rem + 0.6vw, 1.75rem);
  }

  /* The taxon pill takes a light wash of its own card's colour. */
  .pilot-taxon {
    width: fit-content;
    --chip-fill: color-mix(in oklab, var(--card-tone) 20%, var(--card));
    border-color: var(--card-tone);
    color: var(--text-strong);
  }
  .pilot-taxon em {
    font-style: italic;
  }

  /* Strong ink at a book weight: the title above is the one heavy block,
     so the labelled question below still reads as the pilot itself. */
  .pilot-hook {
    max-width: var(--measure);
    font-family: var(--font-body);
    font-weight: 450;
  }

  .pilot-body-text {
    max-width: var(--measure);
  }
  .pilot-text :global(.concept-diagram) {
    margin-block: var(--space-xs);
  }

  .pilot-fields {
    display: grid;
    gap: var(--space-xs);
    margin-top: 0.15rem;
  }
  /* Side by side, the two labels share a row, so the values start level
     even when a longer label (Spanish) wraps. */
  @media (min-width: 48rem) {
    .pilot-fields {
      grid-template-columns: minmax(0, 2fr) minmax(12rem, 1fr);
      grid-template-rows: auto auto;
      column-gap: var(--space-l);
      row-gap: 0.15rem;
    }
    .pilot-fields > .pilot-field {
      grid-row: span 2;
      grid-template-rows: subgrid;
      align-items: end;
    }
    .pilot-fields .pilot-field-value { align-self: start; }
  }
  .pilot-field {
    display: grid;
    gap: 0.15rem;
    align-content: start;
  }
  .pilot-field-value { line-height: 1.55; }
  .pilot-field-value {
    max-width: var(--measure);
  }
  /* The background is a plain row closing the card, not a box inside it. */
  .pilot-more { --disclosure-pad-x: 0; }
  .pilot-more > :global(.disclosure-summary) { font-weight: 600; }
  .pilot-more:not([open]) > :global(.disclosure-summary) { border-bottom-color: transparent; }
  /* Raised: the row that opens or closes takes the accent and its arrow
     nudges the way it points, to say the whole card does it. */
  .pilot:global(.is-near) .pilot-more > :global(.disclosure-summary) { color: var(--accent-strong); }
  .pilot:global(.is-near) .pilot-more:not([open]) :global(.disclosure-summary-inner)::after { transform: rotate(45deg) translate(1px, 1px); }
  .pilot:global(.is-near) .pilot-more[open] :global(.disclosure-summary-inner)::after { transform: rotate(-135deg) translate(1px, 1px); }
  @media (hover: hover) {
    .pilot:hover .pilot-more > :global(.disclosure-summary) { color: var(--accent-strong); }
    .pilot:hover .pilot-more:not([open]) :global(.disclosure-summary-inner)::after { transform: rotate(45deg) translate(1px, 1px); }
    .pilot:hover .pilot-more[open] :global(.disclosure-summary-inner)::after { transform: rotate(-135deg) translate(1px, 1px); }
  }
  .pilot-more-body {
    display: grid;
    gap: var(--space-s);
    align-items: start;
    padding-bottom: 0;
  }
  .pilot-more-side {
    display: grid;
    gap: var(--space-s);
  }
</style>
