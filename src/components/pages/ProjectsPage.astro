---
import { italicizeSpecies } from '../../data/content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../PageHeader.astro';
import Icon from '../Icon.astro';
import CardIcon, { type CardIconName } from '../CardIcon.astro';
import DeadlineChip from '../DeadlineChip.astro';
import { PILOT_INTRO } from '../../data/pilot-call';
import MediaCandidateViewer from '../MediaCandidateViewer.astro';
import { getDict, localePath, type Locale } from '../../i18n';
import { PILOTS, getSource, getMediaModule } from '../../data/records';
import { PROJECTS } from '../../data/content';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getDict(locale);

const proj = t.projects as Record<string, unknown>;
const pageTitle =
  (proj.header && typeof (proj.header as Record<string, unknown>).title === 'string'
    ? (proj.header as Record<string, unknown>).title
    : proj.title) as string;
const metaTitle = proj.metaTitle as string;
const metaDescription = proj.metaDescription as string;

const intro = PILOT_INTRO[locale];
const p = t.pilots;
const pp = t.projects.pilotProposal;

const publishedPilots = PILOTS.filter((pilot) => pilot.publish);

const sourcesLabel = locale === 'es' ? 'Fuentes' : 'Sources';

// Map from PILOTS.id to PROJECTS.id for the proposal lookup.
const pilotToProjectId: Record<string, string> = {
  'pilot-heliconius': 'heliconius',
  'pilot-parides':    'parides',
  'pilot-soybean':    'soybean-pests',
  'pilot-panacea':    'panacea',
};

const projectById = new Map(PROJECTS.map((pr) => [pr.id, pr]));

// One icon per reason, in the order of PILOT_INTRO.reasons.
const reasonIcons: readonly CardIconName[] = [
  'capacity', 'workflow', 'training', 'regulation', 'data', 'budget', 'results', 'connect',
];
---

<Base locale={locale} title={metaTitle} description={metaDescription} page="/projects">
  <div id="overview">
    <PageHeader title={pageTitle} intro={intro.opening} />
  </div>

  <section class="section pilot-introduction" aria-labelledby="pilot-purpose">
    <div class="container-wide">
      <div class="pilot-intro-layout">
        <div class="intro-copy content-body">
          {intro.body.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <aside class="funding-callout ink-card ink-card--rose" aria-labelledby="funding-callout-title">
          <h2 id="funding-callout-title" class="funding-callout-title">{intro.call}</h2>
          <DeadlineChip locale={locale} />
          <p class="content-body">{intro.coverage}</p>
          <a class="btn btn--primary" href={localePath(locale, '/funding')}>{intro.funding}<Icon name="arrow-right" /></a>
        </aside>
      </div>
      <h2 id="pilot-purpose" class="content-heading">{intro.why}</h2>
      <ul class="pilot-reasons">
        {intro.reasons.map(([title, body], i) => (
          <li class="content-body">
            <CardIcon name={reasonIcons[i]} />
            <div>
              <strong>{title}</strong>
              <p>{body}</p>
            </div>
          </li>
        ))}
      </ul>
      <p class="intro-copy content-body">{intro.closing}</p>
    </div>
  </section>


  {/*
    container-wide supplies the gutter and the centring. This used to come
    from `section-rail-layout`, which was removed with the sidebar — and
    took the page's left and right margins with it, so the images and
    diagrams sat flush against the viewport edge.
  */}
  <div class="projects-layout container-wide">
    <h2 id="proposed-projects" class="content-heading projects-heading">{intro.projects}</h2>
    <ol class="pilots" aria-label={pageTitle}>
      {
        publishedPilots.map((pilot) => {
          const project = projectById.get(pilotToProjectId[pilot.id]);
          return (
            <li id={pilot.slug} class="pilot ink-card">
            <!-- Media: 5-column slot on desktop -->
            <div class="pilot-media">
              {getMediaModule(pilot.id) && (
                <MediaCandidateViewer moduleId={pilot.id} locale={locale} aspectRatio="4 / 3" captionMode="compact" singleImage />
              )}
            </div>

            <!-- Text: 7-column slot on desktop -->
            <div class="pilot-text">
              <h2 class="pilot-heading content-heading" set:html={italicizeSpecies(pilot.heading[locale])} />

              {pilot.taxon && (
                <p class="pilot-taxon content-meta mono chip chip--rose">
                  <em>{pilot.taxon}</em>
                </p>
              )}

              <!-- One-sentence research question -->
              <p class="pilot-hook content-lead" set:html={italicizeSpecies(pilot.hook[locale])} />

              <!-- What Caligo proposes to test -->
              <div class="pilot-field">
                <p class="pilot-field-label content-label">{p.fieldLabels.proposedQuestion}</p>
                <p class="pilot-field-value content-body" set:html={italicizeSpecies(pilot.proposedQuestion[locale])} />
              </div>

              {project && (
                <div class="pilot-field">
                  <p class="pilot-field-label content-label">{pp.leadsLabel}</p>
                  <p class="pilot-field-value content-body">
                    {project.leads}
                  </p>
                </div>
              )}

            </div>

            <!--
              Published background, starting material and sources share one
              disclosure so each pilot opens on its question and proposal.
              It spans the whole card, below the photograph and the text.
            -->
            <details class="disclosure pilot-more" data-pilot-more>
              <summary class="disclosure-summary">
                <span class="disclosure-summary-inner">{pp.backgroundLabel}</span>
              </summary>
              <div class="disclosure-body pilot-more-body">
                <p class="pilot-body-text content-body" set:html={italicizeSpecies(pilot.publishedContext[locale])} />
                <div class="pilot-more-side">

                {project && (
                  <div class="pilot-field">
                    <p class="pilot-field-label content-label">{pp.resourcesLabel}</p>
                    <p class="pilot-field-value content-body" set:html={italicizeSpecies(project.resources?.[locale] ?? '')} />
                  </div>
                )}

                <p class="pilot-source-line content-meta">
                  <span class="pilot-source-label content-label">{sourcesLabel}: </span>
                  {pilot.sourceIds.map((sid, i) => {
                    const src = getSource(sid);
                    if (!src) return null;
                    return (
                      <>
                        {i > 0 && ' · '}
                        <a target="_blank" href={src.url} rel="external noopener">{src.shortLabel ?? src.citation}</a>
                      </>
                    );
                  })}
                </p>
                </div>
              </div>
            </details>
            </li>
          );
        })
      }
    </ol>
  </div>
</Base>

<script is:inline>
  /* A link to /projects/#<pilot> arrives for the full proposal, so open
     that pilot's background instead of leaving it collapsed. */
  (function () {
    function openTarget() {
      var id = decodeURIComponent(location.hash.slice(1));
      if (!id) return;
      var target = document.getElementById(id);
      var more = target && target.querySelector('[data-pilot-more]');
      if (more) more.open = true;
    }
    if (!window.__caligoPilotHash) {
      window.__caligoPilotHash = true;
      document.addEventListener('astro:page-load', openTarget);
      window.addEventListener('hashchange', openTarget);
    }
    openTarget();
  })();
</script>

<style>
  .intro-copy { max-width: var(--measure); }
  .intro-copy p + p { margin-top: var(--space-s); }
  .pilot-intro-layout {
    display: grid;
    gap: var(--space-l);
    align-items: start;
    margin-bottom: var(--space-xl);
  }
  @media (min-width: 60rem) {
    .pilot-intro-layout { grid-template-columns: minmax(0, 1.25fr) minmax(18rem, 0.75fr); gap: clamp(2rem, 5vw, 5rem); }
  }
  .funding-callout {
    display: grid;
    justify-items: start;
    gap: var(--space-s);
    padding: var(--space-l);
  }
  .funding-callout-title {
    margin: 0;
    font-size: var(--step-1);
    line-height: 1.25;
  }
  .funding-callout .btn { margin-top: var(--space-xs); }
  .pilot-reasons { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-m) var(--space-xl); list-style: none; padding: 0; margin-block: var(--space-m); }
  .pilot-reasons li { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: var(--space-s); align-items: start; border-top: 1px solid var(--hairline); padding-top: var(--space-s); }
  .pilot-reasons strong { color: var(--text-strong); }
  .pilot-reasons p { margin-top: var(--space-xs); }
  .projects-heading { padding-top: var(--space-l); }
  @media (max-width: 48rem) {
    .pilot-reasons { grid-template-columns: 1fr; }
  }

  .pilots {
    list-style: none;
    padding: 0;
    margin: var(--space-m) 0 var(--space-xl);
    display: grid;
    gap: var(--space-l);
    min-width: 0;
  }

  /* Each pilot project is one ink card: its photograph framed as a print,
     its question and leads beside it. */
  .pilot {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-m);
    padding: clamp(1rem, 2.2vw, 1.75rem);
    scroll-margin-top: var(--scroll-margin-top);
  }
  .pilot-media :global(.mcv-stage) {
    border: var(--ink-w) solid var(--ink-line);
    border-radius: 8px;
    overflow: hidden;
  }

  /* Desktop: 5 media / 7 text grid */
  @media (min-width: 68rem) {
    .pilot {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      column-gap: var(--space-xl);
      row-gap: 0;
      align-items: start;
    }
    .pilot-media :global(.mcv-stage) { max-height: 24rem; }

    .pilot-more { grid-column: 1 / -1; margin-top: var(--space-m); }
    .pilot-more-body {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      column-gap: var(--space-xl);
    }
  }

  /* ============================================================
     Media slot
     ============================================================ */
  .pilot-media {
    min-width: 0;
  }
  .pilot-media :global(.mcv-stage) {
    max-height: min(60vh, 26rem);
  }
  .pilot-media :global(img),
  .pilot-media :global(picture) {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  /* ============================================================
     Text slot
     ============================================================ */
  .pilot-text {
    min-width: 0;
    display: grid;
    gap: var(--space-s);
    align-content: start;
  }

  .pilot-heading {
    max-width: 26ch;
  }

  .pilot-taxon {
    width: fit-content;
  }
  .pilot-taxon em {
    font-style: italic;
  }

  .pilot-hook {
    max-width: var(--measure);
  }

  .pilot-body-text {
    max-width: var(--measure);
  }
  .pilot-text :global(.concept-diagram) {
    margin-block: var(--space-xs);
  }

  .pilot-field {
    display: grid;
    gap: 0.25rem;
  }
  .pilot-field-value {
    max-width: var(--measure);
  }
  /* The background is a plain row closing the card, not a box inside it. */
  .pilot-more { --disclosure-pad-x: 0; }
  .pilot-more > :global(.disclosure-summary) { font-weight: 600; }
  .pilot-more:not([open]) > :global(.disclosure-summary) { border-bottom-color: transparent; }
  .pilot-more-body {
    display: grid;
    gap: var(--space-s);
    align-items: start;
    padding-bottom: 0;
  }
  .pilot-more-side {
    display: grid;
    gap: var(--space-s);
  }
</style>
