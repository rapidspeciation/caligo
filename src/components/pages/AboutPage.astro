---
import Base from '../../layouts/Base.astro';
import PageHeader from '../PageHeader.astro';
import PrincipleGrid from '../PrincipleGrid.astro';
import CopyEmail from '../CopyEmail.astro';
import Icon from '../Icon.astro';
import FacilityTable from '../FacilityTable.astro';
import { ABOUT_FEEDBACK, ABOUT_LINKS } from '../../data/about-feedback';
import { facilityStats, pick } from '../../data/initiative';
import { getDict, localePath, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDict(locale);
const page = ABOUT_FEEDBACK;
const facilityTotals = facilityStats();
/* Who builds and maintains the site, and what else he has built. */
const MAKER = {
  heading: { en: 'Who builds this site', es: 'Quién hace este sitio' },
  body: {
    en: 'Franz Chandi designs and maintains this website. He is an Ecuadorian biologist who works on butterfly genomics and builds software for biodiversity research, from web tools to AI models that identify insects in photographs.',
    es: 'Franz Chandi diseña y mantiene este sitio web. Es biólogo ecuatoriano, trabaja en genómica de mariposas y desarrolla software para la investigación en biodiversidad, desde herramientas web hasta modelos de IA que identifican insectos en fotos.',
  },
  offer: { en: 'Need a website or a data tool for your lab or project?', es: '¿Necesitas un sitio web o una herramienta de datos para tu laboratorio o proyecto?' },
  email: 'franz.chandi@gmail.com',
  github: 'https://github.com/Fr4nzz',
  workLabel: { en: 'Tools for Ithomiini research', es: 'Herramientas para la investigación de Ithomiini' },
  work: [
    { name: 'Wings Atlas', href: 'https://rapidspeciation.github.io/ithomiini_maps/', what: { en: 'Interactive map of more than 30,000 Ithomiini butterfly records', es: 'Mapa interactivo de más de 30.000 registros de mariposas Ithomiini' } },
    { name: 'Wings Gallery', href: 'https://rapidspeciation.github.io/Shiny_Ikiam_Wings_Gallery/', what: { en: 'Wing photos of Ikiam specimens, with an AI that identifies species and subspecies', es: 'Fotos de alas de especímenes de Ikiam, con una IA que identifica especie y subespecie' } },
    { name: 'AI Photo Processor', href: 'https://fr4nzz.github.io/rename_photos_AI/', what: { en: 'Renames specimen photos by reading the handwritten code on each envelope', es: 'Renombra fotos de especímenes leyendo el código escrito a mano en cada sobre' } },
    { name: 'Database Manager', href: 'https://ithomiini-ikiam.com/', what: { en: 'Field, monitoring and insectary records, from a phone or a computer', es: 'Datos de campo, monitoreo e insectario, desde el celular o la computadora' } },
  ],
};
const facilityIntro = locale === 'en'
  ? `${facilityTotals.facilities} partner facilities in ${facilityTotals.countries} countries provide access to short-read and long-read sequencing, with local expertise for preparing and analysing genomic data.`
  : `${facilityTotals.facilities} centros asociados en ${facilityTotals.countries} países ofrecen acceso a secuenciación de lecturas cortas y largas, junto con experiencia local para preparar y analizar datos genómicos.`;
---

<Base locale={locale} title={t.about.metaTitle} description={t.about.metaDescription} page="/about">
  <PageHeader title={pick(page.header.title, locale)} intro={pick(page.header.intro, locale)} />

  <section class="section">
    <div class="container-wide about-pair">
      <div class="about-pair-item">
        <h2 id="about-goals" class="section-heading content-heading">{pick(page.goals.heading, locale)}</h2>
        <div class="prose-block">
          {page.goals.body.map((paragraph) => (
            <p class="prose-para content-body">{pick(paragraph, locale)}</p>
          ))}
        </div>
      </div>
      <div class="about-pair-item">
        <h2 id="about-name" class="section-heading content-heading">{pick(page.name.heading, locale)}</h2>
        <div class="prose-block">
          {page.name.body.map((paragraph) => (
            <p class="prose-para content-body">{pick(paragraph, locale)}</p>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section section--panel" aria-labelledby="about-principles">
    <div class="container-wide visual-section">
      <h2 id="about-principles" class="section-heading content-heading">{pick(page.principles.heading, locale)}</h2>
      <PrincipleGrid locale={locale} />
    </div>
  </section>

  <section class="section" aria-labelledby="about-network">
    <div class="container-wide visual-section network-section">
      <div class="network-intro">
        <h2 id="about-network" class="section-heading content-heading">{pick(page.network.heading, locale)}</h2>
        <p id="about-community" class="prose-para content-body community-intro">{pick(page.community.body, locale)}</p>
      </div>

      <p class="prose-para content-body leadership-pointer">
        <a class="text-link" href={`${localePath(locale, '/')}#leadership`}>{pick(page.network.leadershipLink, locale)}<Icon name="arrow-right" /></a>
      </p>

      <div class="network-block" aria-labelledby="about-facilities">
        <h3 id="about-facilities" class="subsection-heading content-heading">{pick(page.network.facilitiesHeading, locale)}</h3>
        <p class="prose-para content-body">{facilityIntro}</p>
        <FacilityTable locale={locale} />
      </div>

      <div class="network-block network-block--prose" aria-labelledby="about-relationships">
        <h3 id="about-relationships" class="subsection-heading content-heading">{pick(page.network.relationshipsHeading, locale)}</h3>
        <p class="prose-para content-body">
          {pick(page.network.relationships.beforeEarth, locale)}
          <a href={ABOUT_LINKS.earthBioGenome.href} target="_blank" rel="noopener noreferrer external">{ABOUT_LINKS.earthBioGenome.label}</a>
          {pick(page.network.relationships.betweenEarthAndGeno, locale)}
          <a href={ABOUT_LINKS.genoTropics.href} target="_blank" rel="noopener noreferrer external">{ABOUT_LINKS.genoTropics.label}</a>
          {pick(page.network.relationships.afterGeno, locale)}
          <a href={ABOUT_LINKS.projectPsyche.href} target="_blank" rel="noopener noreferrer external">{ABOUT_LINKS.projectPsyche.label}</a>
          {pick(page.network.relationships.betweenEuropean, locale)}
          <a href={ABOUT_LINKS.lepEu.href} target="_blank" rel="noopener noreferrer external">{ABOUT_LINKS.lepEu.label}</a>
          {pick(page.network.relationships.end, locale)}
        </p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="about-maker">
    <div class="container-wide maker">
      <div class="maker-copy">
        <h2 id="about-maker" class="section-heading content-heading">{pick(MAKER.heading, locale)}</h2>
        <p class="prose-para content-body">{pick(MAKER.body, locale)}</p>
        <p class="maker-offer content-body">{pick(MAKER.offer, locale)}</p>
        <div class="maker-contact">
          <CopyEmail locale={locale} email={MAKER.email} class="btn--ghost" />
          <a class="btn btn--ghost" href={MAKER.github} target="_blank" rel="noopener noreferrer external">GitHub<Icon name="external" /></a>
        </div>
      </div>
      <div class="maker-tools">
        <h3 id="about-maker-work" class="subsection-heading content-heading">{pick(MAKER.workLabel, locale)}</h3>
        <ul class="maker-work" role="list" aria-labelledby="about-maker-work">
          {MAKER.work.map((w) => (
            <li class="ink-card ink-card--flat" data-card="link">
              <h4 class="maker-work-name"><a class="card-link" href={w.href} target="_blank" rel="noopener noreferrer external">{w.name}<Icon name="external" /></a></h4>
              <p class="maker-work-what">{pick(w.what, locale)}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</Base>

<style>
  .maker-copy { max-width: var(--measure); }
  .maker-offer { margin-top: var(--space-s); font-weight: 560; color: var(--text); }
  .maker-contact { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-s); margin-top: var(--space-s); }
  /* A colophon after the network content: a hairline above, smaller
     headings, flat tool cards (outline kept, no raised shadow) and tighter
     spacing, so the sections about Caligo stay ahead of it. */
  .maker { display: grid; gap: var(--space-l); padding-top: var(--space-l); border-top: 1px solid var(--hairline); }
  .maker .section-heading { font-size: var(--step-1); margin-bottom: var(--space-s); }
  /* Both column headings at one size, so they share a top line and a baseline. */
  .maker .subsection-heading { margin: 0 0 var(--space-s); font-size: var(--step-1); }
  .maker > .maker-tools { margin-top: 0; }
  @media (min-width: 70rem) {
    .maker { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  }
  .maker-work { display: grid; gap: var(--space-s); margin: 0; padding: 0; list-style: none; }
  .maker-work li { display: grid; align-content: start; gap: var(--space-2xs); padding: var(--space-s) var(--space-m); }
  .maker-work-name { margin: 0; font-size: var(--step-0); }
  .maker-work-name a { display: inline-flex; align-items: center; gap: 0.35em; color: var(--text-strong); text-decoration: none; }
  .maker-work-name :global(svg) { flex: none; width: 1em; height: 1em; }
  @media (min-width: 36rem) { .maker-work { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .maker-work-what { text-wrap: pretty; margin: 0; color: var(--text-muted); font-size: var(--step--1); line-height: 1.45; }
  .section-heading {
    margin-bottom: var(--space-m);
  }
  .community-intro,
  .network-block--prose {
    max-width: var(--measure);
  }
  /* Two short essays read side by side on desktop: left column first,
     then right, with a hairline between them. */
  .about-pair {
    display: grid;
    gap: var(--space-xl);
  }
  .about-pair-item { max-width: var(--measure); }
  .about-pair-item [id] { scroll-margin-top: 5rem; }
  @media (min-width: 60rem) {
    .about-pair {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0;
    }
    .about-pair-item:first-child { padding-right: clamp(2rem, 4vw, 4rem); }
    .about-pair-item + .about-pair-item {
      /* Side by side, so the stacking gap between siblings must not apply. */
      margin-top: 0;
      padding-left: clamp(2rem, 4vw, 4rem);
      border-left: 1px solid var(--hairline);
    }
  }
  .prose-block {
    display: grid;
    gap: var(--space-s);
  }
  .prose-para {
    margin: 0;
  }
  .network-section {
    display: grid;
    gap: var(--space-l);
  }
  .network-intro { display: grid; gap: var(--space-m); }
  .network-intro .section-heading { margin-bottom: 0; }
  .network-block {
    display: grid;
    gap: var(--space-m);
  }
  .subsection-heading {
    margin: 0;
    font-size: var(--step-1);
  }
  .network-block a {
    color: var(--accent-strong);
    text-underline-offset: 0.16em;
  }
</style>
