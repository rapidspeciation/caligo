---
import { PRINCIPLES, pick } from '../data/initiative';
import type { Locale } from '../i18n';

interface Props {
  readonly locale: Locale;
}

const { locale } = Astro.props;
---

<ul class="rule-list rule-list--numbered principle-grid" role="list">
  {PRINCIPLES.map((principle, index) => (
    <li class="principle-item">
      <span class="rule-index mono" aria-hidden="true">
        {String(index + 1).padStart(2, '0')}
      </span>
      <div class="principle-content">
        <h3 class="principle-title">{pick(principle.title, locale)}</h3>
        <p class="principle-body">{pick(principle.body, locale)}</p>
      </div>
    </li>
  ))}
</ul>

<style>
  /* Structure, numbers and titles come from `.rule-list--numbered`
     (global.css). */
  .principle-body {
    margin: var(--space-xs) 0 0;
    font-size: var(--step-0);
    line-height: 1.55;
  }
</style>
