---
import { PRINCIPLES, pick } from '../data/initiative';
import type { Locale } from '../i18n';

interface Props {
  readonly locale: Locale;
}

const { locale } = Astro.props;
---

<ul class="rule-list principle-grid" role="list">
  {PRINCIPLES.map((principle, index) => (
    <li class="principle-item">
      <span class="principle-index mono" aria-hidden="true">
        {String(index + 1).padStart(2, '0')}
      </span>
      <div class="principle-content">
        <h3 class="principle-title">{pick(principle.title, locale)}</h3>
        <p class="principle-body">{pick(principle.body, locale)}</p>
      </div>
    </li>
  ))}
</ul>

<style>
  /* Structure and titles come from `.rule-list` (global.css). */
  .principle-item {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: var(--space-s);
    align-content: start;
  }
  .principle-index {
    padding-top: 0.12em;
    color: var(--accent-strong);
    font-size: var(--step--1);
    letter-spacing: 0.08em;
  }
  .principle-body {
    margin: var(--space-xs) 0 0;
    font-size: var(--step--1);
    color: var(--text-muted);
    line-height: 1.55;
  }
</style>
