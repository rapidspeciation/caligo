---
/**
 * Static companion to the Caligo voucher principle on Home: a pinned,
 * labelled specimen and its genome carry the same identifier. Same glyphs,
 * strokes and accent as TierDiagram. Decorative alt text lives in i18n.
 */
import { getDict, type Locale } from '../i18n';
import { BUTTERFLY } from '../data/diagram-glyphs';

interface Props {
  readonly locale: Locale;
}
const { locale } = Astro.props;
const desc = getDict(locale).home.tiers.diagrams.voucher.desc;
const ID = 'ID 0427';
const chromosomes = [
  { x: 228, h: 42 }, { x: 246, h: 38 }, { x: 264, h: 34 }, { x: 282, h: 30 },
];
---

<svg class="voucher-link" viewBox="0 0 308 92" role="img" aria-label={desc}>
  <path d="M50 4 V66" class="vl-pin" />
  <circle cx="50" cy="4" r="3" class="vl-pin-head" />
  <g transform="translate(50 30) scale(1.35)" class="vl-fly">
    <path d={BUTTERFLY.forewing} />
    <path d={BUTTERFLY.forewing} transform="scale(-1 1)" />
    <path d={BUTTERFLY.hindwing} />
    <path d={BUTTERFLY.hindwing} transform="scale(-1 1)" />
    <path d={BUTTERFLY.band} class="vl-band" />
    <path d={BUTTERFLY.band} class="vl-band" transform="scale(-1 1)" />
    <path d={BUTTERFLY.body} class="vl-body" />
    <path d={BUTTERFLY.antennae} class="vl-antennae" />
  </g>
  <rect x="18" y="56" width="64" height="24" rx="2" class="vl-tag" />
  <text x="50" y="72" class="vl-id">{ID}</text>

  <path d="M86 68 H218" class="vl-link" />
  <circle cx="86" cy="68" r="2.5" class="vl-dot" />
  <circle cx="218" cy="68" r="2.5" class="vl-dot" />

  {chromosomes.map((c) => (
    <rect x={c.x} y={28 - c.h / 2} width="12" height={c.h} rx="6" class="vl-chr" />
  ))}
  <rect x="222" y="56" width="78" height="24" rx="2" class="vl-tag" />
  <text x="261" y="72" class="vl-id">{ID}</text>
</svg>

<style>
  .voucher-link { display: block; width: 100%; height: auto; overflow: visible; }
  .vl-pin { stroke: var(--text-faint); stroke-width: 1.5; }
  .vl-pin-head { fill: var(--text-faint); }
  .vl-fly path { fill: var(--text-muted); }
  .vl-fly .vl-band { fill: var(--highlight); }
  .vl-fly .vl-body { fill: none; stroke: var(--text-strong); stroke-width: 2.4; stroke-linecap: round; }
  .vl-fly .vl-antennae { fill: none; stroke: var(--text-muted); stroke-width: 1; stroke-linecap: round; }
  .vl-tag { fill: var(--bg); stroke: var(--text-faint); stroke-width: 1.5; }
  .vl-id { font-family: var(--font-mono); font-size: 11.5px; font-weight: 600; fill: var(--text-strong); text-anchor: middle; }
  .vl-link { fill: none; stroke: var(--accent); stroke-width: 2; stroke-dasharray: 3 5; stroke-linecap: round; }
  .vl-dot { fill: var(--accent); }
  .vl-chr { fill: var(--accent); }
</style>
